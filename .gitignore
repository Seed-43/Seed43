# Markdown notes - only the root README.md is tracked
*.md
!/README.md

# Zip backups
*.zip

# Log files
*.log

# Local settings
settings.json

# Python cache
__pycache__/
*.pyc
*.pyo

# Local palette editor (not shipped with the extension)
lib/*.html

# Website guides and site CSS - working copies, published to seed43.org
# rather than shipped with the extension
lib/guides/

# Per-tool user settings - never shipped, never updated (see _userdata.py)
.user/

# Exclude temp and BreakTime
Seed43.tab/temp/
Seed43.tab/Seed43.panel/BreakTime.pushbutton/
sync-start.bat
sync-end.bat

# Dim tools: in development, kept locally but never on the branch
Seed43.tab/2D Tools.panel/Annotation.pulldown/Dim Override.pushbutton.off/
Seed43.tab/2D Tools.panel/Annotation.pulldown/Dim Restore.pushbutton.off/
