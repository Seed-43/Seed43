<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="620"
        Title="Dim Override"
        Background="{DynamicResource BrushWindowBg}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Fallback values only. seed43_theme.apply_seed43_palette() and
             apply_seed43_dimensions() inject the live ones after the XAML
             has parsed, which is what makes DynamicResource the only usable
             binding here. These match the dark profile so an unreadable
             palette file still looks right rather than half-themed. -->
        <SolidColorBrush x:Key="BrushWindowBg"           Color="#3B4553"/>
        <SolidColorBrush x:Key="BrushCardBg"             Color="#2B3340"/>
        <SolidColorBrush x:Key="BrushHeaderBg"           Color="#232933"/>
        <SolidColorBrush x:Key="BrushPrimaryGreen"       Color="#208A3C"/>
        <SolidColorBrush x:Key="BrushPrimaryGreenHover"  Color="#32934C"/>
        <SolidColorBrush x:Key="BrushTextPrimary"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushTextMuted"          Color="#9CA3AF"/>
        <SolidColorBrush x:Key="BrushTextInput"          Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushInputBg"            Color="#1D1D20"/>
        <SolidColorBrush x:Key="BrushBorderDefault"      Color="#208A3C"/>
        <SolidColorBrush x:Key="BrushBorderHover"        Color="#32934C"/>
        <SolidColorBrush x:Key="BrushSecondaryBg"        Color="#48484B"/>
        <SolidColorBrush x:Key="BrushSecondaryHover"     Color="#515155"/>
        <SolidColorBrush x:Key="BrushDropdownItemHover"  Color="#3F3F41"/>
        <SolidColorBrush x:Key="BrushSelectedRowBg"      Color="#08230F"/>
        <SolidColorBrush x:Key="BrushDanger"             Color="#E01B24"/>

        <CornerRadius x:Key="CornerRadiusCard"           >8</CornerRadius>
        <CornerRadius x:Key="CornerRadiusInput"          >6</CornerRadius>
        <CornerRadius x:Key="CornerRadiusButton"         >10</CornerRadius>
        <Thickness    x:Key="PaddingCard"                >16</Thickness>
        <Thickness    x:Key="PaddingButtonPrimary"       >15,7,15,7</Thickness>
        <sys:Double   x:Key="HeightInput"                >28</sys:Double>
        <sys:Double   x:Key="FontSizeInput"              >12</sys:Double>
        <sys:Double   x:Key="FontSizeFieldLabel"         >12</sys:Double>
        <sys:Double   x:Key="FontSizeSectionLabel"       >14</sys:Double>
        <sys:Double   x:Key="FontSizeButton"             >12</sys:Double>

        <!-- ── TEXT ──────────────────────────────────────────────────── -->
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeSectionLabel}"/>
            <Setter Property="Margin"     Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground"         Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize"           Value="{DynamicResource FontSizeFieldLabel}"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
            <Setter Property="Margin"             Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ── INPUTS ────────────────────────────────────────────────── -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextInput}"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource BrushTextInput}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeInput}"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="Height"          Value="{DynamicResource HeightInput}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusInput}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource BrushBorderHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The value field sits on top of a ghost TextBlock that shows the
             predicted remainder, so it draws no chrome of its own - the
             Border around the pair carries the background and the outline.
             Padding here must stay equal to the ghost's Margin or the typed
             text and the prediction will not line up. -->
        <Style x:Key="GhostField" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── LIST ──────────────────────────────────────────────────── -->
        <Style x:Key="ListRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeInput}"/>
            <Setter Property="Padding"    Value="8,5"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushDropdownItemHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushPrimaryGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Catalogue" TargetType="ListBox">
            <Setter Property="Background"      Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="4"/>
            <Setter Property="MaxHeight"       Value="170"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ListRow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusInput}">
                            <ScrollViewer Padding="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── BUTTONS ───────────────────────────────────────────────── -->
        <Style x:Key="GreenBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeButton}"/>
            <Setter Property="Padding"         Value="{DynamicResource PaddingButtonPrimary}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButton}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreyBtn" TargetType="Button" BasedOn="{StaticResource GreenBtn}">
            <Setter Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButton}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushSecondaryHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCtrlCloseBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="30"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushDanger}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ── HEADER ────────────────────────────────────────────────── -->
        <Border Background="{DynamicResource BrushHeaderBg}"
                Height="64"
                DockPanel.Dock="Top"
                CornerRadius="0,0,12,12">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3"
                                  ShadowDepth="2" BlurRadius="6"/>
            </Border.Effect>
            <Grid Margin="20,0,16,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <TextBlock Text="Dim" FontWeight="Bold" FontSize="26"
                               Foreground="{DynamicResource BrushPrimaryGreen}"/>
                    <TextBlock Text="Override" FontWeight="Bold" FontSize="26"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock x:Name="count_tb" FontSize="16"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               Opacity="0.6"
                               VerticalAlignment="Bottom" Margin="10,0,0,4"/>
                </StackPanel>
                <Button x:Name="win_close_btn"
                        Content="&#10005;"
                        Style="{StaticResource WinCtrlCloseBtn}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTip="Close"
                        Click="cancel_clicked"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <StackPanel Margin="20,16,20,20">

            <!-- ── TEXT FIELDS ───────────────────────────────────────── -->
            <Border Background="{DynamicResource BrushCardBg}"
                    CornerRadius="{DynamicResource CornerRadiusCard}"
                    Padding="{DynamicResource PaddingCard}">
                <StackPanel>
                    <TextBlock Text="Text Fields" Style="{StaticResource Section}"/>

                    <!-- Above -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Above:"
                                   Style="{StaticResource Label}"
                                   HorizontalAlignment="Right"/>
                        <TextBox Grid.Column="1" x:Name="above_tb"
                                 Style="{StaticResource Field}"/>
                    </Grid>

                    <!-- Prefix / Value / Suffix -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Prefix:"
                                   Style="{StaticResource Label}"/>
                        <TextBox Grid.Column="1" x:Name="prefix_tb"
                                 Style="{StaticResource Field}"/>

                        <TextBlock Grid.Column="3" Text="Value:"
                                   Style="{StaticResource Label}"/>
                        <!-- Ghost sits behind the real box; both share font,
                             size and inset so the grey remainder continues
                             the typed text exactly. -->
                        <Border Grid.Column="4"
                                Background="{DynamicResource BrushInputBg}"
                                BorderBrush="{DynamicResource BrushPrimaryGreen}"
                                BorderThickness="1.5"
                                CornerRadius="{DynamicResource CornerRadiusInput}"
                                Height="{DynamicResource HeightInput}">
                            <Grid>
                                <TextBlock x:Name="value_ghost"
                                           Margin="8,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="{DynamicResource FontSizeInput}"
                                           IsHitTestVisible="False"/>
                                <TextBox x:Name="value_tb"
                                         Style="{StaticResource GhostField}"
                                         TextChanged="value_changed"
                                         PreviewKeyDown="value_keydown"/>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Column="6" Text="Suffix:"
                                   Style="{StaticResource Label}"/>
                        <TextBox Grid.Column="7" x:Name="suffix_tb"
                                 Style="{StaticResource Field}"/>
                    </Grid>

                    <!-- Below -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Below:"
                                   Style="{StaticResource Label}"
                                   HorizontalAlignment="Right"/>
                        <TextBox Grid.Column="1" x:Name="below_tb"
                                 Style="{StaticResource Field}"/>
                    </Grid>

                    <TextBlock x:Name="actual_tb" Style="{StaticResource Hint}"
                               Margin="0,10,0,0"/>

                    <!-- Collapsed unless the selection holds a dimension
                         string. Ticked, it widens the write from the picked
                         segments to every segment of each string. -->
                    <CheckBox x:Name="whole_cb"
                              Margin="0,8,0,0"
                              Visibility="Collapsed"
                              Foreground="{DynamicResource BrushTextPrimary}"
                              FontSize="{DynamicResource FontSizeFieldLabel}"
                              Cursor="Hand"
                              ToolTip="Off, the override lands only on the segments you clicked"/>
                </StackPanel>
            </Border>

            <!-- ── CATALOGUE ─────────────────────────────────────────── -->
            <Border Background="{DynamicResource BrushCardBg}"
                    CornerRadius="{DynamicResource CornerRadiusCard}"
                    Padding="{DynamicResource PaddingCard}"
                    Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock x:Name="list_hint_tb"
                                   DockPanel.Dock="Right"
                                   Style="{StaticResource Hint}"
                                   VerticalAlignment="Center"
                                   Text="Tab accepts the prediction"/>
                        <TextBlock Text="Previously Used"
                                   Style="{StaticResource Section}"
                                   Margin="0"/>
                    </DockPanel>
                    <ListBox x:Name="catalogue_lb"
                             Style="{StaticResource Catalogue}"
                             SelectionChanged="catalogue_selected"/>
                </StackPanel>
            </Border>

            <!-- ── ACTIONS ───────────────────────────────────────────── -->
            <Grid Margin="0,16,0,0">
                <Button x:Name="clear_btn" Content="Clear Override"
                        Style="{StaticResource GreyBtn}"
                        HorizontalAlignment="Left" Width="130"
                        ToolTip="Blank every field and hand the dimensions back their measured value"
                        Click="clear_clicked"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="cancel_btn" Content="Cancel" Width="90"
                            Style="{StaticResource GreyBtn}" Margin="0,0,8,0"
                            Click="cancel_clicked"/>
                    <Button x:Name="apply_btn" Content="Apply" Width="90"
                            Style="{StaticResource GreenBtn}"
                            Click="apply_clicked"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>
