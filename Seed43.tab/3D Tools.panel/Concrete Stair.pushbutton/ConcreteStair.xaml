<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Concrete Stair"
        Width="780"
        SizeToContent="Height"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushWindowBg}"
        TextElement.FontFamily="Segoe UI">

    <!-- Styles come from lib/Snippets/Seed43Styles.xaml, merged in by
         script.py after this file loads, so every Style here is a
         DynamicResource. -->

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                             CornerRadius="10"
                             GlassFrameThickness="0"
                             ResizeBorderThickness="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <!-- Badge: the marker that ties a drawing's dimension to its input -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Tab button, copied from pySheets so the two look the same -->
        <Style x:Key="MainTab" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Normal"/>
            <Setter Property="Opacity"         Value="0.7"/>
            <Setter Property="Padding"         Value="24,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreen}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Done">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value=""/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Opacity" Value="0.75"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{DynamicResource BrushHeaderBg}" CornerRadius="10,10,12,12">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="header_icon"
                           Width="{DynamicResource SizeTopBarLogo}"
                           Height="{DynamicResource SizeTopBarLogo}"
                           Margin="0,0,10,0"/>
                    <TextBlock Text="Concrete " Foreground="{DynamicResource BrushPrimaryGreen}"
                               FontWeight="Bold" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text="Stair" Foreground="{DynamicResource BrushTextPrimary}"
                               FontWeight="Bold" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock x:Name="header_subtitle_tb" Text="| Stair" Width="110"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               FontSize="18" FontWeight="SemiBold" Opacity="0.55"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="&#x2715;" HorizontalAlignment="Right"
                        Style="{DynamicResource CloseButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="close_clicked"/>
            </Grid>
        </Border>

        <!-- TAB BAR, as pySheets -->
        <Border Grid.Row="1"
                Background="{DynamicResource BrushWindowBg}"
                BorderBrush="{DynamicResource BrushPrimaryGreen}"
                BorderThickness="0,0,0,2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,10,0,0">
                <Button x:Name="tab_stair_btn" Content="Stair" Tag="Active"
                        Style="{StaticResource MainTab}" Click="tab_stair_clicked"/>
                <Button x:Name="tab_rebar_btn" Content="Rebar" Tag=""
                        Style="{StaticResource MainTab}" Click="tab_rebar_clicked"/>
            </StackPanel>
        </Border>

        <!-- PAGE: REBAR -->
        <StackPanel x:Name="page_rebar" Grid.Row="2" Margin="16,14,16,0" Visibility="Collapsed">
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <CheckBox x:Name="rebar_cb" VerticalAlignment="Center"
                                  Content="Add reinforcing when the stair is placed"
                                  FontWeight="SemiBold" Style="{DynamicResource CheckBoxStyle}"
                                  Click="inputs_changed"/>
                        <Button Content="Add to a selected stair..." HorizontalAlignment="Right"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                ToolTip="Click an existing straight concrete stair and reinforce it with these settings"
                                Click="rebar_existing_clicked"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Layout" Style="{StaticResource Lbl}"/>
                        <ComboBox x:Name="rebar_layout_cb" Width="320" SelectionChanged="inputs_changed"
                                  ToolTip="How the bars are arranged. More layouts can be added to the tool as they are needed."
                                  Style="{DynamicResource ComboBoxStyle}"/>
                    </StackPanel>
                    <Canvas x:Name="rebar_drawing" Width="720" Height="300" Margin="0,10,0,0"
                            HorizontalAlignment="Center"/>
                    <TextBlock x:Name="rebar_note_tb" Opacity="0.7" TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                </StackPanel>
            </Border>

            <Grid x:Name="rebar_body">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- MAIN BARS -->
                    <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource Badge}"><TextBlock Text="6" Style="{StaticResource BadgeText}"/></Border>
                                <TextBlock Text="Main bars, down the soffit" Style="{DynamicResource SectionLabelStyle}" Margin="0"/>
                            </StackPanel>
                            <TextBlock Text="Bar" Style="{DynamicResource FieldLabelStyle}"/>
                            <ComboBox x:Name="main_bar_cb" SelectionChanged="inputs_changed" Margin="0,0,0,8" Style="{DynamicResource ComboBoxStyle}"/>
                            <TextBlock Text="Spacing (mm)" Style="{DynamicResource FieldLabelStyle}"/>
                            <TextBox x:Name="main_spacing_tb" TextChanged="inputs_changed" Text="450" Width="100" HorizontalAlignment="Left"
                                     Margin="0,0,0,8" Style="{DynamicResource TextBoxStyle}"/>
                            <TextBlock Text="Hook into the footing" Style="{DynamicResource FieldLabelStyle}"/>
                            <ComboBox x:Name="main_hook_cb" SelectionChanged="inputs_changed" Margin="0,0,0,8" Style="{DynamicResource ComboBoxStyle}"/>
                            <TextBlock Text="Leg into the landing slab (mm)" Style="{DynamicResource FieldLabelStyle}"/>
                            <TextBox x:Name="lap_tb" TextChanged="inputs_changed" Text="300" Width="100" HorizontalAlignment="Left"
                                     ToolTip="Past the bend at the top, into the landing: the lap with the slab bars"
                                     Style="{DynamicResource TextBoxStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- BARS ACROSS -->
                    <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource Badge}"><TextBlock Text="7" Style="{StaticResource BadgeText}"/></Border>
                                <CheckBox x:Name="dist_cb" Click="inputs_changed" Content="Bars across, up the slope" IsChecked="True"
                                          Style="{DynamicResource CheckBoxStyle}"/>
                            </StackPanel>
                            <TextBlock Text="Bar" Style="{DynamicResource FieldLabelStyle}"/>
                            <ComboBox x:Name="dist_bar_cb" SelectionChanged="inputs_changed" Margin="0,0,0,8" Style="{DynamicResource ComboBoxStyle}"/>
                            <TextBlock Text="Spacing along the slope (mm)" Style="{DynamicResource FieldLabelStyle}"/>
                            <TextBox x:Name="dist_spacing_tb" TextChanged="inputs_changed" Text="300" Width="100" HorizontalAlignment="Left"
                                     Style="{DynamicResource TextBoxStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!-- COVERS -->
                    <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Cover (mm)" Style="{DynamicResource SectionLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Style="{StaticResource Badge}" HorizontalAlignment="Left"><TextBlock Text="1" Style="{StaticResource BadgeText}"/></Border>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Footing ends" Style="{StaticResource Lbl}"/>
                                <TextBox x:Name="cover_end_tb" TextChanged="inputs_changed" Grid.Row="0" Grid.Column="2" Width="80" Text="50"
                                         ToolTip="From the footing's outer face to the hooked leg"
                                         Style="{DynamicResource TextBoxStyle}"/>
                                <Border Grid.Row="2" Style="{StaticResource Badge}" HorizontalAlignment="Left"><TextBlock Text="2" Style="{StaticResource BadgeText}"/></Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Footing bottom" Style="{StaticResource Lbl}"/>
                                <TextBox x:Name="cover_bottom_tb" TextChanged="inputs_changed" Grid.Row="2" Grid.Column="2" Width="80" Text="50"
                                         ToolTip="From the footing's underside to the bottom of the hook"
                                         Style="{DynamicResource TextBoxStyle}"/>
                                <Border Grid.Row="4" Style="{StaticResource Badge}" HorizontalAlignment="Left"><TextBlock Text="3" Style="{StaticResource BadgeText}"/></Border>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Soffit below the bars (minimum)" Style="{StaticResource Lbl}"/>
                                <TextBox x:Name="cover_soffit_tb" TextChanged="inputs_changed" Grid.Row="4" Grid.Column="2" Width="80" Text="70"
                                         ToolTip="Square to the slope, from the soffit to the underside of the main bars. If the slope (SD) is too thin for this, it is raised to the next 5 mm."
                                         Style="{DynamicResource TextBoxStyle}"/>
                                <Border Grid.Row="6" Style="{StaticResource Badge}" HorizontalAlignment="Left"><TextBlock Text="4" Style="{StaticResource BadgeText}"/></Border>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="Bars below the step corners" Style="{StaticResource Lbl}"/>
                                <TextBox x:Name="corner_clear_tb" TextChanged="inputs_changed" Grid.Row="6" Grid.Column="2" Width="80" Text="50"
                                         ToolTip="Square to the slope, from the inside corners of the steps to the top of the bars across"
                                         Style="{DynamicResource TextBoxStyle}"/>
                                <Border Grid.Row="8" Style="{StaticResource Badge}" HorizontalAlignment="Left"><TextBlock Text="5" Style="{StaticResource BadgeText}"/></Border>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="Top (landing)" Style="{StaticResource Lbl}"/>
                                <TextBox x:Name="cover_top_tb" TextChanged="inputs_changed" Grid.Row="8" Grid.Column="2" Width="80" Text="35"
                                         ToolTip="From the top of the landing to the top of the mesh"
                                         Style="{DynamicResource TextBoxStyle}"/>
                                <TextBlock Grid.Row="10" Grid.Column="1" Text="Sides (across the width)" Style="{StaticResource Lbl}"/>
                                <TextBox x:Name="cover_side_tb" TextChanged="inputs_changed" Grid.Row="10" Grid.Column="2" Width="80" Text="40"
                                         ToolTip="From the stair's sides to the ends of the bars"
                                         Style="{DynamicResource TextBoxStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- MESH -->
                    <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource Badge}"><TextBlock Text="8" Style="{StaticResource BadgeText}"/></Border>
                                <CheckBox x:Name="mesh_cb" Click="inputs_changed" Content="Mesh in the top landing, both ways"
                                          Style="{DynamicResource CheckBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="mesh_bar_cb" SelectionChanged="inputs_changed" Width="120" Style="{DynamicResource ComboBoxStyle}"/>
                                <TextBlock Text="  @" Style="{StaticResource Lbl}"/>
                                <TextBox x:Name="mesh_spacing_tb" TextChanged="inputs_changed" Text="200" Width="70"
                                         Style="{DynamicResource TextBoxStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- PAGE: STAIR -->
        <StackPanel x:Name="page_stair" Grid.Row="2" Margin="16,14,16,0">

            <!-- WORKING LEVEL: one end is set, the other is steps x riser away -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Working level" Style="{DynamicResource SectionLabelStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="work_top_rb" GroupName="work" Content="Top landing"
                                     IsChecked="True" Margin="0,0,20,0" VerticalAlignment="Center"
                                     Style="{DynamicResource RadioButtonStyle}"
                                     Click="working_changed"/>
                        <RadioButton x:Name="work_base_rb" GroupName="work" Content="Base (first step)"
                                     VerticalAlignment="Center"
                                     Style="{DynamicResource RadioButtonStyle}"
                                     Click="working_changed"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Level" Style="{StaticResource Lbl}"/>
                        <ComboBox x:Name="level_cb" Grid.Column="1"
                                  Style="{DynamicResource ComboBoxStyle}"
                                  SelectionChanged="inputs_changed"/>
                        <Button Grid.Column="2" Content="Pick surface or plane" Margin="8,0,0,0"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                ToolTip="Click a floor, slab, ground or reference plane; its height becomes the working RL"
                                Click="pick_level_clicked"/>
                    </Grid>
                    <TextBlock x:Name="other_end_tb" Margin="0,8,0,0" Opacity="0.7"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                </StackPanel>
            </Border>

            <!-- SECTION: the stair drawing, sizes typed where they are dimensioned -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Section (mm)" Style="{DynamicResource SectionLabelStyle}"/>
                    <!-- step counter -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Steps" Style="{StaticResource Lbl}"/>
                        <Button Content="&#x2212;" Width="30" Margin="0,0,4,0"
                                Style="{DynamicResource SecondaryButtonStyle}" Padding="0"
                                ToolTip="One step fewer" Click="steps_down_clicked"/>
                        <TextBox x:Name="steps_tb" Width="50" Text="4" HorizontalContentAlignment="Center"
                                 Style="{DynamicResource TextBoxStyle}" TextChanged="inputs_changed"
                                 ToolTip="Number of steps (risers), counting the step up onto the landing"/>
                        <Button Content="+" Width="30" Margin="4,0,12,0"
                                Style="{DynamicResource SecondaryButtonStyle}" Padding="0"
                                ToolTip="One step more" Click="steps_up_clicked"/>
                        <TextBlock x:Name="rise_tb" VerticalAlignment="Center" Opacity="0.7" Foreground="{DynamicResource BrushTextPrimary}"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- the inputs, as a list; the drawing only shows them -->
                        <StackPanel Grid.Column="0" Margin="0,8,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource Badge}"><TextBlock Text="LD" Style="{StaticResource BadgeText}"/></Border>
                                <TextBlock Text="Slab" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox x:Name="landing_tb" Width="100" HorizontalAlignment="Left" Text="100"
                                     Margin="0,0,0,10"
                                     ToolTip="Top landing slab thickness: the stair's soffit meets its underside"
                                     Style="{DynamicResource TextBoxStyle}" TextChanged="inputs_changed"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource Badge}"><TextBlock Text="SR" Style="{StaticResource BadgeText}"/></Border>
                                <TextBlock Text="Riser" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox x:Name="riser_tb" Width="100" Text="180"
                                         ToolTip="Every riser is this height; steps x riser sets the other end"
                                         Style="{DynamicResource TextBoxStyle}" TextChanged="inputs_changed"/>
                                <Button Content="&#x2316;" FontSize="18" Margin="4,0,0,0"
                                        Style="{DynamicResource SmallIconButtonStyle}"
                                        ToolTip="Pick 2 points: the height between them becomes the riser"
                                        Click="pick_riser_clicked"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource Badge}"><TextBlock Text="SG" Style="{StaticResource BadgeText}"/></Border>
                                <TextBlock Text="Going" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox x:Name="going_tb" Width="100" Text="300"
                                         ToolTip="Tread depth"
                                         Style="{DynamicResource TextBoxStyle}" TextChanged="inputs_changed"/>
                                <Button Content="&#x2316;" FontSize="18" Margin="4,0,0,0"
                                        Style="{DynamicResource SmallIconButtonStyle}"
                                        ToolTip="Pick 2 points: the distance between them in plan becomes the going"
                                        Click="pick_going_clicked"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource Badge}"><TextBlock Text="SD" Style="{StaticResource BadgeText}"/></Border>
                                <TextBlock Text="Slope" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox x:Name="waist_tb" Width="100" HorizontalAlignment="Left" Text="100"
                                     Margin="0,0,0,10"
                                     ToolTip="Slab thickness square to the soffit, from the inside corners of the steps"
                                     Style="{DynamicResource TextBoxStyle}" TextChanged="inputs_changed"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource Badge}"><TextBlock Text="TL" Style="{StaticResource BadgeText}"/></Border>
                                <TextBlock Text="Top landing" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox x:Name="top_landing_tb" Width="100" Text=""
                                         ToolTip="Top landing length, from the top riser to the far end of the slab. Leave it empty for the least (to meet the landing underside); it is never shorter than that."
                                         Style="{DynamicResource TextBoxStyle}" TextChanged="inputs_changed"/>
                                <Button Content="&#x2316;" FontSize="18" Margin="4,0,0,0"
                                        Style="{DynamicResource SmallIconButtonStyle}"
                                        ToolTip="Click the far edge of the top slab. Updating a stair: click it now. A new stair: TL shows 'pick' and you click it after P1 and P2."
                                        Click="pick_top_landing_clicked"/>
                            </StackPanel>

                            <TextBlock x:Name="rl_lbl" Text="RL top" Style="{DynamicResource FieldLabelStyle}"/>
                            <TextBox x:Name="rl_tb" Width="100" HorizontalAlignment="Left" Text="0"
                                     Margin="0,0,0,10"
                                     ToolTip="RL of the working end, as an offset from the working level"
                                     Style="{DynamicResource TextBoxStyle}" TextChanged="inputs_changed"/>

                            <TextBlock Text="Stair width" Style="{DynamicResource FieldLabelStyle}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="width_tb" Width="100" Text="1200"
                                         ToolTip="Stair width, in plan"
                                         Style="{DynamicResource TextBoxStyle}" TextChanged="inputs_changed"/>
                                <Button Content="&#x2316;" FontSize="18" Margin="4,0,0,0"
                                        Style="{DynamicResource SmallIconButtonStyle}"
                                        ToolTip="Pick 2 points: the distance between them in plan becomes the width"
                                        Click="pick_width_clicked"/>
                            </StackPanel>

                            <CheckBox x:Name="footing_cb" Click="inputs_changed" IsChecked="True" Margin="0,14,0,8"
                                      Content="Footing" FontWeight="SemiBold"
                                      ToolTip="A Stair Footing under the first step, placed with the stair: outer face on the first riser, top at the base RL, across the full width. Its type is named by its size, e.g. 250x250. Bars, if added, hook into it."
                                      Style="{DynamicResource CheckBoxStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource Badge}"><TextBlock Text="FW" Style="{StaticResource BadgeText}"/></Border>
                                <TextBlock Text="Footing width" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox x:Name="footing_w_tb" Width="100" HorizontalAlignment="Left" Text="250"
                                     Margin="0,0,0,10" TextChanged="inputs_changed"
                                     ToolTip="Along the stair, from the face of the first riser"
                                     Style="{DynamicResource TextBoxStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource Badge}"><TextBlock Text="FD" Style="{StaticResource BadgeText}"/></Border>
                                <TextBlock Text="Footing depth" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox x:Name="footing_d_tb" Width="100" HorizontalAlignment="Left" Text="250"
                                     TextChanged="inputs_changed"
                                     ToolTip="Below the base RL"
                                     Style="{DynamicResource TextBoxStyle}"/>
                        </StackPanel>

                        <!-- the section, redrawn to scale; dimensions are labels -->
                        <Canvas x:Name="drawing" Grid.Column="1" Width="520" Height="420"
                                HorizontalAlignment="Center"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- RESULT -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Stair" Style="{DynamicResource SectionLabelStyle}"/>
                    <TextBlock x:Name="result_tb" TextWrapping="Wrap" LineHeight="20"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock x:Name="type_tb" Margin="0,6,0,0" Opacity="0.7"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                </StackPanel>
            </Border>

            <!-- OPTIONS -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Options" Style="{DynamicResource SectionLabelStyle}"/>
                    <CheckBox x:Name="railings_cb" Content="Keep the railings Revit adds"
                              Style="{DynamicResource CheckBoxStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox x:Name="slab_cb" VerticalAlignment="Center"
                                  Content="Then make the landing slab from picked lines, type"
                                  Style="{DynamicResource CheckBoxStyle}"/>
                        <ComboBox x:Name="floor_type_cb" Width="200" Margin="8,0,0,0"
                                  Style="{DynamicResource ComboBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Material for the stair, footing and fill" Style="{StaticResource Lbl}"/>
                        <ComboBox x:Name="material_cb" Width="280"
                                  ToolTip="Set on the stair's run and landing types, the footing type and the fill type. These types are shared by every stair, footing and fill of the same size, so they change too."
                                  Style="{DynamicResource ComboBoxStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- FOOTER -->
        <Grid Grid.Row="3" Margin="16,0,16,16">
            <TextBlock x:Name="status_tb" VerticalAlignment="Center" TextWrapping="Wrap"
                       Margin="0,0,380,0" Foreground="{DynamicResource BrushDanger}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="update_pick_btn" Content="Update a stair..." Margin="0,0,8,0"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        ToolTip="Click a stair in the model: its sizes fill this dialogue, then Update stair rebuilds it in the same place"
                        Click="update_pick_clicked"/>
                <Button Content="Cancel" Margin="0,0,8,0"
                        Style="{DynamicResource SecondaryButtonStyle}" Click="close_clicked"/>
                <Button x:Name="place_btn" Content="Place stair"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        ToolTip="Click P1 at the foot of the first riser on the stair centreline, then P2 up the stair"
                        Click="place_clicked"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
