<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Concrete Stair"
        Width="1200"
        Height="790"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushWindowBg}"
        TextElement.FontFamily="Segoe UI">

    <!-- Styles come from lib/Snippets/Seed43Styles.xaml, merged in by
         script.py after this file loads, so every Style here is a
         DynamicResource. -->

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                             CornerRadius="10"
                             GlassFrameThickness="0"
                             ResizeBorderThickness="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- A row label in the left panel -->
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- The unit sitting inside the right end of an input -->
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- Badge: the marker that ties a drawing's dimension to its input -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Thin line between the sections of the left panel -->
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BrushBorderMuted}"/>
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="Margin" Value="0,6,0,12"/>
        </Style>

        <!-- Stair / Reinforcement tabs: rounded, the active one in the accent -->
        <Style x:Key="SegTab" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BrushPillOffBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BrushPillOffBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Opacity"         Value="0.75"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreen}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value=""/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Opacity" Value="1"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- On / off switch with its label on the left, like the mockup -->
        <Style x:Key="SwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" Height="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Border x:Name="Track" Grid.Column="1" Width="40" Height="20" CornerRadius="10"
                                    Background="{DynamicResource BrushToggleOffBg}">
                                <Ellipse x:Name="Knob" Width="16" Height="16" Margin="2,0,0,0"
                                         HorizontalAlignment="Left"
                                         Fill="{DynamicResource BrushToggleKnob}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One line of the Calculations card -->
        <Style x:Key="CalcLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="CalcValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{DynamicResource BrushHeaderBg}" CornerRadius="10,10,12,12">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="header_icon"
                           Width="{DynamicResource SizeTopBarLogo}"
                           Height="{DynamicResource SizeTopBarLogo}"
                           Margin="0,0,10,0"/>
                    <TextBlock Text="Concrete " Foreground="{DynamicResource BrushPrimaryGreen}"
                               FontWeight="Bold" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text="Stair" Foreground="{DynamicResource BrushTextPrimary}"
                               FontWeight="Bold" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock x:Name="header_subtitle_tb" Text="| New stair" MinWidth="110"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               FontSize="16" FontWeight="SemiBold" Opacity="0.55"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <!-- Stair / Reinforcement tabs, in the title bar -->
                    <Button x:Name="tab_stair_btn" Content="Stair" Tag="Active" Width="158" Margin="20,0,8,0"
                            Style="{StaticResource SegTab}" Click="tab_stair_clicked"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="tab_rebar_btn" Content="Reinforcement" Tag="" Width="158"
                            Style="{StaticResource SegTab}" Click="tab_rebar_clicked"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
                <Button Content="&#x2715;" HorizontalAlignment="Right"
                        Style="{DynamicResource CloseButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="close_clicked"/>
            </Grid>
        </Border>

        <!-- BODY: inputs on the left, the three views and the numbers on the right -->
        <Grid Grid.Row="1" Margin="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="352"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================ LEFT PANEL ============================ -->
            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource MacScrollViewer}">
                        <Grid>

                            <!-- ===== PAGE: STAIR ===== -->
                            <StackPanel x:Name="page_stair" Margin="0,0,10,0">

                                <TextBlock Text="Levels &amp; Geometry" Style="{DynamicResource SectionLabelStyle}"/>

                                <!-- the end that is set; the other is steps x riser away -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="Working level" Style="{StaticResource RowLabel}"/>
                                    <StackPanel Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                                        <RadioButton x:Name="work_top_rb" GroupName="work" Content="Top"
                                                     IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center"
                                                     Style="{DynamicResource RadioButtonStyle}"
                                                     ToolTip="The top landing's RL is the one you set; the base works out from the steps"
                                                     Click="working_changed"/>
                                        <RadioButton x:Name="work_base_rb" GroupName="work" Content="Base"
                                                     VerticalAlignment="Center"
                                                     Style="{DynamicResource RadioButtonStyle}"
                                                     ToolTip="The first step's RL is the one you set; the top works out from the steps"
                                                     Click="working_changed"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="Level" Style="{StaticResource RowLabel}"/>
                                    <ComboBox x:Name="level_cb" Grid.Column="2"
                                              Style="{DynamicResource ComboBoxStyle}"
                                              SelectionChanged="inputs_changed"/>
                                    <Button Grid.Column="3" Content="&#x2316;" FontSize="18" HorizontalAlignment="Right"
                                            Style="{DynamicResource SmallIconButtonStyle}"
                                            ToolTip="Click a floor, slab, ground or reference plane; its height becomes the working RL"
                                            Click="pick_level_clicked"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="rl_lbl" Grid.Column="0" Grid.ColumnSpan="2" Text="RL top" Style="{StaticResource RowLabel}"/>
                                    <Grid Grid.Column="2">
                                        <TextBox x:Name="rl_tb" Text="0" Padding="0,0,30,0"
                                                 ToolTip="RL of the working end, as an offset from the level"
                                                 Style="{DynamicResource TextBoxStyle}" TextChanged="inputs_changed"/>
                                        <TextBlock Text="mm" Style="{StaticResource Unit}"/>
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="other_end_tb" Margin="0,0,0,10" Opacity="0.6" FontSize="11"
                                           TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}"/>

                                <!-- steps -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="Steps" Style="{StaticResource RowLabel}"/>
                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="&#x2212;" Height="28" Padding="0"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                ToolTip="One step fewer" Click="steps_down_clicked"/>
                                        <TextBox x:Name="steps_tb" Grid.Column="1" Margin="4,0" Text="4"
                                                 HorizontalContentAlignment="Center"
                                                 Style="{DynamicResource TextBoxStyle}" TextChanged="inputs_changed"
                                                 ToolTip="Number of steps (risers), counting the step up onto the landing"/>
                                        <Button Grid.Column="2" Content="+" Height="28" Padding="0"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                ToolTip="One step more" Click="steps_up_clicked"/>
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="rise_tb" Margin="0,0,0,10" Opacity="0.6" FontSize="11"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>

                                <!-- riser -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Riser" Style="{StaticResource RowLabel}"/>
                                    <Grid Grid.Column="2">
                                        <TextBox x:Name="riser_tb" Text="180" Padding="0,0,30,0"
                                                 ToolTip="Every riser is this height; steps x riser sets the other end"
                                                 Style="{DynamicResource TextBoxStyle}" TextChanged="inputs_changed"/>
                                        <TextBlock Text="mm" Style="{StaticResource Unit}"/>
                                    </Grid>
                                    <Button Grid.Column="3" Content="&#x2316;" FontSize="18" HorizontalAlignment="Right"
                                            Style="{DynamicResource SmallIconButtonStyle}"
                                            ToolTip="Pick 2 points: the height between them becomes the riser"
                                            Click="pick_riser_clicked"/>
                                </Grid>

                                <!-- going -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Going" Style="{StaticResource RowLabel}"/>
                                    <Grid Grid.Column="2">
                                        <TextBox x:Name="going_tb" Text="300" Padding="0,0,30,0"
                                                 ToolTip="Tread depth"
                                                 Style="{DynamicResource TextBoxStyle}" TextChanged="inputs_changed"/>
                                        <TextBlock Text="mm" Style="{StaticResource Unit}"/>
                                    </Grid>
                                    <Button Grid.Column="3" Content="&#x2316;" FontSize="18" HorizontalAlignment="Right"
                                            Style="{DynamicResource SmallIconButtonStyle}"
                                            ToolTip="Pick 2 points: the distance between them in plan becomes the going"
                                            Click="pick_going_clicked"/>
                                </Grid>

                                <!-- stair width -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="Stair width" Style="{StaticResource RowLabel}"/>
                                    <Grid Grid.Column="2">
                                        <TextBox x:Name="width_tb" Text="1200" Padding="0,0,30,0"
                                                 ToolTip="Stair width, in plan"
                                                 Style="{DynamicResource TextBoxStyle}" TextChanged="inputs_changed"/>
                                        <TextBlock Text="mm" Style="{StaticResource Unit}"/>
                                    </Grid>
                                    <Button Grid.Column="3" Content="&#x2316;" FontSize="18" HorizontalAlignment="Right"
                                            Style="{DynamicResource SmallIconButtonStyle}"
                                            ToolTip="Pick 2 points: the distance between them in plan becomes the width"
                                            Click="pick_width_clicked"/>
                                </Grid>

                                <!-- slope thickness -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Slope thickness" Style="{StaticResource RowLabel}"/>
                                    <Grid Grid.Column="2">
                                        <TextBox x:Name="waist_tb" Text="100" Padding="0,0,30,0"
                                                 ToolTip="Slab thickness square to the soffit, from the inside corners of the steps"
                                                 Style="{DynamicResource TextBoxStyle}" TextChanged="inputs_changed"/>
                                        <TextBlock Text="mm" Style="{StaticResource Unit}"/>
                                    </Grid>
                                </Grid>

                                <!-- landing slab thickness -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Landing thickness" Style="{StaticResource RowLabel}"/>
                                    <Grid Grid.Column="2">
                                        <TextBox x:Name="landing_tb" Text="100" Padding="0,0,30,0"
                                                 ToolTip="Top landing slab thickness: the stair's soffit meets its underside"
                                                 Style="{DynamicResource TextBoxStyle}" TextChanged="inputs_changed"/>
                                        <TextBlock Text="mm" Style="{StaticResource Unit}"/>
                                    </Grid>
                                </Grid>

                                <Border Style="{StaticResource Divider}" Margin="0,10,0,12"/>

                                <!-- TOP LANDING -->
                                <TextBlock Text="Top Landing" Style="{DynamicResource SectionLabelStyle}"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Landing length" Style="{StaticResource RowLabel}"/>
                                    <Grid Grid.Column="2">
                                        <TextBox x:Name="top_landing_tb" Text="" Padding="0,0,42,0"
                                                 ToolTip="Top landing length, from the top riser to the far end of the slab. Leave it empty for the least (to meet the landing underside); it is never shorter than that."
                                                 Style="{DynamicResource TextBoxStyle}" TextChanged="inputs_changed"/>
                                        <TextBlock Text="mm" Style="{StaticResource Unit}"/>
                                        <TextBlock Text="min" Opacity="0.4" FontSize="11" Margin="9,0,0,0"
                                                   IsHitTestVisible="False" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource BrushTextPrimary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=top_landing_tb}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Grid.Column="3" Content="&#x2316;" FontSize="18" HorizontalAlignment="Right"
                                            Style="{DynamicResource SmallIconButtonStyle}"
                                            ToolTip="Click the far edge of the top slab. Updating a stair: click it now. A new stair: TL shows 'pick' and you click it after P1 and P2."
                                            Click="pick_top_landing_clicked"/>
                                </Grid>
                                <TextBlock Text="Empty: the least, to meet the landing underside" Margin="0,0,0,0" Opacity="0.6" FontSize="11"
                                           TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}"/>

                                <Border Style="{StaticResource Divider}" Margin="0,12,0,12"/>

                                <!-- OPTIONS -->
                                <TextBlock Text="Options" Style="{DynamicResource SectionLabelStyle}"/>
                                <CheckBox x:Name="railings_cb" Content="Railings"
                                          ToolTip="Keep the railings Revit adds with the stair"
                                          Style="{StaticResource SwitchStyle}"/>
                                <CheckBox x:Name="footing_cb" Click="inputs_changed" IsChecked="True" Content="Footing"
                                          ToolTip="A Stair Footing under the first step, placed with the stair: outer face on the first riser, top at the base RL, across the full width. Its type is named by its size, e.g. 250x250. Bars, if added, hook into it."
                                          Style="{StaticResource SwitchStyle}"/>
                                <Grid Margin="0,0,0,8" IsEnabled="{Binding IsChecked, ElementName=footing_cb}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Footing width" Style="{StaticResource RowLabel}"/>
                                    <Grid Grid.Column="2">
                                        <TextBox x:Name="footing_w_tb" Text="250" Padding="0,0,30,0" TextChanged="inputs_changed"
                                                 ToolTip="Along the stair, from the face of the first riser"
                                                 Style="{DynamicResource TextBoxStyle}"/>
                                        <TextBlock Text="mm" Style="{StaticResource Unit}"/>
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,0,0,8" IsEnabled="{Binding IsChecked, ElementName=footing_cb}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Footing depth" Style="{StaticResource RowLabel}"/>
                                    <Grid Grid.Column="2">
                                        <TextBox x:Name="footing_d_tb" Text="250" Padding="0,0,30,0" TextChanged="inputs_changed"
                                                 ToolTip="Below the base RL"
                                                 Style="{DynamicResource TextBoxStyle}"/>
                                        <TextBlock Text="mm" Style="{StaticResource Unit}"/>
                                    </Grid>
                                </Grid>

                                <CheckBox x:Name="slab_cb" Content="Landing slab from picked lines"
                                          ToolTip="After the stair is made, pick the lines that outline the landing slab and it is made with this floor type"
                                          Style="{StaticResource SwitchStyle}"/>
                                <Grid Margin="0,0,0,8" IsEnabled="{Binding IsChecked, ElementName=slab_cb}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Floor type" Style="{StaticResource RowLabel}"/>
                                    <ComboBox x:Name="floor_type_cb" Grid.Column="2"
                                              Style="{DynamicResource ComboBoxStyle}"/>
                                </Grid>

                                <!-- MATERIAL -->
                                <Grid Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="Material" Style="{StaticResource RowLabel}"
                                               ToolTip="For the stair, footing and fill"/>
                                    <ComboBox x:Name="material_cb" Grid.Column="2"
                                              ToolTip="Set on the stair's run and landing types, the footing type and the fill type. These types are shared by every stair, footing and fill of the same size, so they change too."
                                              Style="{DynamicResource ComboBoxStyle}"/>
                                </Grid>
                            </StackPanel>

                            <!-- ===== PAGE: REINFORCEMENT ===== -->
                            <StackPanel x:Name="page_rebar" Margin="0,0,10,0" Visibility="Collapsed">

                                <TextBlock Text="Reinforcement" Style="{DynamicResource SectionLabelStyle}"/>
                                <CheckBox x:Name="rebar_cb" Style="{StaticResource SwitchStyle}"
                                          Content="Add bars when the stair is placed"
                                          Click="inputs_changed"/>
                                <Button Content="Add to a selected stair..." HorizontalAlignment="Stretch" Margin="0,0,0,12"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        ToolTip="Click an existing straight concrete stair and reinforce it with these settings"
                                        Click="rebar_existing_clicked"/>
                                <TextBlock Text="Rebar layout" Style="{DynamicResource FieldLabelStyle}"/>
                                <ComboBox x:Name="rebar_layout_cb" SelectionChanged="inputs_changed" Margin="0,0,0,4"
                                          ToolTip="How the bars are arranged. More layouts can be added to the tool as they are needed."
                                          Style="{DynamicResource ComboBoxStyle}"/>

                                <Border Style="{StaticResource Divider}" Margin="0,12,0,12"/>

                                <!-- MAIN BARS -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Main bars, down the soffit" Style="{DynamicResource SectionLabelStyle}" Margin="0"/>
                                </StackPanel>
                                <TextBlock Text="Bar" Style="{DynamicResource FieldLabelStyle}"/>
                                <ComboBox x:Name="main_bar_cb" SelectionChanged="inputs_changed" Margin="0,0,0,8" Style="{DynamicResource ComboBoxStyle}"/>
                                <TextBlock Text="Spacing (mm)" Style="{DynamicResource FieldLabelStyle}"/>
                                <TextBox x:Name="main_spacing_tb" TextChanged="inputs_changed" Text="450" Width="100" HorizontalAlignment="Left"
                                         Margin="0,0,0,8" Style="{DynamicResource TextBoxStyle}"/>
                                <TextBlock Text="Hook into the footing" Style="{DynamicResource FieldLabelStyle}"/>
                                <ComboBox x:Name="main_hook_cb" SelectionChanged="inputs_changed" Margin="0,0,0,8" Style="{DynamicResource ComboBoxStyle}"/>
                                <TextBlock Text="Leg into the landing slab (mm)" Style="{DynamicResource FieldLabelStyle}"/>
                                <TextBox x:Name="lap_tb" TextChanged="inputs_changed" Text="300" Width="100" HorizontalAlignment="Left"
                                         ToolTip="Past the bend at the top, into the landing: the lap with the slab bars"
                                         Style="{DynamicResource TextBoxStyle}"/>

                                <Border Style="{StaticResource Divider}" Margin="0,12,0,12"/>

                                <!-- BARS ACROSS -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox x:Name="dist_cb" Click="inputs_changed" Content="Bars across, up the slope" IsChecked="True"
                                              Style="{DynamicResource CheckBoxStyle}" Margin="0"/>
                                </StackPanel>
                                <TextBlock Text="Bar" Style="{DynamicResource FieldLabelStyle}"/>
                                <ComboBox x:Name="dist_bar_cb" SelectionChanged="inputs_changed" Margin="0,0,0,8" Style="{DynamicResource ComboBoxStyle}"/>
                                <TextBlock Text="Spacing along the slope (mm)" Style="{DynamicResource FieldLabelStyle}"/>
                                <TextBox x:Name="dist_spacing_tb" TextChanged="inputs_changed" Text="300" Width="100" HorizontalAlignment="Left"
                                         Style="{DynamicResource TextBoxStyle}"/>

                                <Border Style="{StaticResource Divider}" Margin="0,12,0,12"/>

                                <!-- MESH -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox x:Name="mesh_cb" Click="inputs_changed" Content="Mesh in the top landing, both ways"
                                              Style="{DynamicResource CheckBoxStyle}" Margin="0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="mesh_bar_cb" SelectionChanged="inputs_changed" Width="130" Style="{DynamicResource ComboBoxStyle}"/>
                                    <TextBlock Text="  @" Style="{StaticResource Lbl}"/>
                                    <TextBox x:Name="mesh_spacing_tb" TextChanged="inputs_changed" Text="200" Width="70"
                                             Style="{DynamicResource TextBoxStyle}"/>
                                </StackPanel>

                                <Border Style="{StaticResource Divider}" Margin="0,12,0,12"/>

                                <!-- COVERS -->
                                <TextBlock Text="Cover (mm)" Style="{DynamicResource SectionLabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Footing ends" Style="{StaticResource RowLabel}"/>
                                    <TextBox x:Name="cover_end_tb" TextChanged="inputs_changed" Grid.Row="0" Grid.Column="2" Width="80" Text="50"
                                             ToolTip="Side cover: from the footing's outer face to the U-bar's outer leg. The leg is placed at this cover."
                                             Style="{DynamicResource TextBoxStyle}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Footing bottom" Style="{StaticResource RowLabel}"/>
                                    <TextBox x:Name="cover_bottom_tb" TextChanged="inputs_changed" Grid.Row="2" Grid.Column="2" Width="80" Text="50"
                                             ToolTip="Bottom cover: from the footing's underside to the bottom of the U-bar's bend"
                                             Style="{DynamicResource TextBoxStyle}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Soffit (minimum)" Style="{StaticResource RowLabel}"/>
                                    <TextBox x:Name="cover_soffit_tb" TextChanged="inputs_changed" Grid.Row="4" Grid.Column="2" Width="80" Text="70"
                                             ToolTip="Square to the slope, from the soffit to the underside of the main bars. If the slope (SD) is too thin for this, it is raised to the next 5 mm."
                                             Style="{DynamicResource TextBoxStyle}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Below the step corners" Style="{StaticResource RowLabel}"/>
                                    <TextBox x:Name="corner_clear_tb" TextChanged="inputs_changed" Grid.Row="6" Grid.Column="2" Width="80" Text="50"
                                             ToolTip="Square to the slope, from the inside corners of the steps to the top of the bars across"
                                             Style="{DynamicResource TextBoxStyle}"/>
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="Top (landing)" Style="{StaticResource RowLabel}"/>
                                    <TextBox x:Name="cover_top_tb" TextChanged="inputs_changed" Grid.Row="8" Grid.Column="2" Width="80" Text="35"
                                             ToolTip="From the top of the landing to the top of the mesh"
                                             Style="{DynamicResource TextBoxStyle}"/>
                                    <TextBlock Grid.Row="10" Grid.Column="1" Text="Sides (across the width)" Style="{StaticResource RowLabel}"/>
                                    <TextBox x:Name="cover_side_tb" TextChanged="inputs_changed" Grid.Row="10" Grid.Column="2" Width="80" Text="40"
                                             ToolTip="From the stair's sides to the ends of the bars"
                                             Style="{DynamicResource TextBoxStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- a reason the stair cannot be made yet -->
                    <TextBlock x:Name="status_tb" Grid.Row="2" TextWrapping="Wrap" Margin="0,8,0,0"
                               FontSize="12" Foreground="{DynamicResource BrushDanger}"/>

                    <!-- UPDATE / RESET / APPLY -->
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1.25*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="update_pick_btn" Grid.Column="0" Content="Update" Height="38"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                ToolTip="Select an existing stair in the model: its sizes fill this window, and Apply then rebuilds it in the same place"
                                Click="update_pick_clicked"/>
                        <Button x:Name="reset_btn" Grid.Column="2" Content="Reset" Height="38"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                ToolTip="Back to the defaults, or to what the selected stair has now"
                                Click="reset_clicked"/>
                        <Button x:Name="place_btn" Grid.Column="4" Content="Apply" Height="38"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                ToolTip="Click P1 at the foot of the first riser on the stair centreline, then P2 up the stair"
                                Click="place_clicked"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============================ RIGHT SIDE ============================ -->
            <Grid x:Name="right_grid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="244"/>
                </Grid.RowDefinitions>

                <!-- SECTION (Stair tab) -->
                <Border x:Name="section_card" Grid.Row="0" Style="{DynamicResource CardStyle}" Padding="12,10,12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Section" Style="{DynamicResource SectionLabelStyle}" Margin="0,0,0,2"/>
                        <Canvas x:Name="drawing" Grid.Row="1" Width="770" Height="396"
                                HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True"/>
                        <!-- the dimensions' input boxes, over the drawing -->
                        <Canvas x:Name="drawing_edit" Grid.Row="1" Width="770" Height="396"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- REINFORCEMENT TAB: the footing and the top, zoomed, drive the setout -->
                <Grid x:Name="rebar_row" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- a reason the setout cannot be drawn yet -->
                    <TextBlock x:Name="rebar_note_tb" Grid.RowSpan="3" Panel.ZIndex="5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560" FontSize="14"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <Border x:Name="footing_card" Grid.Row="0" Style="{DynamicResource CardStyle}" Padding="12,10,12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource BrushPrimaryGreen}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Footing Detail" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>
                            <Canvas x:Name="footing_canvas" Grid.Row="1" Width="758" Height="300"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True"/>
                            <Canvas x:Name="footing_edit" Grid.Row="1" Width="758" Height="300"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border x:Name="top_card" Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="12,10,12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource BrushPrimaryGreen}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Top Detail" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>
                            <Canvas x:Name="top_canvas" Grid.Row="1" Width="758" Height="300"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True"/>
                            <Canvas x:Name="top_edit" Grid.Row="1" Width="758" Height="300"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
                <!-- PLAN / 3D / CALCULATIONS -->
                <Grid x:Name="bottom_grid" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="248"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="plan_card" Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="12,10,12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Plan View" Style="{DynamicResource SectionLabelStyle}" Margin="0,0,0,2"/>
                            <Canvas x:Name="plan_canvas" Grid.Row="1" Width="226" Height="186"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True"/>
                        </Grid>
                    </Border>

                    <Border x:Name="view3d_card" Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="12,10,12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="3D View" Style="{DynamicResource SectionLabelStyle}" Margin="0,0,0,2"/>
                            <Canvas x:Name="view3d_canvas" Grid.Row="1" Width="268" Height="186"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True"/>
                        </Grid>
                    </Border>

                    <Border x:Name="calc_card" Grid.Column="4" Style="{DynamicResource CardStyle}" Padding="14,10,14,8">
                        <StackPanel>
                            <TextBlock Text="Calculations" Style="{DynamicResource SectionLabelStyle}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Total Rise" Style="{StaticResource CalcLabel}"/>
                                <TextBlock x:Name="calc_rise_tb" Grid.Row="0" Grid.Column="1" Style="{StaticResource CalcValue}"/>
                                <TextBlock Grid.Row="1" Text="Total Run" Style="{StaticResource CalcLabel}"/>
                                <TextBlock x:Name="calc_run_tb" Grid.Row="1" Grid.Column="1" Style="{StaticResource CalcValue}"/>
                                <TextBlock Grid.Row="2" Text="Slope" Style="{StaticResource CalcLabel}"/>
                                <TextBlock x:Name="calc_slope_tb" Grid.Row="2" Grid.Column="1" Style="{StaticResource CalcValue}"/>
                                <TextBlock Grid.Row="3" Text="Landing Len." Style="{StaticResource CalcLabel}"/>
                                <TextBlock x:Name="calc_landing_tb" Grid.Row="3" Grid.Column="1" Style="{StaticResource CalcValue}"/>
                                <TextBlock Grid.Row="4" Text="Overall Length" Style="{StaticResource CalcLabel}"/>
                                <TextBlock x:Name="calc_length_tb" Grid.Row="4" Grid.Column="1" Style="{StaticResource CalcValue}"/>
                                <TextBlock Grid.Row="5" Text="Stair concrete" Style="{StaticResource CalcLabel}"/>
                                <TextBlock x:Name="calc_stair_vol_tb" Grid.Row="5" Grid.Column="1" Style="{StaticResource CalcValue}"/>
                                <TextBlock Grid.Row="6" Text="Footing + fill" Style="{StaticResource CalcLabel}"/>
                                <TextBlock x:Name="calc_foot_vol_tb" Grid.Row="6" Grid.Column="1" Style="{StaticResource CalcValue}"/>
                                <TextBlock Grid.Row="7" Text="Concrete Volume" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource BrushPrimaryGreen}"/>
                                <TextBlock x:Name="calc_total_vol_tb" Grid.Row="7" Grid.Column="1" FontWeight="Bold" FontSize="13"
                                           HorizontalAlignment="Right" Foreground="{DynamicResource BrushPrimaryGreen}"/>
                            </Grid>
                            <TextBlock x:Name="type_tb" Margin="0,8,0,0" Opacity="0.55" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
