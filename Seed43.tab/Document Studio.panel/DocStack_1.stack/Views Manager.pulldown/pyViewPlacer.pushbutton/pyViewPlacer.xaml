<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="pyViewPlacer"
        Height="660"
        MinHeight="400"
        MaxHeight="900"
        Width="450"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="True"
        TextElement.FontFamily="Segoe UI"
        Background="#3B4553">

    <Window.Resources>

        <!-- ── Card ──────────────────────────────────────────────────── -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"   Value="#2B3340"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding"      Value="16"/>
            <Setter Property="Margin"       Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.2" ShadowDepth="2" BlurRadius="4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Text ──────────────────────────────────────────────────── -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#208A3C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4FAFF"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
            <Setter Property="Opacity"    Value="0.9"/>
        </Style>

        <!-- ── TextBox ───────────────────────────────────────────────── -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background"               Value="#F4FAFF"/>
            <Setter Property="Foreground"               Value="#2B3340"/>
            <Setter Property="BorderBrush"              Value="#208A3C"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="8,4"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Height"                   Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#2B933F"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush"     Value="#2B933F"/>
                                <Setter TargetName="MainBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Buttons ───────────────────────────────────────────────── -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#208A3C"/>
            <Setter Property="Foreground"      Value="#F4FAFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="24,8"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2B933F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1A6E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionsToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#F4FAFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="18"/>
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#208A3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#1A6B2F"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#208A3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuItemButtonStyle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="#F4FAFF"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Padding"                    Value="12,8"/>
            <Setter Property="FontSize"                   Value="12"/>
            <Setter Property="HorizontalAlignment"        Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#208A3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#1A6B2F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Scrollbar ─────────────────────────────────────────────── -->
        <Style x:Key="MacScrollBarThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#208A3C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumb"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Margin="2,2,2,2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="#27AE60"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="#2ECC71"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacScrollBar" TargetType="ScrollBar">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Width"       Value="8"/>
            <Setter Property="MinWidth"    Value="8"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="GridRoot" Width="8">
                            <Track x:Name="PART_Track"
                                   Orientation="Vertical"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MacScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GridRoot" Property="Width" Value="10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Orientation="Vertical"
                                       Style="{StaticResource MacScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ListBox ───────────────────────────────────────────────── -->
        <Style x:Key="PanelListBoxStyle" TargetType="ListBox">
            <Setter Property="Background"      Value="#3B4553"/>
            <Setter Property="Foreground"      Value="#F4FAFF"/>
            <Setter Property="BorderBrush"     Value="#208A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="4"/>
            <Setter Property="Height"          Value="320"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer Style="{StaticResource MacScrollViewer}"
                                          Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding"    Value="8,4"/>
            <Setter Property="Foreground" Value="#F4FAFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#208A3C"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2B933F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <DockPanel Margin="0,0,0,1">

        <!-- ── HEADER ──────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="#232933"
                Height="70"
                CornerRadius="0,0,12,12">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="2" BlurRadius="6"/>
            </Border.Effect>
            <Grid Margin="24,0,24,0">

                <!-- Left, wordmark and context label -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <TextBlock Text="py"
                               FontWeight="Bold"
                               FontSize="32"
                               Foreground="#208A3C"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="ViewPlacer"
                               FontWeight="SemiBold"
                               FontSize="32"
                               Foreground="#F4FAFF"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="header_subtitle"
                               FontWeight="SemiBold"
                               FontSize="20"
                               Foreground="#F4FAFF"
                               Opacity="0.75"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- Right, options toggle and popup -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <Grid>
                        <ToggleButton x:Name="options_btn"
                                      Content="&#x2630;"
                                      Style="{StaticResource OptionsToggleButtonStyle}"/>
                        <Popup x:Name="options_popup"
                               PlacementTarget="{Binding ElementName=options_btn}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               IsOpen="{Binding IsChecked, ElementName=options_btn}">
                            <Border Background="#2B3340"
                                    BorderBrush="#208A3C"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MinWidth="200">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.4" ShadowDepth="3" BlurRadius="8"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Button x:Name="help_btn"
                                            Content="? Help"
                                            Style="{StaticResource MenuItemButtonStyle}"/>
                                    <Rectangle Fill="#404553" Height="1" Margin="0,2"/>
                                    <Button x:Name="about_btn"
                                            Content="&#x2139; About pyViewPlacer"
                                            Style="{StaticResource MenuItemButtonStyle}"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ── CONTENT AREA ────────────────────────────────────────────── -->
        <ScrollViewer x:Name="main_scroll"
                      Style="{StaticResource MacScrollViewer}"
                      Margin="24,24,24,24">
            <StackPanel x:Name="content_panel">

                <!-- ── PANEL: View Template ─────────────────────────────── -->
                <Border x:Name="panel_template"
                        Style="{StaticResource CardStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Select View Template"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Text="Search:"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="template_search"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Margin="0,0,0,8"/>
                        <ListBox x:Name="template_list"
                                 Style="{StaticResource PanelListBoxStyle}"
                                 ItemContainerStyle="{StaticResource PanelListBoxItemStyle}"/>
                        <Button x:Name="template_ok_btn"
                                Content="OK"
                                Width="100"
                                Height="36"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource ModernButtonStyle}"/>
                    </StackPanel>
                </Border>

                <!-- ── PANEL: Sheet Selection ───────────────────────────── -->
                <Border x:Name="panel_sheet"
                        Style="{StaticResource CardStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Select Target Sheet"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Text="Search:"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="sheet_search"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Margin="0,0,0,8"/>
                        <ListBox x:Name="sheet_list"
                                 Style="{StaticResource PanelListBoxStyle}"
                                 ItemContainerStyle="{StaticResource PanelListBoxItemStyle}"/>
                        <Button x:Name="sheet_ok_btn"
                                Content="OK"
                                Width="100"
                                Height="36"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource ModernButtonStyle}"/>
                    </StackPanel>
                </Border>

                <!-- ── PANEL: Viewport Type ─────────────────────────────── -->
                <Border x:Name="panel_viewport"
                        Style="{StaticResource CardStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Select Viewport Type"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Text="Search:"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="viewport_search"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Margin="0,0,0,8"/>
                        <ListBox x:Name="viewport_list"
                                 Style="{StaticResource PanelListBoxStyle}"
                                 ItemContainerStyle="{StaticResource PanelListBoxItemStyle}"/>
                        <Button x:Name="viewport_ok_btn"
                                Content="OK"
                                Width="100"
                                Height="36"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource ModernButtonStyle}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
