<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        HorizontalContentAlignment="Center"
        WindowStyle="None"
        ResizeMode="CanResize" 
        SizeToContent="Height" 
        Width="950" 
        MinHeight="500"
        Title="Naming Formats" 
        Closing="cancelled"
        Background="#3B4553">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="70"
                             CornerRadius="10"
                             GlassFrameThickness="0"
                             ResizeBorderThickness="8"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="BrushWindowBg" Color="#3B4553"/>
        <SolidColorBrush x:Key="BrushCardBg" Color="#2B3340"/>
        <SolidColorBrush x:Key="BrushHeaderBg" Color="#232933"/>
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#F4FAFF"/>
        <SolidColorBrush x:Key="BrushTextInput" Color="#2B3340"/>
        <SolidColorBrush x:Key="BrushInputBg" Color="#F4FAFF"/>
        <SolidColorBrush x:Key="BrushPrimaryGreen" Color="#208A3C"/>
        <SolidColorBrush x:Key="BrushPrimaryGreenHover" Color="#2B933F"/>
        <SolidColorBrush x:Key="BrushPrimaryGreenPressed" Color="#1A6B2F"/>
        <SolidColorBrush x:Key="BrushBorderHover" Color="#2B933F"/>
        <SolidColorBrush x:Key="BrushBorderPressed" Color="#2B933F"/>
        <SolidColorBrush x:Key="BrushSecondaryBg" Color="#404553"/>
        <SolidColorBrush x:Key="BrushDanger" Color="#C53030"/>
        <SolidColorBrush x:Key="BrushSuccess" Color="#27AE60"/>
        <SolidColorBrush x:Key="BrushSuccessHover" Color="#2ECC71"/>

        <!-- Card -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.2" ShadowDepth="2" BlurRadius="4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Labels -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <!-- TextBox -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextInput}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderPressed}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS-style slim green scrollbar -->
        <Style x:Key="MacScrollBarThumb" TargetType="Thumb">
            <Setter Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumb"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="{DynamicResource BrushSuccess}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="{DynamicResource BrushSuccessHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="GridRoot" Width="8" Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Orientation="Vertical"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MacScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GridRoot" Property="Width" Value="10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox -->
        <Style x:Key="ModernListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom title bar control: close -->
        <Style x:Key="WinCtrlCloseBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushDanger}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="24,24,24,24">
        <!-- Header -->
        <Border Background="{DynamicResource BrushHeaderBg}" 
                Height="70" 
                DockPanel.Dock="Top"
                CornerRadius="0,0,12,12"
                Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="2" BlurRadius="6"/>
            </Border.Effect>
            <Grid Margin="24,0,24,0">
                <StackPanel Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            HorizontalAlignment="Left">
                    <TextBlock Text="py"
                               FontWeight="Bold"
                               FontSize="32"
                               Foreground="{DynamicResource BrushPrimaryGreen}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Naming"
                               FontWeight="SemiBold"
                               FontSize="32"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="win_close_btn"
                        Content="&#10005;"
                        Style="{StaticResource WinCtrlCloseBtn}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTip="Close"
                        Click="win_close_clicked"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="200" Width="1*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition MinWidth="450" Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,5,0">
                <DockPanel>
                    <TextBlock Text="Naming Formats" 
                               Style="{StaticResource SectionLabelStyle}" 
                               DockPanel.Dock="Top" />
                    <Button Content="Save" 
                            Height="32" 
                            Margin="0,8,0,0" 
                            Style="{StaticResource ModernButtonStyle}" 
                            Click="save_formats" 
                            DockPanel.Dock="Bottom"/>
                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" 
                                Content="Duplicate" 
                                Height="32" 
                                Margin="0,0,3,0" 
                                Style="{StaticResource ModernButtonStyle}" 
                                Click="duplicate_namingformat"/>
                        <Button Grid.Column="1" 
                                Content="Delete" 
                                Height="32" 
                                Margin="2,0,0,0" 
                                Style="{StaticResource ModernButtonStyle}" 
                                Click="delete_namingformat"/>
                    </Grid>
                    <ListBox x:Name="formats_lb" 
                             Style="{StaticResource ModernListBoxStyle}" 
                             SelectionChanged="namingformat_changed" 
                             SelectionMode="Single" 
                             SelectedIndex="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding name}" Foreground="{DynamicResource BrushTextPrimary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" 
                          HorizontalAlignment="Stretch" 
                          Width="4" 
                          Background="{DynamicResource BrushPrimaryGreen}"/>

            <!-- Right Panel -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="5,0,0,0">
                <StackPanel x:Name="namingformat_edit">
                    <TextBlock Text="Format Title" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock TextWrapping="Wrap" 
                               Style="{StaticResource FieldLabelStyle}"
                               Foreground="{DynamicResource BrushTextPrimary}">
                        This is the name of this specific naming format. Give the format a descriptive
                        name that is easy to understand and find. For example: "City of Portland ePermit"
                    </TextBlock>
                    <TextBox x:Name="template_name_tb"
                             Text="{Binding name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"/>

                    <TextBlock Text="Template" 
                               Style="{StaticResource SectionLabelStyle}" 
                               Margin="0,10,0,0" />
                    <TextBlock TextWrapping="Wrap" 
                               Style="{StaticResource FieldLabelStyle}"
                               Foreground="{DynamicResource BrushTextPrimary}">
                        This is the actual naming format template. Each "{}" (tag) represents a value that will be
                        filled when creating the name for a PDF file. Pick and choose from the tags listed
                        below and drag them to this box.
                    </TextBlock>
                    <TextBox x:Name="template_tb"
                             Text="{Binding template, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             AllowDrop="True" 
                             PreviewDrop="stop_drag" 
                             PreviewDragOver="preview_drag"
                             TextChanged="template_changed"/>

                    <TextBlock Text="Preview" 
                               Style="{StaticResource SectionLabelStyle}" 
                               Margin="0,10,0,0" />
                    <TextBox x:Name="preview_tb"
                             IsReadOnly="True"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Foreground="{DynamicResource BrushPrimaryGreen}"
                             Background="{DynamicResource BrushHeaderBg}"/>

                    <TextBlock Text="Drag and drop from formatters below. Hover over the formatter for description" 
                               Style="{StaticResource FieldLabelStyle}"
                               Foreground="{DynamicResource BrushTextPrimary}" 
                               Margin="0,5,0,0"/>
                    <ItemsControl x:Name="formatters_wp" Margin="0,5,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" PreviewMouseLeftButtonDown="start_drag"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="formatter_box" 
                                        Height="20" 
                                        Margin="5,5,0,0" 
                                        Background="DarkGray" 
                                        BorderThickness="0" 
                                        CornerRadius="5" 
                                        ToolTip="{Binding desc}">
                                    <TextBlock Text="{Binding template}" 
                                               FontFamily="Consolas" 
                                               Foreground="White" 
                                               VerticalAlignment="Center" 
                                               Margin="5,0,5,0" 
                                               Padding="0,0,0,1" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding template}" Value="{}{name}">
                                        <Setter TargetName="formatter_box" Property="Background" Value="{DynamicResource BrushHeaderBg}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding template}" Value="{}{name_dash}">
                                        <Setter TargetName="formatter_box" Property="Background" Value="{DynamicResource BrushHeaderBg}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding template}" Value="{}{name_underline}">
                                        <Setter TargetName="formatter_box" Property="Background" Value="{DynamicResource BrushHeaderBg}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding template}" Value="{}{rev_number}">
                                        <Setter TargetName="formatter_box" Property="Background" Value="#d84936" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding template}" Value="{}{rev_desc}">
                                        <Setter TargetName="formatter_box" Property="Background" Value="#d84936" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding template}" Value="{}{rev_date}">
                                        <Setter TargetName="formatter_box" Property="Background" Value="#d84936" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding template}" Value="{}{proj_name}">
                                        <Setter TargetName="formatter_box" Property="Background" Value="#665dba" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding template}" Value="{}{proj_number}">
                                        <Setter TargetName="formatter_box" Property="Background" Value="#665dba" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding template}" Value="{}{proj_building_name}">
                                        <Setter TargetName="formatter_box" Property="Background" Value="#665dba" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding template}" Value="{}{proj_issue_date}">
                                        <Setter TargetName="formatter_box" Property="Background" Value="#665dba" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding template}" Value="{}{proj_org_name}">
                                        <Setter TargetName="formatter_box" Property="Background" Value="#665dba" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding template}" Value="{}{proj_status}">
                                        <Setter TargetName="formatter_box" Property="Background" Value="#665dba" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding template}" Value="{}{sheet_param:PARAM_NAME}">
                                        <Setter TargetName="formatter_box" Property="Background" Value="Black" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding template}" Value="{}{tblock_param:PARAM_NAME}">
                                        <Setter TargetName="formatter_box" Property="Background" Value="Black" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding template}" Value="{}{proj_param:PARAM_NAME}">
                                        <Setter TargetName="formatter_box" Property="Background" Value="Black" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding template}" Value="{}{glob_param:PARAM_NAME}">
                                        <Setter TargetName="formatter_box" Property="Background" Value="Black" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>