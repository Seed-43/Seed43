<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        SizeToContent="Height"
        Width="700"
        MinHeight="300"
        Title="Export Folder Preset"
        Background="{DynamicResource BrushWindowBg}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="70"
                             CornerRadius="10"
                             GlassFrameThickness="0"
                             ResizeBorderThickness="8"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BrushWindowBg"       Color="#3B4553"/>
        <SolidColorBrush x:Key="BrushCardBg"     Color="#2B3340"/>
        <SolidColorBrush x:Key="BrushHeaderBg"     Color="#232933"/>
        <SolidColorBrush x:Key="BrushPrimaryGreen"    Color="#208A3C"/>
        <SolidColorBrush x:Key="BrushTextPrimary"     Color="#F4FAFF"/>
        <SolidColorBrush x:Key="BrushTextInput"       Color="#2B3340"/>
        <SolidColorBrush x:Key="BrushInputBg"         Color="#F4FAFF"/>
        <SolidColorBrush x:Key="BrushDanger" Color="#C0392B"/>
        <SolidColorBrush x:Key="BrushSuccess" Color="#27AE60"/>
        <SolidColorBrush x:Key="BrushSecondaryPressed" Color="#333B48"/>

        <Style x:Key="GreenBtn" TargetType="Button">
            <Setter Property="Background"  Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="Foreground"  Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Padding"     Value="16,8"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSuccess}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkBtn" TargetType="Button">
            <Setter Property="Background"  Value="{DynamicResource BrushHeaderBg}"/>
            <Setter Property="Foreground"  Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Padding"     Value="16,8"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Token chip — color set per-instance via Tag in code-behind is
             overkill; we just set Background directly on each chip. -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Foreground"  Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Padding"     Value="8,3"/>
            <Setter Property="Margin"      Value="0,0,6,6"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background"  Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="Foreground"  Value="{DynamicResource BrushTextInput}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Padding"     Value="8,0"/>
            <Setter Property="Height"      Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="FontSize"    Value="15"/>
            <Setter Property="Margin"      Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Margin"      Value="0,10,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="Opacity"     Value="0.7"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Custom title bar control: close -->
        <Style x:Key="WinCtrlCloseBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushDanger}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="0">
        <!-- Header -->
        <Border Background="{DynamicResource BrushHeaderBg}"
                Height="70"
                DockPanel.Dock="Top"
                CornerRadius="0,0,12,12">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="2" BlurRadius="6"/>
            </Border.Effect>
            <Grid Margin="20,0,16,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <TextBlock Text="py" FontWeight="Bold" FontSize="26"
                               Foreground="{DynamicResource BrushPrimaryGreen}"/>
                    <TextBlock Text="Sheets" FontWeight="Bold" FontSize="26"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="  |  Export Folder Preset" FontSize="16"
                               Foreground="{DynamicResource BrushTextPrimary}" Opacity="0.6"
                               VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                </StackPanel>
                <Button x:Name="win_close_btn"
                        Content="&#10005;"
                        Style="{StaticResource WinCtrlCloseBtn}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTip="Close"
                        Click="win_close_clicked"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="{DynamicResource BrushCardBg}"
                    CornerRadius="8"
                    Margin="20"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Export Folder Preset" Style="{StaticResource Section}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                               Text="Set the root folder where project folders are stored, then build the full export path using tokens below."/>

                    <TextBlock Text="Preset Name" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <TextBox x:Name="name_tb" Style="{StaticResource Field}"/>

                    <TextBlock Text="Projects Root" Style="{StaticResource Label}"/>
                    <DockPanel>
                        <Button x:Name="browse_btn" Content="Browse…"
                                DockPanel.Dock="Right" Width="90"
                                Margin="8,0,0,0"
                                Style="{StaticResource GreenBtn}"
                                Click="browse_clicked"/>
                        <TextBox x:Name="root_tb" Style="{StaticResource Field}"
                                 TextChanged="field_changed"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Foreground="{DynamicResource BrushPrimaryGreen}" Margin="0,6,0,0"
                               Text='Range-bucket folders are matched automatically, e.g. "#JOB-4251-4300" for job 4293.'/>

                    <TextBlock Text="Output Path Template" Style="{StaticResource Label}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                               Text="Build the full output folder path using tokens. Drag or click tokens below to insert."/>
                    <TextBox x:Name="template_tb" Style="{StaticResource Field}"
                             AllowDrop="True"
                             TextChanged="field_changed"
                             PreviewDragOver="template_drag_over"
                             PreviewDrop="template_drop"/>
                    <TextBlock x:Name="wildcard_hint_tb" Style="{StaticResource Hint}"
                               Foreground="{DynamicResource BrushDanger}" Margin="0,6,0,0"/>

                    <TextBlock Text="Preview" Style="{StaticResource Label}"/>
                    <TextBox x:Name="preview_tb" Style="{StaticResource Field}"
                             IsReadOnly="True"
                             Background="{DynamicResource BrushHeaderBg}"
                             Foreground="{DynamicResource BrushPrimaryGreen}"/>

                    <TextBlock Text="Available tokens — drag or click to insert"
                               Style="{StaticResource Label}"/>
                    <WrapPanel x:Name="token_panel"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,18,0,0">
                        <Button x:Name="cancel_btn" Content="Cancel" Width="90"
                                Style="{StaticResource DarkBtn}"
                                Margin="0,0,8,0"
                                Click="cancel_clicked"/>
                        <Button x:Name="save_btn" Content="Save" Width="90"
                                Style="{StaticResource GreenBtn}"
                                Click="save_clicked"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
