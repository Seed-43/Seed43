<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        SizeToContent="Height"
        Width="480"
        MinHeight="200"
        Title="Manage Profiles"
        Background="#3B4553">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="60"
                             CornerRadius="10"
                             GlassFrameThickness="0"
                             ResizeBorderThickness="8"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Card"  Color="#2B3340"/>
        <SolidColorBrush x:Key="Dark"  Color="#232933"/>
        <SolidColorBrush x:Key="Green" Color="#208A3C"/>
        <SolidColorBrush x:Key="Text"  Color="#F4FAFF"/>
        <SolidColorBrush x:Key="Red"   Color="#C0392B"/>

        <Style x:Key="RowBtn" TargetType="Button">
            <Setter Property="Background"  Value="{StaticResource Dark}"/>
            <Setter Property="Foreground"  Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Padding"     Value="10,8"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333B48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource RowBtn}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- One unified card per profile row -->
        <Style x:Key="RowCard" TargetType="Border">
            <Setter Property="Background"   Value="{StaticResource Dark}"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style x:Key="DeleteIconBtnFlat" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="6" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Red}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom title bar control: close -->
        <Style x:Key="WinCtrlCloseBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C53030"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border Background="{StaticResource Dark}" Height="60" DockPanel.Dock="Top" CornerRadius="0,0,12,12">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="2" BlurRadius="6"/>
            </Border.Effect>
            <Grid Margin="20,0,16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="py" FontWeight="Bold" FontSize="22" Foreground="{StaticResource Green}"/>
                    <TextBlock Text="Sheets" FontWeight="Bold" FontSize="22" Foreground="{StaticResource Text}"/>
                    <TextBlock Text="  |  Manage Profiles" FontSize="14"
                               Foreground="{StaticResource Text}" Opacity="0.6"
                               VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                </StackPanel>
                <Button x:Name="win_close_btn"
                        Content="&#10005;"
                        Style="{StaticResource WinCtrlCloseBtn}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTip="Close"
                        Click="win_close_clicked"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <Border Background="{StaticResource Card}" CornerRadius="8" Margin="20" Padding="16">
            <StackPanel>
                <TextBlock Text="Deleting a profile only removes it here — use the header + and save buttons to create or update one."
                           Foreground="{StaticResource Text}"
                           Opacity="0.55"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>
                <StackPanel x:Name="profile_list_panel"/>
            </StackPanel>
        </Border>
    </DockPanel>
</Window>
