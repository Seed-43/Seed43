<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="pyTable"
        Width="960" Height="720"
        MinWidth="700" MinHeight="400" MaxHeight="900"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushWindowBg}"
        TextElement.FontFamily="Segoe UI"
        TextElement.Foreground="{DynamicResource BrushTextPrimary}"
        FontSize="12">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                             CornerRadius="10"
                             GlassFrameThickness="0"
                             ResizeBorderThickness="12"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- No canonical token exists yet for a neutral (non-accent-green)
             divider colour - every canonical border token is accent-green
             (see migration plan "Known gap"). Kept as a local named brush,
             same pattern pyTransmit uses for LocalBrushNoticeBg/
             LocalBrushNoticeText - genuinely no shared-token equivalent to
             inject at runtime, so this stays declared here directly. -->
        <SolidColorBrush x:Key="LocalBrushMenuBorder"       Color="#404553"/>

        <!-- These 5 styles are looked up via FindResource() throughout
             pyTable_ui.py. They used to live only in the unused
             PyTables.xaml (nothing loads that file), so every lookup
             silently failed and fell back to native/plain rendering,
             this is why the dropdown arrow and a few other controls
             looked inconsistent. Defined here now, in the file this
             window actually loads. -->
        <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background"    Value="{DynamicResource BrushCardBg}"/>
                <Setter Property="CornerRadius"  Value="{DynamicResource CornerRadiusCard}"/>
                <Setter Property="Padding"       Value="{DynamicResource PaddingCard}"/>
                <Setter Property="Margin"        Value="0,0,0,12"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="Black" Opacity="0.2" ShadowDepth="2" BlurRadius="4"/>
                    </Setter.Value>
                </Setter>
            </Style>

        <!-- SectionLabelStyle (dead code, removed) - confirmed zero
             references anywhere in this file or in PyTable.py/
             pytable_excel.py/pytable_word.py/pytable_shared.py. -->

        <!-- Kept as its own local name rather than renamed to a canonical
             style - it's used for accent-coloured action buttons ("+ Add
             Tables", "Apply"), not tabs, but sized like button_small, not
             button_primary - same situation as Layout Builder's PBtn.
             Colours reconciled to the shared accent palette below; sizing
             stays PyTable's own for now. -->
        <Style x:Key="SmallButtonStyle" TargetType="Button">
                <Setter Property="Background"      Value="{DynamicResource BrushPrimaryGreen}"/>
                <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding"         Value="{DynamicResource PaddingButtonSmall}"/>
                <Setter Property="FontSize"        Value="{DynamicResource FontSizeButtonSmall}"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Height"          Value="{DynamicResource HeightButtonSmall}"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource CornerRadiusButtonSmall}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        <!-- Canonical dark-theme input styles, matching pyTransmit's
             TextBoxStyle/ComboBoxStyle exactly (same key names, same
             DynamicResource-only structure, no locally hardcoded colours).
             Replaces the earlier GridCellStyle/GridComboBoxStyle
             light-on-dark variant. -->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
                <Setter Property="Background"               Value="{DynamicResource BrushInputBg}"/>
                <Setter Property="Foreground"               Value="{DynamicResource BrushTextInput}"/>
                <Setter Property="BorderBrush"              Value="{DynamicResource BrushBorderDefault}"/>
                <Setter Property="BorderThickness"          Value="{DynamicResource BorderThicknessInput}"/>
                <Setter Property="Padding"                  Value="{DynamicResource PaddingInput}"/>
                <Setter Property="FontSize"                 Value="{DynamicResource FontSizeInput}"/>
                <Setter Property="Height"                   Value="{DynamicResource HeightInput}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource CornerRadiusInput}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MainBorder" Property="Background"   Value="{DynamicResource BrushInputBgHover}"/>
                                    <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="MainBorder" Property="Background"      Value="{DynamicResource BrushInputBgPressed}"/>
                                    <Setter TargetName="MainBorder" Property="BorderBrush"     Value="{DynamicResource BrushBorderHover}"/>
                                    <Setter TargetName="MainBorder" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        <!-- Same as TextBoxStyle but for a name-conflict error state -
             canonical BrushDanger/BrushDangerHover tokens instead of the
             green border/hover pair, so a typed conflict can't be masked
             by the normal focus trigger. -->
        <Style x:Key="TextBoxErrorStyle" TargetType="TextBox">
                <Setter Property="Background"               Value="{DynamicResource BrushInputBg}"/>
                <Setter Property="Foreground"               Value="{DynamicResource BrushTextInput}"/>
                <Setter Property="BorderBrush"              Value="{DynamicResource BrushDanger}"/>
                <Setter Property="BorderThickness"          Value="{DynamicResource BorderThicknessInput}"/>
                <Setter Property="Padding"                  Value="{DynamicResource PaddingInput}"/>
                <Setter Property="FontSize"                 Value="{DynamicResource FontSizeInput}"/>
                <Setter Property="Height"                   Value="{DynamicResource HeightInput}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource CornerRadiusInput}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource BrushDangerHover}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="MainBorder" Property="BorderBrush"     Value="{DynamicResource BrushDangerHover}"/>
                                    <Setter TargetName="MainBorder" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background"      Value="{DynamicResource BrushInputBg}"/>
                <Setter Property="Foreground"      Value="{DynamicResource BrushTextInput}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorderDefault}"/>
                <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessInput}"/>
                <Setter Property="Padding"         Value="{DynamicResource PaddingCombobox}"/>
                <Setter Property="FontSize"        Value="{DynamicResource FontSizeCombobox}"/>
                <Setter Property="Height"          Value="{DynamicResource HeightCombobox}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource CornerRadiusCombobox}">
                                <Grid>
                                    <ToggleButton x:Name="ToggleButton"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <Path x:Name="Arrow"
                                              Fill="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"
                                              Data="M 0 0 L 4 4 L 8 0 Z"/>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="ContentSite"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>
                                    <Popup x:Name="Popup"
                                           Placement="Bottom"
                                           IsOpen="{TemplateBinding IsDropDownOpen}"
                                           AllowsTransparency="True"
                                           Focusable="False"
                                           PopupAnimation="Slide">
                                        <Border Background="{DynamicResource BrushCardBg}"
                                                BorderBrush="{DynamicResource BrushBorderDefault}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource CornerRadiusDropdownPopup}"
                                                MinWidth="{TemplateBinding ActualWidth}">
                                            <ScrollViewer MaxHeight="260">
                                                <StackPanel IsItemsHost="True"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MainBorder" Property="Background"   Value="{DynamicResource BrushInputBgHover}"/>
                                    <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="MainBorder" Property="Background"      Value="{DynamicResource BrushInputBgPressed}"/>
                                    <Setter TargetName="MainBorder" Property="BorderBrush"     Value="{DynamicResource BrushBorderHover}"/>
                                    <Setter TargetName="MainBorder" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="MainBorder" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background"  Value="Transparent"/>
                            <Setter Property="Foreground"  Value="{DynamicResource BrushTextInput}"/>
                            <Setter Property="Padding"     Value="{DynamicResource PaddingDropdownItem}"/>
                            <Setter Property="Margin"      Value="4,2,4,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="{DynamicResource CornerRadiusDropdownItem}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushDropdownItemHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                                                <Setter Property="Foreground"                          Value="{DynamicResource BrushTextPrimary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

        <!-- These 5 are referenced directly in this file's own markup
             (not just via FindResource in Python), missed in the first pass
             which only checked Python-side lookups. -->
        <Style x:Key="MacScrollBarThumb" TargetType="Thumb">
                <Setter Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="thumb"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    Margin="2,2,2,2"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="thumb" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="thumb" Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        <Style x:Key="MacScrollBar" TargetType="ScrollBar">
                <Setter Property="Orientation" Value="Vertical"/>
                <Setter Property="Width"       Value="8"/>
                <Setter Property="MinWidth"    Value="8"/>
                <Setter Property="Background"  Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid x:Name="GridRoot" Width="8">
                                <Track x:Name="PART_Track"
                                       Orientation="Vertical"
                                       IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource MacScrollBarThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GridRoot" Property="Width" Value="10"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        <Style x:Key="MacScrollViewer" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ScrollContentPresenter Grid.Column="0"
                                                        Margin="{TemplateBinding Padding}"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                           Grid.Column="1"
                                           Orientation="Vertical"
                                           Style="{StaticResource MacScrollBar}"
                                           Value="{TemplateBinding VerticalOffset}"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background"      Value="{DynamicResource BrushSecondaryBg}"/>
                <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding"         Value="{DynamicResource PaddingButtonSecondary}"/>
                <Setter Property="FontSize"        Value="{DynamicResource FontSizeButtonSecondary}"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource CornerRadiusButtonSecondary}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryPressed}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                                    <Setter Property="Foreground"                  Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width"           Value="{DynamicResource WidthButtonMenu}"/>
            <Setter Property="Height"          Value="{DynamicResource HeightButtonMenu}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize"        Value="18"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="{DynamicResource CornerRadiusButtonMenu}"
                                Width="{DynamicResource WidthButtonMenu}" Height="{DynamicResource HeightButtonMenu}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="Width"           Value="{DynamicResource WidthButtonClose}"/>
            <Setter Property="Height"          Value="{DynamicResource HeightButtonClose}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButtonClose}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushDanger}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Delete button - permanently danger-red (not transparent-until-
             hover), for "delete this item" actions. Matches the canonical
             definition in Seed43Styles.xaml/pyTransmit exactly: same
             WidthButtonClose/HeightButtonClose/CornerRadiusButtonClose
             tokens as CloseButtonStyle, just always-on BrushDanger with
             an opacity dim on hover instead of a colour change. -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BrushDanger}"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="{DynamicResource WidthButtonClose}"/>
            <Setter Property="Height"          Value="{DynamicResource HeightButtonClose}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButtonClose}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Round action button - accent green when IsEnabled (an action is
             genuinely available/needed, e.g. "reload" when a source has
             changed), the shared disabled look when not (nothing to do
             right now). Uses the real IsEnabled property rather than a
             separate colour-only flag, so a disabled state also means
             "not clickable" - matching how a disabled Button already
             behaves everywhere else. Pulled from the lib HTML palette
             editor's canonical definition. -->
        <Style x:Key="RoundPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="{DynamicResource WidthButtonClose}"/>
            <Setter Property="Height"          Value="{DynamicResource HeightButtonClose}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButtonClose}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round open/close toggle - accent green while unchecked (currently
             collapsed, clicking will expand it), secondary grey while
             checked (currently expanded, clicking will collapse it). Pulled
             from the lib HTML palette editor's canonical definition. -->
        <Style x:Key="PrimarySecondaryToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background"      Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="{DynamicResource WidthButtonClose}"/>
            <Setter Property="Height"          Value="{DynamicResource HeightButtonClose}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButtonClose}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextInput}"/>
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ItemBd" Background="Transparent"
                                CornerRadius="{DynamicResource CornerRadiusDropdownItem}" Padding="{DynamicResource PaddingDropdownItem}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="14" Height="14"
                                        BorderBrush="{DynamicResource BrushPrimaryGreen}" BorderThickness="1.5"
                                        CornerRadius="3" Background="{DynamicResource BrushInputBg}"
                                        VerticalAlignment="Center">
                                    <Path x:Name="CheckMark"
                                          Data="M 1 4 L 4 7 L 9 1"
                                          Stroke="{DynamicResource BrushPrimaryGreen}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource BrushDropdownItemHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Canonical Popup-dropdown menu item, matching pyTransmit's
             MenuItemStyle exactly - a plain Button (not a native
             MenuItem/ContextMenu), used inside a hand-built Popup
             (see MenuPopup/BatchPopup below and the per-card batch
             popups built in code). Replaces the earlier
             DarkContextMenuStyle/DarkMenuItemStyle/DarkMenuSeparatorStyle,
             which styled WPF's native ContextMenu chrome - a different,
             harder-to-theme-consistently control from the rest of the
             app's own hand-built dropdowns. -->
        <Style x:Key="MenuItemStyle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Padding"                    Value="{DynamicResource PaddingMenuItem}"/>
            <Setter Property="FontSize"                   Value="{DynamicResource FontSizeMenuItem}"/>
            <Setter Property="HorizontalAlignment"        Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>    <!-- header + toolbar -->
            <RowDefinition Height="Auto"/>  <!-- status card (fixed) -->
            <RowDefinition Height="*"/>     <!-- scrollable file cards -->
            <RowDefinition Height="34"/>    <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ══ HEADER + TOOLBAR ══════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource BrushHeaderBg}"
                CornerRadius="10,10,12,12">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3"
                                  ShadowDepth="2" BlurRadius="6"/>
            </Border.Effect>
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Wordmark -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="py"
                               FontWeight="Bold" FontSize="20"
                               Foreground="{DynamicResource BrushPrimaryGreen}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Table"
                               FontWeight="SemiBold" FontSize="20"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Toolbar — Grid columns, VerticalAlignment=Center on each item -->
                <Grid Grid.Column="2" VerticalAlignment="Center"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            x:Name="AddTablesBtn"
                            Content="+ Add Tables"
                            Style="{StaticResource SmallButtonStyle}"
                            Height="24" Padding="12,0"
                            VerticalAlignment="Center"
                            Click="OnAddTables"/>

                    <Grid Grid.Column="2">
                        <Button x:Name="BatchBtn"
                                Content="Batch ▾"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="24" Padding="12,0"
                                VerticalAlignment="Center"
                                Click="OnBatchActions"/>
                        <Popup x:Name="BatchPopup"
                               PlacementTarget="{Binding ElementName=BatchBtn}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               StaysOpen="True">
                            <Border Background="{DynamicResource BrushCardBg}"
                                    BorderBrush="{DynamicResource BrushBorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource CornerRadiusDropdownPopup}"
                                    MinWidth="180">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.4" ShadowDepth="3" BlurRadius="8"/>
                                </Border.Effect>
                                <StackPanel x:Name="BatchPopupPanel"/>
                            </Border>
                        </Popup>
                    </Grid>

                    <Border Grid.Column="6"
                            Width="1" Height="18"
                            Background="{StaticResource LocalBrushMenuBorder}"
                            VerticalAlignment="Center"/>

                    <Grid Grid.Column="8">
                        <ToggleButton x:Name="SourceFilterToggle"
                                      Height="{DynamicResource HeightCombobox}" Width="110"
                                      Background="{DynamicResource BrushInputBg}"
                                      Cursor="Hand"
                                      PreviewMouseLeftButtonDown="OnFilterTogglePreviewDown">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{DynamicResource BrushBorderDefault}"
                                            BorderThickness="{DynamicResource BorderThicknessInput}"
                                            CornerRadius="{DynamicResource CornerRadiusCombobox}">
                                        <Grid>
                                            <TextBlock Text="Source" Foreground="{DynamicResource BrushTextInput}" FontSize="{DynamicResource FontSizeCombobox}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <Path Fill="{DynamicResource BrushTextInput}" IsHitTestVisible="False"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,8,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushInputBgHover}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushInputBgPressed}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup PlacementTarget="{Binding ElementName=SourceFilterToggle}"
                               Placement="Bottom"
                               IsOpen="{Binding ElementName=SourceFilterToggle, Path=IsChecked}"
                               AllowsTransparency="True"
                               StaysOpen="False">
                            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorderDefault}" BorderThickness="1"
                                    CornerRadius="{DynamicResource CornerRadiusDropdownPopup}" Padding="10,8">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="2" BlurRadius="6"/>
                                </Border.Effect>
                                <StackPanel>
                                    <CheckBox x:Name="SrcFilterExcel" Content="Excel" IsChecked="True"
                                              Style="{StaticResource FilterCheckBoxStyle}" Margin="0,1"
                                              Click="OnSourceFilterChanged"/>
                                    <CheckBox x:Name="SrcFilterWord" Content="Word" IsChecked="True"
                                              Style="{StaticResource FilterCheckBoxStyle}" Margin="0,1"
                                              Click="OnSourceFilterChanged"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Grid Grid.Column="10">
                        <ToggleButton x:Name="TypeFilterToggle"
                                      Height="{DynamicResource HeightCombobox}" Width="100"
                                      Background="{DynamicResource BrushInputBg}"
                                      Cursor="Hand"
                                      PreviewMouseLeftButtonDown="OnFilterTogglePreviewDown">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{DynamicResource BrushBorderDefault}"
                                            BorderThickness="{DynamicResource BorderThicknessInput}"
                                            CornerRadius="{DynamicResource CornerRadiusCombobox}">
                                        <Grid>
                                            <TextBlock Text="Type" Foreground="{DynamicResource BrushTextInput}" FontSize="{DynamicResource FontSizeCombobox}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <Path Fill="{DynamicResource BrushTextInput}" IsHitTestVisible="False"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,8,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushInputBgHover}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushInputBgPressed}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup PlacementTarget="{Binding ElementName=TypeFilterToggle}"
                               Placement="Bottom"
                               IsOpen="{Binding ElementName=TypeFilterToggle, Path=IsChecked}"
                               AllowsTransparency="True"
                               StaysOpen="False">
                            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorderDefault}" BorderThickness="1"
                                    CornerRadius="{DynamicResource CornerRadiusDropdownPopup}" Padding="10,8">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="2" BlurRadius="6"/>
                                </Border.Effect>
                                <StackPanel>
                                    <CheckBox x:Name="TypeFilterSchedule" Content="Schedule View" IsChecked="True"
                                              Style="{StaticResource FilterCheckBoxStyle}" Margin="0,1"
                                              Click="OnTypeFilterChanged"/>
                                    <CheckBox x:Name="TypeFilterLegend" Content="Legend View" IsChecked="True"
                                              Style="{StaticResource FilterCheckBoxStyle}" Margin="0,1"
                                              Click="OnTypeFilterChanged"/>
                                    <CheckBox x:Name="TypeFilterDrafting" Content="Drafting View" IsChecked="True"
                                              Style="{StaticResource FilterCheckBoxStyle}" Margin="0,1"
                                              Click="OnTypeFilterChanged"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                </Grid>

                <!-- Apply + hamburger + close -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="ApplyBtn"
                            Content="Apply"
                            Style="{StaticResource SmallButtonStyle}"
                            Width="80" Height="24"
                            Margin="0,0,10,0"
                            Click="OnApply"/>
                    <Grid>
                        <ToggleButton x:Name="MenuBtn"
                                      Content="☰"
                                      Style="{StaticResource IconToggleButtonStyle}"
                                      Click="OnMenuOpen"/>
                        <Popup x:Name="MenuPopup"
                               PlacementTarget="{Binding ElementName=MenuBtn}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               StaysOpen="True">
                            <Border Background="{DynamicResource BrushCardBg}"
                                    BorderBrush="{DynamicResource BrushBorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource CornerRadiusDropdownPopup}"
                                    MinWidth="200">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.4" ShadowDepth="3" BlurRadius="8"/>
                                </Border.Effect>
                                <StackPanel x:Name="MenuPopupPanel"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button x:Name="CloseBtn"
                            Content="&#10005;"
                            Style="{StaticResource CloseButtonStyle}"
                            Margin="6,0,0,0"
                            ToolTip="Close"
                            Click="OnCloseWindow"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Column headers now inside each card — row collapsed -->

        <!-- ══ STATUS CARD (always visible) ════════════════════════ -->
        <Border x:Name="StatusCardHost"
                Grid.Row="1"
                Margin="12,8,12,4">
            <!-- populated by _build_status_card() in code-behind -->
        </Border>

        <!-- ══ SCROLLABLE CONTENT ════════════════════════════════════ -->
        <ScrollViewer x:Name="RowsScroll"
                      Grid.Row="2"
                      Style="{StaticResource MacScrollViewer}"
                      Background="{DynamicResource BrushWindowBg}"
                      Padding="12,8,12,8">
            <StackPanel x:Name="CardsPanel"
                        Background="Transparent"/>
        </ScrollViewer>

        <!-- Drop zone (shown when no files loaded) -->
        <Border x:Name="DropZonePanel"
                Grid.Row="2"
                Background="{DynamicResource BrushWindowBg}"
                AllowDrop="True"
                Drop="OnDrop"
                DragOver="OnDragOver">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Width="52" Height="52"
                        Background="{DynamicResource BrushHeaderBg}"
                        CornerRadius="10"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,14">
                    <TextBlock Text="↑" FontSize="26"
                               Foreground="{DynamicResource BrushPrimaryGreen}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Link documents to Revit"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" MaxWidth="360"
                           TextAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource BrushTextPrimary}" Opacity="0.55"
                           Margin="0,0,0,20">
                    Browse or drag and drop an Excel or Word file.
                </TextBlock>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Border BorderBrush="{DynamicResource BrushPrimaryGreen}" BorderThickness="1"
                            CornerRadius="10" Padding="10,3" Margin="0,0,6,0">
                        <TextBlock Text=".xlsx" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}" Opacity="0.6"/>
                    </Border>
                    <Border BorderBrush="{DynamicResource BrushPrimaryGreen}" BorderThickness="1"
                            CornerRadius="10" Padding="10,3" Margin="0,0,6,0">
                        <TextBlock Text=".xls" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}" Opacity="0.6"/>
                    </Border>
                    <Border BorderBrush="{DynamicResource BrushPrimaryGreen}" BorderThickness="1"
                            CornerRadius="10" Padding="10,3" Margin="0,0,6,0">
                        <TextBlock Text=".docx" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}" Opacity="0.6"/>
                    </Border>
                    <Border BorderBrush="{DynamicResource BrushPrimaryGreen}" BorderThickness="1"
                            CornerRadius="10" Padding="10,3" Margin="0,0,6,0">
                        <TextBlock Text=".ods" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}" Opacity="0.6"/>
                    </Border>
                    <Border BorderBrush="{DynamicResource BrushPrimaryGreen}" BorderThickness="1"
                            CornerRadius="10" Padding="10,3">
                        <TextBlock Text=".odt" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}" Opacity="0.6"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══ FOOTER ════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{DynamicResource BrushHeaderBg}"
                BorderBrush="{StaticResource LocalBrushMenuBorder}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <TextBlock x:Name="FooterCounts"
                       Text="No files loaded"
                       FontSize="10" Foreground="{DynamicResource BrushTextPrimary}"
                       Opacity="0.45"
                       VerticalAlignment="Center"/>
        </Border>

    </Grid>

        <!-- Decorative resize-grip dots, bottom-right corner. Purely visual;
             actual resizing is handled by WindowChrome's ResizeBorderThickness. -->
        <Canvas Width="16" Height="16"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,8,6"
                IsHitTestVisible="False">
            <Rectangle Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" Fill="{DynamicResource BrushTextPrimary}" Opacity="0.35"/>
            <Rectangle Canvas.Left="10" Canvas.Top="5"  Width="3" Height="3" Fill="{DynamicResource BrushTextPrimary}" Opacity="0.35"/>
            <Rectangle Canvas.Left="5"  Canvas.Top="10" Width="3" Height="3" Fill="{DynamicResource BrushTextPrimary}" Opacity="0.35"/>
            <Rectangle Canvas.Left="10" Canvas.Top="0"  Width="3" Height="3" Fill="{DynamicResource BrushTextPrimary}" Opacity="0.35"/>
            <Rectangle Canvas.Left="5"  Canvas.Top="5"  Width="3" Height="3" Fill="{DynamicResource BrushTextPrimary}" Opacity="0.35"/>
            <Rectangle Canvas.Left="0"  Canvas.Top="10" Width="3" Height="3" Fill="{DynamicResource BrushTextPrimary}" Opacity="0.35"/>
        </Canvas>
    </Grid>
</Window>
