<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="pyTable"
        Width="960" Height="720"
        MinWidth="700" MinHeight="400" MaxHeight="900"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="#3B4553"
        TextElement.FontFamily="Segoe UI"
        TextElement.Foreground="#F4FAFF"
        FontSize="12">

    <Window.Resources/>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>    <!-- header + toolbar -->
            <RowDefinition Height="Auto"/>  <!-- status card (fixed) -->
            <RowDefinition Height="*"/>     <!-- scrollable file cards -->
            <RowDefinition Height="34"/>    <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ══ HEADER + TOOLBAR ══════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#232933"
                CornerRadius="0,0,12,12">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3"
                                  ShadowDepth="2" BlurRadius="6"/>
            </Border.Effect>
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Wordmark -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="py"
                               FontWeight="Bold" FontSize="32"
                               Foreground="#208A3C"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Table"
                               FontWeight="SemiBold" FontSize="32"
                               Foreground="#F4FAFF"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Toolbar — Grid columns, VerticalAlignment=Center on each item -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="+ Add File"
                            Style="{StaticResource SmallButtonStyle}"
                            Height="24" Padding="12,0"
                            VerticalAlignment="Center"
                            Click="OnBrowse"/>

                    <Button Grid.Column="2"
                            Content="Batch ▾"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="24" Padding="12,0"
                            VerticalAlignment="Center"
                            Click="OnBatchActions"/>

                    <Button Grid.Column="4"
                            Content="⟳"
                            Style="{StaticResource SmallButtonStyle}"
                            Width="24" Height="24" Padding="0"
                            FontSize="14"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            VerticalAlignment="Center"
                            Click="OnRefresh"/>

                    <Border Grid.Column="6"
                            Width="1" Height="18"
                            Background="#404553"
                            VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="8"
                               Text="File:"
                               FontSize="11" Foreground="#F4FAFF"
                               Opacity="0.6"
                               VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="10"
                              x:Name="FileCombo"
                              Style="{StaticResource ModernComboBoxStyle}"
                              MinWidth="180" Height="24" Margin="0"
                              VerticalAlignment="Center"
                              SelectionChanged="OnFileComboChanged"/>

                    <Button Grid.Column="12"
                            Content="+ Add Row"
                            Style="{StaticResource SmallButtonStyle}"
                            Height="24" Padding="12,0"
                            VerticalAlignment="Center"
                            Click="OnAddRow"/>

                </Grid>

                <!-- Apply + hamburger -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="ApplyBtn"
                            Content="Apply"
                            Style="{StaticResource SmallButtonStyle}"
                            Width="80" Height="24"
                            Margin="0,0,10,0"
                            Click="OnApply"/>
                    <ToggleButton x:Name="MenuBtn"
                                  Content="☰"
                                  Style="{StaticResource OptionsToggleButtonStyle}"
                                  Click="OnMenuOpen"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Column headers now inside each card — row collapsed -->

        <!-- ══ STATUS CARD (always visible) ════════════════════════ -->
        <Border x:Name="StatusCardHost"
                Grid.Row="1"
                Margin="12,8,12,4">
            <!-- populated by _build_status_card() in code-behind -->
        </Border>

        <!-- ══ SCROLLABLE CONTENT ════════════════════════════════════ -->
        <ScrollViewer x:Name="RowsScroll"
                      Grid.Row="2"
                      Style="{StaticResource MacScrollViewer}"
                      Background="#3B4553"
                      Padding="12,8,12,8">
            <StackPanel x:Name="CardsPanel"
                        Background="Transparent"/>
        </ScrollViewer>

        <!-- Drop zone (shown when no files loaded) -->
        <Border x:Name="DropZonePanel"
                Grid.Row="2"
                Background="#3B4553"
                AllowDrop="True"
                Drop="OnDrop"
                DragOver="OnDragOver">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Width="52" Height="52"
                        Background="#232933"
                        CornerRadius="10"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,14">
                    <TextBlock Text="↑" FontSize="26"
                               Foreground="#208A3C"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Link documents to Revit"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#F4FAFF"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" MaxWidth="360"
                           TextAlignment="Center" FontSize="11"
                           Foreground="#F4FAFF" Opacity="0.55"
                           Margin="0,0,0,20">
                    Browse or drag and drop an Excel or Word file.
                </TextBlock>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Border BorderBrush="#208A3C" BorderThickness="1"
                            CornerRadius="10" Padding="10,3" Margin="0,0,6,0">
                        <TextBlock Text=".xlsx" FontSize="10" Foreground="#F4FAFF" Opacity="0.6"/>
                    </Border>
                    <Border BorderBrush="#208A3C" BorderThickness="1"
                            CornerRadius="10" Padding="10,3" Margin="0,0,6,0">
                        <TextBlock Text=".xls" FontSize="10" Foreground="#F4FAFF" Opacity="0.6"/>
                    </Border>
                    <Border BorderBrush="#208A3C" BorderThickness="1"
                            CornerRadius="10" Padding="10,3" Margin="0,0,6,0">
                        <TextBlock Text=".docx" FontSize="10" Foreground="#F4FAFF" Opacity="0.6"/>
                    </Border>
                    <Border BorderBrush="#208A3C" BorderThickness="1"
                            CornerRadius="10" Padding="10,3" Margin="0,0,6,0">
                        <TextBlock Text=".ods" FontSize="10" Foreground="#F4FAFF" Opacity="0.6"/>
                    </Border>
                    <Border BorderBrush="#208A3C" BorderThickness="1"
                            CornerRadius="10" Padding="10,3">
                        <TextBlock Text=".odt" FontSize="10" Foreground="#F4FAFF" Opacity="0.6"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══ FOOTER ════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="#232933"
                BorderBrush="#404553"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <TextBlock x:Name="FooterCounts"
                       Text="No files loaded"
                       FontSize="10" Foreground="#F4FAFF"
                       Opacity="0.45"
                       VerticalAlignment="Center"/>
        </Border>

    </Grid>
</Window>
