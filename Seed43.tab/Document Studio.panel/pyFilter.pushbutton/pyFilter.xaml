<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filter Manager"
        Width="1200" Height="700"
        MinWidth="1000" MinHeight="500"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="#3B4553"
        TextElement.FontFamily="Segoe UI"
        TextElement.Foreground="#F4FAFF"
        FontSize="12">

    <Window.Resources>
        <!-- ═════════ SEED43 STYLES (embedded) ═════════ -->

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"   Value="#2B3340"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding"      Value="16"/>
            <Setter Property="Margin"       Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#208A3C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4FAFF"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
            <Setter Property="Opacity"    Value="0.9"/>
        </Style>

        <Style x:Key="OptionsToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#F4FAFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="18"/>
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#208A3C"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#208A3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A6B2F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#F4FAFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Width"           Value="30"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Content"         Value="&#x2716;"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF5555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CC4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary green button -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#208A3C"/>
            <Setter Property="Foreground"      Value="#F4FAFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="24,8"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2B933F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A6E2E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neutral grey button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#404553"/>
            <Setter Property="Foreground"      Value="#F4FAFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4E5566"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333B48"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#555555"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small green ribbon button -->
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#208A3C"/>
            <Setter Property="Foreground"      Value="#F4FAFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2B933F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A6E2E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small neutral ribbon button (grey) -->
        <Style x:Key="SmallSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
            <Setter Property="Background" Value="#404553"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4E5566"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333B48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red destructive small button -->
        <Style x:Key="SmallDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
            <Setter Property="Background" Value="#C53030"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D63838"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A02424"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mode toggle button (looks like a tab) -->
        <Style x:Key="ModeTabButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#404553"/>
            <Setter Property="Foreground"      Value="#F4FAFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4E5566"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background"               Value="#F4FAFF"/>
            <Setter Property="Foreground"               Value="#2B3340"/>
            <Setter Property="BorderBrush"              Value="#208A3C"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="8,4"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Height"                   Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2B933F"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"     Value="#2B933F"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar list item button -->
        <Style x:Key="SideBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#F4FAFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A4150"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SideBtnActive" TargetType="Button" BasedOn="{StaticResource SideBtn}">
            <Setter Property="Background" Value="#208A3C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuItemButtonStyle" TargetType="Button">
            <Setter Property="Background"             Value="Transparent"/>
            <Setter Property="Foreground"             Value="#F4FAFF"/>
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="Padding"                Value="12,8"/>
            <Setter Property="FontSize"               Value="12"/>
            <Setter Property="HorizontalAlignment"    Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                 Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#208A3C"/>
                                <Setter Property="Foreground" Value="#F4FAFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A6B2F"/>
                                <Setter Property="Foreground" Value="#F4FAFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hamburger icon button (kept for any fallback use) -->
        <Style x:Key="HamburgerButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#F4FAFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="FontSize"        Value="18"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A4150"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hamburger menu item (icon + label, pyTransmit style) -->
        <Style x:Key="MenuItemStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#F4FAFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,10"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#208A3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A6E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════ MAC-STYLE SCROLLBAR (Seed43Styles spec) ═════════ -->

        <Style x:Key="MacScrollBarThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#208A3C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumb"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Margin="2,2,2,2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="#27AE60"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="#2ECC71"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacScrollBar" TargetType="ScrollBar">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Width"       Value="8"/>
            <Setter Property="MinWidth"    Value="8"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="GridRoot" Width="8">
                            <Track x:Name="PART_Track"
                                   Orientation="Vertical"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MacScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GridRoot" Property="Width" Value="10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Orientation="Vertical"
                                       Style="{StaticResource MacScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>      <!-- header + toolbar -->
            <RowDefinition Height="*"/>       <!-- workspace -->
            <RowDefinition Height="28"/>      <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ══ HEADER + TOOLBAR ════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#232933"
                CornerRadius="0,0,12,12">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3"
                                  ShadowDepth="2" BlurRadius="6"/>
            </Border.Effect>
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Wordmark + contextual subtitle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="py" FontWeight="Bold" FontSize="28"
                               Foreground="#208A3C" VerticalAlignment="Center"/>
                    <TextBlock Text="Filter" FontWeight="SemiBold" FontSize="28"
                               Foreground="#F4FAFF" Margin="3,0,0,0"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="ExportHeaderLbl"
                               Text="  |  Export" FontWeight="SemiBold" FontSize="20"
                               Foreground="#F4FAFF" Opacity="0.75"
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock x:Name="ImportHeaderLbl"
                               Text="  |  Import" FontWeight="SemiBold" FontSize="20"
                               Foreground="#F4FAFF" Opacity="0.75"
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Toolbar buttons -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- Mode tabs -->
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="14"/>
                        <!-- Contextual actions -->
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnModeTemplates"  Grid.Column="0"
                            Content="Templates"  Style="{StaticResource ModeTabButtonStyle}"/>
                    <Button x:Name="BtnModeViews"      Grid.Column="2"
                            Content="Views"      Style="{StaticResource ModeTabButtonStyle}"/>
                    <Button x:Name="BtnModeVTemplates" Grid.Column="4"
                            Content="View Templates" Style="{StaticResource ModeTabButtonStyle}"/>

                    <Border Grid.Column="6" Width="1" Height="20"
                            Background="#404553" VerticalAlignment="Center"/>

                    <!-- Templates-mode actions -->
                    <Button x:Name="BtnAddFilter"      Grid.Column="8"
                            Content="+ Add Filter"     Style="{StaticResource SmallButtonStyle}"/>
                    <Button x:Name="BtnDeleteFilter"   Grid.Column="10"
                            Content="− Delete Filter"  Style="{StaticResource SmallDangerButtonStyle}"/>

                    <!-- Assign-mode actions (same slots, swapped visibility) -->
                    <Button x:Name="BtnPushFilters"    Grid.Column="8"
                            Content="Push Filters"     Style="{StaticResource SmallButtonStyle}"
                            Visibility="Collapsed"/>
                    <Button x:Name="BtnPullFilters"    Grid.Column="10"
                            Content="Pull Filters"     Style="{StaticResource SmallSecondaryButtonStyle}"
                            Visibility="Collapsed"/>
                    <Button x:Name="BtnDeleteFilterAssign" Grid.Column="12"
                            Content="− Delete Filter"  Style="{StaticResource SmallDangerButtonStyle}"
                            Visibility="Collapsed"/>
                </Grid>

                <!-- Right: normal mode (search + Apply + hamburger) -->
                <StackPanel x:Name="HeaderNormalBtns" Grid.Column="3"
                            Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F4FAFF" CornerRadius="4" Padding="8,0"
                            Height="26" VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x1F50D;" Foreground="#9CA3AF" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtSearch" Width="160" Height="22"
                                     Background="Transparent" Foreground="#2B3340"
                                     BorderThickness="0" VerticalContentAlignment="Center"
                                     FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnApply" Content="Apply"
                            Style="{StaticResource SmallButtonStyle}"
                            Padding="20,0" Margin="0,0,8,0"/>
                    <Grid>
                        <ToggleButton x:Name="options_btn"
                                      Content="&#x2630;"
                                      Style="{StaticResource OptionsToggleButtonStyle}"/>
                        <Popup x:Name="PyFilterMenuPopup"
                               PlacementTarget="{Binding ElementName=options_btn}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               IsOpen="{Binding ElementName=options_btn, Path=IsChecked}">
                            <Border Background="#2B3340"
                                    BorderBrush="#208A3C" BorderThickness="1"
                                    CornerRadius="6" MinWidth="200">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.4"
                                                      ShadowDepth="3" BlurRadius="8"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Button x:Name="MenuExport"
                                            Content="&#x1F4E4;  Export Templates"
                                            Style="{StaticResource MenuItemButtonStyle}"
                                            Foreground="#F4FAFF"/>
                                    <Button x:Name="MenuImport"
                                            Content="&#x1F4E5;  Import Templates"
                                            Style="{StaticResource MenuItemButtonStyle}"
                                            Foreground="#F4FAFF"/>
                                    <Rectangle Fill="#404553" Height="1" Margin="0,2"/>
                                    <Button x:Name="MenuResetColumns"
                                            Content="&#x21BA;  Reset Column Widths"
                                            Style="{StaticResource MenuItemButtonStyle}"
                                            Foreground="#F4FAFF"/>
                                    <Rectangle Fill="#404553" Height="1" Margin="0,2"/>
                                    <Button x:Name="MenuHelp"
                                            Content="&#x2753;  Help"
                                            Style="{StaticResource MenuItemButtonStyle}"
                                            Foreground="#F4FAFF"/>
                                    <Button x:Name="MenuAbout"
                                            Content="&#x2139;  About pyFilter"
                                            Style="{StaticResource MenuItemButtonStyle}"
                                            Foreground="#F4FAFF"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- Right: Export mode -->
                <StackPanel x:Name="ExportHeaderBtns" Grid.Column="3"
                            Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Button x:Name="BtnExportNow" Content="Export Now"
                            Style="{StaticResource SmallButtonStyle}"
                            Width="90" Margin="0,0,10,0"/>
                    <Button x:Name="BtnExportClose"
                            Style="{StaticResource CloseButtonStyle}"/>
                </StackPanel>

                <!-- Right: Import mode -->
                <StackPanel x:Name="ImportHeaderBtns" Grid.Column="3"
                            Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Button x:Name="BtnImportNow" Content="Import Now"
                            Style="{StaticResource SmallButtonStyle}"
                            Width="90" Margin="0,0,10,0"/>
                    <Button x:Name="BtnImportClose"
                            Style="{StaticResource CloseButtonStyle}"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ══ WORKSPACE: sidebar card + main card ═════════════════════ -->
        <Grid x:Name="main_content" Grid.Row="1" Margin="12,12,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar card -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtSidebarTitle" Grid.Column="0"
                                   Text="TEMPLATES" Style="{StaticResource SectionLabelStyle}"
                                   Margin="0" VerticalAlignment="Center"/>
                        <Button x:Name="BtnNewTemplate" Grid.Column="1"
                                Content="+ New" Style="{StaticResource SmallButtonStyle}"
                                Padding="10,0" Height="22" FontSize="10"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  Style="{StaticResource MacScrollViewer}">
                        <StackPanel x:Name="TemplateListPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Main card -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Target label / template name -->
                        <RowDefinition Height="Auto"/>   <!-- Group header -->
                        <RowDefinition Height="Auto"/>   <!-- Column header -->
                        <RowDefinition Height="*"/>      <!-- Filter rows -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="TxtTargetLabel"
                                   Text=""
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#F4FAFF"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <Grid x:Name="GroupHeaderGrid" Grid.Row="1" Height="22"
                          Background="#232933"/>
                    <Grid x:Name="HeaderGrid"      Grid.Row="2" Height="28"
                          Background="#1F242E"/>

                    <ScrollViewer Grid.Row="3"
                                  Style="{StaticResource MacScrollViewer}">
                        <StackPanel x:Name="FilterRowsPanel"/>
                    </ScrollViewer>

                    <Border x:Name="EmptyState" Grid.Row="3"
                            Background="Transparent" Visibility="Collapsed">
                        <TextBlock x:Name="TxtEmpty" Text="No filters."
                                   Foreground="#9CA3AF" FontSize="13"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ STATUS BAR ════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#232933">
            <TextBlock x:Name="StatusText" Text="Ready"
                       Foreground="#9CA3AF" FontSize="11"
                       VerticalAlignment="Center" Margin="16,0"/>
        </Border>

        <!-- ══ OPTIONS POPUP (per-row override editor) ═══════════════ -->
        <Popup x:Name="OptionsPopup" Placement="MousePoint"
               StaysOpen="False" AllowsTransparency="True">
            <Border Background="#2B3340" CornerRadius="8" Padding="12"
                    BorderBrush="#208A3C" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="8"
                                      ShadowDepth="3" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel x:Name="OptionsPanel" MinWidth="320"/>
            </Border>
        </Popup>

        <!-- ══ ROW CONTEXT MENU (template ⋮) ═════════════════════════ -->
        <Popup x:Name="RowMenuPopup" Placement="MousePoint"
               StaysOpen="False" AllowsTransparency="True">
            <Border Background="#2B3340" CornerRadius="6" Padding="4"
                    BorderBrush="#208A3C" BorderThickness="1"
                    MinWidth="140">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="8"
                                      ShadowDepth="3" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel MinWidth="140">
                    <Button x:Name="RowMenuRename" Content="Rename"
                            Style="{StaticResource SideBtn}"/>
                    <Button x:Name="RowMenuDelete" Content="Delete"
                            Style="{StaticResource SideBtn}" Foreground="#F4FAFF"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ══ EXPORT PANEL (inline, pyTransmit-style) ═══════════════ -->
        <Grid x:Name="ExportPanel"
              Background="#3B4553"
              Grid.Row="1"
              Visibility="Collapsed"
              Panel.ZIndex="52">
            <ScrollViewer Style="{StaticResource MacScrollViewer}"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,12,24,24">

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Export Templates"
                                       Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="Each selected template is saved as its own .json file in the chosen folder."
                                       Foreground="#F4FAFF" FontSize="11" Opacity="0.7"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <CheckBox x:Name="ExportAutoUpdate"
                                      Content="Auto update on save"
                                      Foreground="#F4FAFF" FontSize="12"
                                      Margin="0,0,0,4"/>
                            <TextBlock Text="When enabled, saving a template automatically copies it to the export folder."
                                       Foreground="#F4FAFF" FontSize="11" Opacity="0.6"
                                       TextWrapping="Wrap" Margin="20,0,0,16"/>
                            <TextBlock Text="Export Folder" Style="{StaticResource FieldLabelStyle}"/>
                            <DockPanel>
                                <Button x:Name="BtnExportBrowse"
                                        Content="Browse"
                                        Style="{StaticResource SmallButtonStyle}"
                                        DockPanel.Dock="Right"
                                        Width="80" Margin="8,0,0,0"/>
                                <TextBox x:Name="TxtExportPath"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Select templates to export"
                                       Style="{StaticResource SectionLabelStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="BtnExportAll"  Content="All"
                                        Style="{StaticResource SmallButtonStyle}"
                                        Padding="14,4" Margin="0,0,8,0"/>
                                <Button x:Name="BtnExportNone" Content="None"
                                        Style="{StaticResource SmallSecondaryButtonStyle}"
                                        Padding="14,4"/>
                            </StackPanel>
                            <Border Background="#1E2530" CornerRadius="6" Padding="8"
                                    Height="200">
                                <ScrollViewer Style="{StaticResource MacScrollViewer}">
                                    <StackPanel x:Name="ExportTemplateList"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="#1E2730" CornerRadius="6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#208A3C" CornerRadius="3,0,0,3"/>
                            <TextBlock Grid.Column="1"
                                       Text="Settings are saved automatically when you close this panel."
                                       Foreground="#7EC8A0" FontSize="10" Opacity="0.9"
                                       TextWrapping="Wrap" Margin="10,8,8,8"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══ IMPORT PANEL (inline, pyTransmit-style) ═══════════════ -->
        <Grid x:Name="ImportPanel"
              Background="#3B4553"
              Grid.Row="1"
              Visibility="Collapsed"
              Panel.ZIndex="52">
            <ScrollViewer Style="{StaticResource MacScrollViewer}"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,12,24,24">

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Import Templates"
                                       Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="Browse to a folder containing pyFilter template .json files."
                                       Foreground="#F4FAFF" FontSize="11" Opacity="0.7"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <CheckBox x:Name="ImportAutoUpdate"
                                      Content="Auto update on startup"
                                      Foreground="#F4FAFF" FontSize="12"
                                      Margin="0,0,0,4"/>
                            <TextBlock Text="When enabled, templates are automatically imported from this folder each time pyFilter opens."
                                       Foreground="#F4FAFF" FontSize="11" Opacity="0.6"
                                       TextWrapping="Wrap" Margin="20,0,0,16"/>
                            <TextBlock Text="Import Folder" Style="{StaticResource FieldLabelStyle}"/>
                            <DockPanel>
                                <Button x:Name="BtnImportBrowse"
                                        Content="Browse"
                                        Style="{StaticResource SmallButtonStyle}"
                                        DockPanel.Dock="Right"
                                        Width="80" Margin="8,0,0,0"/>
                                <TextBox x:Name="TxtImportPath"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Select templates to import"
                                       Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="On name conflict:" Foreground="#9CA3AF"
                                       FontSize="11" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="RdoOverwrite" Content="Overwrite"
                                             Foreground="#F4FAFF" IsChecked="True"
                                             GroupName="import_conflict" Margin="0,0,16,0"/>
                                <RadioButton x:Name="RdoSkip" Content="Skip"
                                             Foreground="#F4FAFF"
                                             GroupName="import_conflict" Margin="0,0,16,0"/>
                                <RadioButton x:Name="RdoRename" Content="Rename"
                                             Foreground="#F4FAFF"
                                             GroupName="import_conflict"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="BtnImportAll"  Content="All"
                                        Style="{StaticResource SmallButtonStyle}"
                                        Padding="14,4" Margin="0,0,8,0"/>
                                <Button x:Name="BtnImportNone" Content="None"
                                        Style="{StaticResource SmallSecondaryButtonStyle}"
                                        Padding="14,4"/>
                            </StackPanel>
                            <Border Background="#1E2530" CornerRadius="6" Padding="8"
                                    Height="200">
                                <ScrollViewer Style="{StaticResource MacScrollViewer}">
                                    <StackPanel x:Name="ImportTemplateList"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="#1E2730" CornerRadius="6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#208A3C" CornerRadius="3,0,0,3"/>
                            <TextBlock Grid.Column="1"
                                       Text="Settings are saved automatically when you close this panel."
                                       Foreground="#7EC8A0" FontSize="10" Opacity="0.9"
                                       TextWrapping="Wrap" Margin="10,8,8,8"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</Window>
