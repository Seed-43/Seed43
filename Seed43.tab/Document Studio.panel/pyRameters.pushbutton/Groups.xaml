<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Width="480"
        Height="520"
        Title="Groups"
        Background="{DynamicResource BrushWindowBg}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="10"
                            GlassFrameThickness="0" ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Every Brush*/Size*/CornerRadius*/Padding* key this window uses is
             injected at open by seed43_theme.py from lib/Snippets/
             seed43_palette.json - see the apply_seed43_palette() and
             apply_seed43_dimensions() calls in script.py. There are
             deliberately no local copies of those keys, as in Batch Upgrade,
             the layout this window follows: a duplicate set only went stale
             and made a failure render the wrong values instead of an obvious
             problem. -->


        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize"   Value="16"/>
            <Setter Property="Margin"     Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontSize"     Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextInput}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorderDefault}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessInput}"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeInput}"/>
            <Setter Property="Padding"         Value="{DynamicResource PaddingInput}"/>
            <Setter Property="Height"          Value="{DynamicResource HeightInput}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly"      Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusInput}">
                            <!-- No Padding/Margin="{TemplateBinding Padding}" here.
                                 WPF already applies TextBox.Padding to the element
                                 named PART_ContentHost, so setting it again doubles
                                 it - text clipped top and bottom. -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PathBox is read-only by design; these fields are typed into. -->
        <Style x:Key="TextField" TargetType="TextBox" BasedOn="{StaticResource PathBox}">
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="CaretBrush" Value="{DynamicResource BrushTextInput}"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeButton}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="{DynamicResource PaddingButtonPrimary}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="MinWidth"        Value="130"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButton}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="MinWidth"   Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButton}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ListRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeInput}"/>
            <Setter Property="Padding"    Value="10,6"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushDropdownItemHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushSelectedRowBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BrushCardBg}"
            CornerRadius="{DynamicResource CornerRadiusCard}"
            Padding="{DynamicResource PaddingCard}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Title}"
                       Text="Parameter groups"/>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                        Margin="0,0,0,10">
                <TextBox x:Name="new_tb" Width="250"
                         Style="{StaticResource TextField}" Margin="0,0,8,0"
                         ToolTip="Name for a new group"/>
                <Button x:Name="add_btn" Content="Create" Width="100"
                        Style="{StaticResource PrimaryBtn}" Click="add_clicked"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="rename_btn" Content="Rename" Width="96"
                        Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"
                        Click="rename_clicked"/>
                <Button x:Name="del_btn" Content="Delete" Width="96"
                        Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"
                        ToolTip="A group still in use has to have its parameters moved somewhere first"
                        Click="del_clicked"/>
                <Button x:Name="ok_btn" Content="Done" Width="100"
                        Style="{StaticResource PrimaryBtn}" Click="ok_clicked"/>
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom" x:Name="hint_tb"
                       Style="{StaticResource Hint}" Margin="0,10,0,0"/>

            <Border Background="{DynamicResource BrushInputBg}"
                    CornerRadius="{DynamicResource CornerRadiusInput}"
                    Padding="4">
                <ListBox x:Name="group_list"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource BrushTextPrimary}"
                         ItemContainerStyle="{StaticResource ListRow}"
                         SelectionChanged="selection_changed"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Border>
        </DockPanel>
    </Border>
</Window>
