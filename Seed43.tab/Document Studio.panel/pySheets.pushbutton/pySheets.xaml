                        </StackPanel>

                        <StackPanel x:Name="xls_settings_panel" Visibility="Collapsed" MaxWidth="420" HorizontalAlignment="Left">
                            <Border Background="{DynamicResource BrushCardBg}"
                                    BorderBrush="{DynamicResource BrushBorderMuted}" BorderThickness="1"
                                    CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="TABLE OPTIONS"
                                               Style="{StaticResource SectionLabel}"
                                               FontSize="13" FontWeight="Bold" Opacity="0.9" Margin="0,0,0,8"/>
                                    <TextBlock Text="File Format" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="xls_type_cb"
                                              Style="{StaticResource DarkComboBox}"
                                              SelectedIndex="0"
                                              SelectionChanged="xls_type_changed"
                                              Margin="0,0,0,12">
                                        <ComboBoxItem Content="XLSX"/>
                                        <ComboBoxItem Content="ODS"/>
                                        <ComboBoxItem Content="CSV"/>
                                    </ComboBox>
                                    <TextBlock Text="Output" Style="{StaticResource FieldLabel}"/>
                                    <!-- Same pair the PDF panel offers. CSV
                                         holds one table by definition, so
                                         xls_type_changed forces Separate and
                                         greys out Single when it is picked. -->
                                    <RadioButton x:Name="xls_single_rb" GroupName="xlsgrp"
                                                 Content="Single file, a tab per schedule"
                                                 IsChecked="True"
                                                 Foreground="{DynamicResource BrushTextPrimary}"
                                                 Margin="0,0,0,6"/>
                                    <RadioButton x:Name="xls_separate_rb" GroupName="xlsgrp"
                                                 Content="Separate file per schedule"
                                                 Foreground="{DynamicResource BrushTextPrimary}"
                                                 Margin="0,0,0,12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ─────────────────────────────────────────────────────────
             TAB: Export
        ───────────────────────────────────────────────────────── -->
        <Grid x:Name="tab_print"
              Grid.Row="2"
              Visibility="Collapsed"
              Margin="16,12,16,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Export Folder card -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Export Folder" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                    <DockPanel Margin="0,0,0,8">
                        <Button Content="Browse…"
                                DockPanel.Dock="Right"
                                Style="{StaticResource SmallSecBtn}"
                                Margin="8,0,0,0"
                                Click="browse_export_folder"/>
                        <Grid DockPanel.Dock="Right" Margin="8,0,0,0">
                            <ToggleButton x:Name="folder_preset_btn"
                                          Content="Preset Location ▾"
                                          Style="{StaticResource SmallSecToggle}"/>
                            <Popup x:Name="folder_preset_popup"
                                   PlacementTarget="{Binding ElementName=folder_preset_btn}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   IsOpen="{Binding ElementName=folder_preset_btn, Path=IsChecked}">
                                <Border Background="{DynamicResource BrushCardBg}"
                                        BorderBrush="{DynamicResource BrushPrimaryGreen}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8"
                                        MinWidth="220">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.25"
                                                          ShadowDepth="2" BlurRadius="8"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <StackPanel x:Name="folder_preset_panel"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <TextBox x:Name="export_folder_tb"
                                 IsReadOnly="True"
                                 Style="{StaticResource ModernTextBox}"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="subfolder_cb"
                                  Content="Organise into subfolders by format"
                                  IsChecked="True"
                                  Margin="0,0,20,0"/>
                        <CheckBox x:Name="open_folder_cb"
                                  Content="Open folder after export"
                                  Margin="0,0,20,0"/>
                        <CheckBox x:Name="auto_overwrite_cb"
                                  Content="Auto replace existing files"
                                  ToolTip="Skip the overwrite prompt and replace existing files automatically"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Schedule card -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Schedule (Revit and the project must stay open)"
                               Style="{StaticResource SectionLabel}"
                               FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                        <!-- Profile first: it decides which card every field
                             after it is editing, so nothing unlocks until one
                             is picked. The Schedule button at the end is what
                             commits the row. -->
                        <TextBlock Text="Profile"
                                   DockPanel.Dock="Left"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   Opacity="0.7" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="sched_profile_cb"
                                  Width="150"
                                  DockPanel.Dock="Left"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemTemplate="{StaticResource ProfileItem}"
                                  SelectionChanged="sched_profile_changed"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  ToolTip="Pick the profile to schedule — its own time is shown, and the Schedule button arms it"/>
                        <TextBlock Text="Time"
                                   DockPanel.Dock="Left"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   Opacity="0.7" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Grid DockPanel.Dock="Left" Margin="0,0,16,0">
                            <ToggleButton x:Name="sched_time_btn"
                                          Content="— : — —"
                                          Width="100" Height="26"
                                          IsEnabled="False"
                                          Style="{StaticResource SmallSecToggle}"
                                          FontFamily="Consolas" FontSize="12"/>
                            <Popup x:Name="sched_time_popup"
                                   PlacementTarget="{Binding ElementName=sched_time_btn}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   Opened="tp_popup_opened"
                                   IsOpen="{Binding ElementName=sched_time_btn, Path=IsChecked}">
                                <Border Background="{DynamicResource BrushCardBg}"
                                        BorderBrush="{DynamicResource BrushPrimaryGreen}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.25"
                                                          ShadowDepth="2" BlurRadius="8"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <Grid ClipToBounds="True">
                                            <Border Background="#33208A3C"
                                                    BorderBrush="{DynamicResource BrushPrimaryGreen}"
                                                    BorderThickness="0,1,0,1"
                                                    Height="30" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center">
                                                <StackPanel x:Name="tp_hours"/>
                                                <TextBlock Text=":" FontSize="15" FontWeight="Bold"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           VerticalAlignment="Center"
                                                           Margin="2,0,2,0"/>
                                                <StackPanel x:Name="tp_minutes" Margin="0,0,10,0"/>
                                                <StackPanel x:Name="tp_ampm"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,8,0,0">
                                            <Button x:Name="tp_ok_btn" Content="OK"
                                                    Width="60"
                                                    Style="{StaticResource SmallSecBtn}"
                                                    Margin="0,0,6,0"
                                                    Click="tp_ok_clicked"/>
                                            <Button x:Name="tp_cancel_btn" Content="Cancel"
                                                    Width="60"
                                                    Style="{StaticResource SmallSecBtn}"
                                                    Click="tp_cancel_clicked"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <ComboBox x:Name="sched_repeat_cb"
                                  Width="100" SelectedIndex="0" IsEnabled="False"
                                  DockPanel.Dock="Left"
                                  Style="{StaticResource DarkComboBox}"
                                  SelectionChanged="sched_field_changed"
                                  VerticalAlignment="Center" Margin="0,0,16,0">
                            <ComboBoxItem Content="Once"/>
                            <ComboBoxItem Content="Repeat"/>
                        </ComboBox>
                        <TextBlock Text="Starting Date"
                                   DockPanel.Dock="Left"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   Opacity="0.7" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker x:Name="sched_date_dp"
                                    Width="130" IsEnabled="False"
                                    DockPanel.Dock="Left"
                                    Style="{StaticResource DarkDatePicker}"
                                    SelectedDateChanged="sched_field_changed"
                                    VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <!-- Label always says what the press will do: Schedule
                             to arm (or re-arm at an edited time), Unschedule
                             once the card is armed and untouched. -->
                        <Button x:Name="sched_action_btn"
                                Content="Schedule"
                                Width="100" Height="26"
                                IsEnabled="False"
                                DockPanel.Dock="Left"
                                Style="{StaticResource SmallPrimBtn}"
                                Click="sched_action_clicked"
                                VerticalAlignment="Center"
                                ToolTip="Arm this profile — it will print at the time set here, with pySheets closed"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <!-- Wide enough for the armed line plus the "press
                             Schedule" hint without trimming either. -->
                        <TextBlock x:Name="sched_status_tb"
                                   Text="Schedule off"
                                   Width="300"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource BrushPrimaryGreen}"
                                   FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel x:Name="sched_days_panel"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center">
                            <CheckBox x:Name="sched_day_mon" Content="Mon" Margin="0,0,8,0" Click="sched_field_changed"/>
                            <CheckBox x:Name="sched_day_tue" Content="Tue" Margin="0,0,8,0" Click="sched_field_changed"/>
                            <CheckBox x:Name="sched_day_wed" Content="Wed" Margin="0,0,8,0" Click="sched_field_changed"/>
                            <CheckBox x:Name="sched_day_thu" Content="Thu" Margin="0,0,8,0" Click="sched_field_changed"/>
                            <CheckBox x:Name="sched_day_fri" Content="Fri" Margin="0,0,8,0" Click="sched_field_changed"/>
                            <CheckBox x:Name="sched_day_sat" Content="Sat" Margin="0,0,8,0" Click="sched_field_changed"/>
                            <CheckBox x:Name="sched_day_sun" Content="Sun" Click="sched_field_changed"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Print Queue card -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Print Queue"
                               Style="{StaticResource SectionLabel}"/>

                    <Border Grid.Row="1" CornerRadius="6" ClipToBounds="True">
                        <DataGrid x:Name="queue_dg"
                                  Style="{StaticResource SheetGrid}"
                                  RowStyle="{StaticResource GridRow}"
                                  ColumnHeaderStyle="{StaticResource GridColHeader}"
                                  CellStyle="{StaticResource GridCell}"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sheet No."
                                                    Binding="{Binding number}"
                                                    Width="90"/>
                                <DataGridTextColumn Header="File Name"
                                                    Binding="{Binding filename}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Format"
                                                    Binding="{Binding format}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Size"
                                                    Binding="{Binding paper_size}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding status}"
                                                    Width="90"/>
                                
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>

            <!-- Overall progress bar -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,0">
                <DockPanel>
                    <TextBlock Text="Overall"
                               DockPanel.Dock="Left"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               FontSize="12" FontWeight="SemiBold"
                               Opacity="0.7"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <TextBlock x:Name="overall_pct_tb"
                               Text="Ready"
                               DockPanel.Dock="Right"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               MinWidth="48"/>
                    <ProgressBar x:Name="overall_progress"
                                 Value="0"
                                 Minimum="0" Maximum="100"
                                 Height="14"
                                 Foreground="{DynamicResource BrushPrimaryGreen}"
                                 Background="{StaticResource GridRowBG}"
                                 BorderThickness="0"/>
                </DockPanel>
            </Border>

        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 3 — FOOTER
        ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{DynamicResource BrushHeaderBg}"
                BorderBrush="{DynamicResource BrushCardBg}"
                BorderThickness="0,1,0,0">
            <Grid>
                <DockPanel Margin="20,6">
                    <!-- Dynamic sheet count on top, set by Python; credits below -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="footer_status_tb"
                                   Text=""
                                   Foreground="{DynamicResource BrushPrimaryGreen}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Opacity="0.9"/>
                        <TextBlock FontSize="10"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource BrushTextPrimary}">
                            <Run>Special thanks to </Run>
                            <Hyperlink x:Name="pyrevit_link"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextDecorations="None"
                                       Click="footer_pyrevit_clicked">
                                <Run>Jean-Marc Couffin &amp; all pyRevit contributors</Run>
                            </Hyperlink>
                            <Run> for Print sheets, and to </Run>
                            <Hyperlink x:Name="ryan_link"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextDecorations="None"
                                       Click="footer_ryan_clicked">
                                <Run>Ryan McCullough</Run>
                            </Hyperlink>
                            <Run> for printFromindex</Run>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <!-- Decorative resize-grip dots, bottom-right corner. Purely visual;
                     actual resizing is handled by WindowChrome's ResizeBorderThickness. -->
                <Canvas Width="16" Height="16"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,8,6"
                        IsHitTestVisible="False">
                    <Rectangle Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" Fill="{DynamicResource BrushTextPrimary}" Opacity="0.35"/>
                    <Rectangle Canvas.Left="10" Canvas.Top="5"  Width="3" Height="3" Fill="{DynamicResource BrushTextPrimary}" Opacity="0.35"/>
                    <Rectangle Canvas.Left="5"  Canvas.Top="10" Width="3" Height="3" Fill="{DynamicResource BrushTextPrimary}" Opacity="0.35"/>
                    <Rectangle Canvas.Left="10" Canvas.Top="0"  Width="3" Height="3" Fill="{DynamicResource BrushTextPrimary}" Opacity="0.35"/>
                    <Rectangle Canvas.Left="5"  Canvas.Top="5"  Width="3" Height="3" Fill="{DynamicResource BrushTextPrimary}" Opacity="0.35"/>
                    <Rectangle Canvas.Left="0"  Canvas.Top="10" Width="3" Height="3" Fill="{DynamicResource BrushTextPrimary}" Opacity="0.35"/>
                </Canvas>
            </Grid>
        </Border>

    </Grid>
</Window>
