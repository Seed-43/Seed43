<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="pySheets"
        Height="780"
        Width="1000"
        MinHeight="600"
        MinWidth="800"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushWindowBg}"
        TextElement.FontFamily="Segoe UI"
        Closing="window_closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                             CornerRadius="10"
                             GlassFrameThickness="0"
                             ResizeBorderThickness="12"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- ═══════════════════════════════════════════════════════════
             COLOUR PALETTE
        ═══════════════════════════════════════════════════════════ -->
        <!-- Every Brush*/Size*/CornerRadius*/Padding* key this window uses is
             injected at open by seed43_theme.py from lib/Snippets/
             seed43_palette.json - see apply_seed43_palette() and
             apply_seed43_dimensions() in pySheets.py.

             There are deliberately no local copies of those keys. They only
             ever applied when injection failed, and they had drifted from the
             palette (BrushInputBg was declared here as #F4FAFF against the
             palette's #1d1d20), so a failure rendered the wrong colours
             instead of an obvious problem. The palette is the one source.

             The two below stay because seed43_theme.py does not inject them -
             they are this window's own grid-row colours, with no palette key
             behind them. -->
        <SolidColorBrush x:Key="GridRowBG"         Color="#1E2530"/>
        <SolidColorBrush x:Key="GridRowHover"      Color="#253040"/>

        <!-- ═══════════════════════════════════════════════════════════
             SECTION LABEL
        ═══════════════════════════════════════════════════════════ -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="FontSize"    Value="{DynamicResource FontSizeSectionLabel}"/>
            <Setter Property="Margin"      Value="0,0,0,8"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             FIELD LABEL
        ═══════════════════════════════════════════════════════════ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontWeight"  Value="Medium"/>
            <Setter Property="FontSize"    Value="{DynamicResource FontSizeFieldLabel}"/>
            <Setter Property="Opacity"     Value="0.85"/>
            <Setter Property="Margin"      Value="0,0,0,4"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             CARD BORDER
        ═══════════════════════════════════════════════════════════ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"    Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="CornerRadius"  Value="{DynamicResource CornerRadiusCard}"/>
            <Setter Property="Padding"       Value="{DynamicResource PaddingCard}"/>
            <Setter Property="Margin"        Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.2" ShadowDepth="2" BlurRadius="4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             TEXTBOX
        ═══════════════════════════════════════════════════════════ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background"             Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="Foreground"             Value="{DynamicResource BrushTextInput}"/>
            <Setter Property="BorderBrush"            Value="{DynamicResource BrushBorderDefault}"/>
            <Setter Property="BorderThickness"        Value="{DynamicResource BorderThicknessInput}"/>
            <Setter Property="Padding"                Value="{DynamicResource PaddingInput}"/>
            <Setter Property="FontSize"               Value="{DynamicResource FontSizeInput}"/>
            <Setter Property="Height"                 Value="{DynamicResource HeightInput}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusInput}">
                            <!-- No Margin="{TemplateBinding Padding}" here.
                                 WPF already applies TextBox.Padding to the
                                 element named PART_ContentHost, so setting it
                                 again doubles it - text clipped top and bottom
                                 and pushed in from the left. -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             COMBOBOX
        ═══════════════════════════════════════════════════════════ -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background"      Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextInput}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorderDefault}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessCombobox}"/>
            <Setter Property="Padding"         Value="{DynamicResource PaddingCombobox}"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeCombobox}"/>
            <Setter Property="Height"          Value="{DynamicResource HeightCombobox}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusCombobox}">
                            <Grid>
                                <ToggleButton Background="Transparent"
                                              BorderThickness="0"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press"/>
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>
                                <Path x:Name="ArrowPath"
                                      Fill="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                                <Popup Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Border Background="{DynamicResource BrushCardBg}"
                                            BorderBrush="{DynamicResource BrushBorderDefault}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource CornerRadiusDropdownPopup}"
                                            MinWidth="{TemplateBinding ActualWidth}">
                                        <ScrollViewer MaxHeight="260">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox variant — used inside grid headers / dark surfaces -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}">
            <Setter Property="Background"  Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="Foreground"  Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPillOffBorder}"/>
            <Setter Property="FontSize"    Value="{DynamicResource FontSizeCombobox}"/>
            <Setter Property="Height"      Value="{DynamicResource HeightCombobox}"/>
        </Style>

        <!-- Compact multi-select filter combo — used in Revision/Size/Collection
             column headers. Same native ComboBox popup plumbing as DarkComboBox
             (proven to work inside DataGridColumnHeaders, e.g. namingformat_cb),
             just a small closed box (chevron only) with a fixed-width dropdown
             instead of one tied to the closed box's own (tiny) width. -->
        <Style x:Key="FilterComboBox" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}">
            <Setter Property="Background"  Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="Foreground"  Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPillOffBorder}"/>
            <Setter Property="Width"       Value="{DynamicResource WidthFilterCombo}"/>
            <Setter Property="Height"      Value="{DynamicResource HeightFilterCombo}"/>
            <Setter Property="Padding"     Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusFilterCombo}">
                            <Grid>
                                <ToggleButton Background="Transparent"
                                              BorderThickness="0"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press"/>
                                <Path HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Fill="{TemplateBinding Foreground}"
                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                                <Popup Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Border Background="{DynamicResource BrushCardBg}"
                                            BorderBrush="{DynamicResource BrushPrimaryGreen}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource CornerRadiusDropdownPopup}"
                                            MinWidth="160">
                                        <StackPanel Margin="4">
                                            <DockPanel Margin="4,2">
                                                <Button Content="All" DockPanel.Dock="Left"
                                                        Width="50" Height="20" Padding="0"
                                                        Style="{DynamicResource SmallSecBtn}"
                                                        Click="filter_all_clicked"/>
                                                <Button Content="None" DockPanel.Dock="Right"
                                                        Width="50" Height="20" Padding="0"
                                                        Style="{DynamicResource SmallSecBtn}"
                                                        Click="filter_none_clicked"/>
                                            </DockPanel>
                                            <Rectangle Fill="{DynamicResource BrushSecondaryBg}" Height="1" Margin="0,4"/>
                                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                                <StackPanel IsItemsHost="True"/>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox row used inside a FilterComboBox dropdown. The
             PreviewMouseLeftButtonDown handler toggles IsChecked itself and
             marks the event handled so it never reaches the ComboBoxItem,
             which would otherwise select+close the dropdown on every click
             (the standard fix for multi-select ComboBoxes in WPF). -->
        <!-- ═══════════════════════════════════════════════════════════
             CHECKBOX  (canonical Seed43 box, not the native Windows one)
        ═══════════════════════════════════════════════════════════ -->
        <!-- Same template as lib/Snippets/Seed43Styles.xaml and Batch
             Upgrade - keep the three in step if any of them changes. Before
             this, every checkbox in this window was the stock Windows one:
             only the label colour and size were ever styled.

             NOTE: the tick geometry is cut for a 16px box (the SizeCheckbox
             default) and does not scale with the token. -->
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeFieldLabel}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Margin"     Value="0,4,18,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <!-- Transparent background, not none, so the whole row
                             - label included - is the click target, not just
                             the box itself. -->
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="{DynamicResource SizeCheckbox}"
                                    Height="{DynamicResource SizeCheckbox}"
                                    Background="{DynamicResource BrushInputBg}"
                                    BorderBrush="{DynamicResource BrushBorderDefault}"
                                    BorderThickness="{DynamicResource BorderThicknessCheckbox}"
                                    CornerRadius="{DynamicResource CornerRadiusCheckbox}"
                                    VerticalAlignment="Center">
                                <!-- BrushToggleKnob, not BrushTextPrimary: this
                                     is a mark on an accent-filled control, the
                                     same as the toggle knob, and it has to stay
                                     light against the green in the light
                                     profile too. -->
                                <Path x:Name="Tick"
                                      Data="M 3,7.5 L 6,10.5 L 11.5,4.5"
                                      Stroke="{DynamicResource BrushToggleKnob}"
                                      StrokeThickness="2"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box"  Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                                <Setter TargetName="Box" Property="Background"  Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Applied to every CheckBox in the window without tagging all 28 of
             them, the way the old label-only style was. Margin is reset to 0:
             this window's layouts already set their own spacing, and the
             canonical 0,4,18,4 would shift the grid's centred Include box and
             the weekday row. -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBoxStyle}">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Header-filter dropdown items. Same box as everywhere else, just
             smaller text and the dropdown's own spacing - an explicit Style
             replaces the implicit one rather than adding to it, so without
             the BasedOn these four would still be native Windows boxes. -->
        <Style x:Key="FilterCheckBox" TargetType="CheckBox"
               BasedOn="{StaticResource CheckBoxStyle}">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="6,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             RADIO BUTTON  (canonical Seed43 ring, not the native circle)
        ═══════════════════════════════════════════════════════════ -->
        <!-- Same template as lib/Snippets/Seed43Styles.xaml, pyTable and
             pyLink - keep them in step if any changes. Round twin of
             CheckBoxStyle above: an outlined ring that gets an accent dot
             when checked. Before this, all eight radios in this window were
             the stock Windows ones. -->
        <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="16" Height="16"
                                    BorderBrush="{DynamicResource BrushPrimaryGreen}" BorderThickness="1.5"
                                    CornerRadius="8" Background="{DynamicResource BrushInputBg}"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="8" Height="8"
                                         Fill="{DynamicResource BrushPrimaryGreen}"
                                         Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Applied to every RadioButton in the window without tagging all
             eight. Unlike the checkbox twin this needs no Margin reset - the
             canonical radio sets no Margin, and each radio already carries
             its own spacing. -->
        <Style TargetType="RadioButton" BasedOn="{StaticResource RadioButtonStyle}"/>

        <!-- Shared header content for dynamically-added custom parameter
             columns (Manage Columns). One DataTemplate instantiated per
             column at runtime via DataTemplate.LoadContent() — the safe,
             sanctioned way to build a WPF tree from code without
             FrameworkElementFactory. title_tb.Text and filter_cb.Tag are
             set right after LoadContent() in _build_extra_column. -->
        <DataTemplate x:Key="ExtraColumnHeaderTemplate">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="title_tb" VerticalAlignment="Center"
                           DockPanel.Dock="Left" Margin="0,0,4,0"/>
                <ComboBox x:Name="filter_cb"
                          DockPanel.Dock="Right"
                          VerticalAlignment="Center"
                          Style="{StaticResource FilterComboBox}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding label}"
                                      IsChecked="{Binding is_checked, UpdateSourceTrigger=PropertyChanged}"
                                      Tag="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=Tag}"
                                      Style="{StaticResource FilterCheckBox}"
                                      PreviewMouseLeftButtonDown="extra_filter_checkbox_preview_down"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>
        </DataTemplate>

        <!-- Dark DatePicker — pill shape matching SmallSecToggle / DarkComboBox -->
        <Style x:Key="DarkDatePicker" TargetType="DatePicker">
            <Setter Property="Background"      Value="{DynamicResource BrushSecondaryBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BrushPillOffBorder}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessInput}"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeInput}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="{DynamicResource PaddingInput}"/>
            <Setter Property="Height"          Value="{DynamicResource HeightInput}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid x:Name="PART_Root">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource CornerRadiusInput}">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePickerTextBox x:Name="PART_TextBox"
                                                        Grid.Column="0"
                                                        Foreground="{TemplateBinding Foreground}"
                                                        FontSize="{TemplateBinding FontSize}"
                                                        FontWeight="{TemplateBinding FontWeight}"
                                                        CaretBrush="{DynamicResource BrushTextPrimary}"
                                                        VerticalContentAlignment="Center"
                                                        Focusable="{TemplateBinding IsTabStop}">
                                        <DatePickerTextBox.Template>
                                            <ControlTemplate TargetType="DatePickerTextBox">
                                                <Border Background="Transparent" BorderThickness="0">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Focusable="False"
                                                                  HorizontalScrollBarVisibility="Hidden"
                                                                  VerticalScrollBarVisibility="Hidden"/>
                                                </Border>
                                            </ControlTemplate>
                                        </DatePickerTextBox.Template>
                                    </DatePickerTextBox>
                                    <Button x:Name="PART_Button"
                                            Grid.Column="1"
                                            Width="18" Height="18"
                                            Margin="4,0,0,0"
                                            Cursor="Hand"
                                            Focusable="False">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="IconBd" Background="Transparent" CornerRadius="4">
                                                    <Path Data="M3,2 L3,4 M11,2 L11,4 M2,5 L12,5 M2,4 L12,4 L12,13 L2,13 Z"
                                                          Stroke="{DynamicResource BrushTextPrimary}"
                                                          StrokeThickness="1.1"
                                                          Opacity="0.85"
                                                          Width="13" Height="13"
                                                          Stretch="Uniform"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="IconBd" Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Popup x:Name="PART_Popup"
                                           Grid.ColumnSpan="2"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark dropdown items — applies to every ComboBox popup -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushDropdownItemHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS-style slim green scrollbar — applies everywhere -->
        <Style x:Key="MacScrollBarThumb" TargetType="Thumb">
            <Setter Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumb"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width"    Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="GridRoot" Width="8" Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Orientation="Vertical"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MacScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GridRoot" Property="Width" Value="10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width"     Value="Auto"/>
                    <Setter Property="MinWidth"  Value="0"/>
                    <Setter Property="Height"    Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid x:Name="GridRoot" Height="8" Background="Transparent">
                                    <Track x:Name="PART_Track" Orientation="Horizontal">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource MacScrollBarThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="GridRoot" Property="Height" Value="10"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             PRIMARY BUTTON  (green fill)
        ═══════════════════════════════════════════════════════════ -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"   Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="Foreground"   Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="FontSize"     Value="{DynamicResource FontSizeButton}"/>
            <Setter Property="Padding"      Value="{DynamicResource PaddingButtonPrimary}"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButton}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             SECONDARY BUTTON  (grey fill)
        ═══════════════════════════════════════════════════════════ -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BrushSecondaryBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeButtonSecondary}"/>
            <Setter Property="Padding"         Value="{DynamicResource PaddingButtonSecondary}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButtonSecondary}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             SMALL SECONDARY BUTTON  (toolbar / browse buttons)
        ═══════════════════════════════════════════════════════════ -->
        <Style x:Key="SmallSecBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeButtonSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="{DynamicResource PaddingButtonSmall}"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             SMALL PRIMARY BUTTON  (accent, sits in a row of small controls)
        ═══════════════════════════════════════════════════════════ -->
        <Style x:Key="SmallPrimBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeButtonSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="{DynamicResource PaddingButtonSmall}"/>
        </Style>

        <Style x:Key="SmallSecToggle" TargetType="ToggleButton">
            <Setter Property="Background"  Value="{DynamicResource BrushSecondaryBg}"/>
            <Setter Property="Foreground"  Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"    Value="{DynamicResource FontSizeButtonSmall}"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Padding"     Value="{DynamicResource PaddingButtonSmall}"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButtonSmall}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hamburger dropdown menu item — shared by all items in settings_popup -->
        <Style x:Key="HamburgerMenuItem" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness"             Value="0"/>
            <Setter Property="Padding"                     Value="{DynamicResource PaddingMenuItem}"/>
            <Setter Property="HorizontalContentAlignment"  Value="Left"/>
            <Setter Property="Cursor"                      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom title bar control: close -->
        <Style x:Key="WinCtrlCloseBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="{DynamicResource WidthButtonClose}"/>
            <Setter Property="Height"          Value="{DynamicResource HeightButtonClose}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButtonClose}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushDanger}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             PILL BUTTON  (Sheets/Views toggle + format pills)
             Three visual states via Tag:
               Tag=""        → off   (grey bg, grey border, dim)
               Tag="Enabled" → on    (grey bg, GREEN border, green dot)
               Tag="Viewing" → active (GREEN bg, green border, white dot)
             Shape: pill (rounded rectangle, not oval)
        ═══════════════════════════════════════════════════════════ -->
        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BrushPillOffBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BrushPillOffBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Opacity"         Value="0.45"/>
            <Setter Property="Padding"         Value="14,5"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Dot indicator -->
                                <Ellipse x:Name="Dot"
                                         Width="7" Height="7"
                                         Fill="White" Opacity="0.25"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover on off state -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value=""/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreen}"/>
                                <Setter Property="Opacity" Value="1"/>
                            </MultiTrigger>
                            <!-- Enabled state: grey bg + green border + green dot -->
                            <Trigger Property="Tag" Value="Enabled">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreen}"/>
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource BrushPrimaryGreen}"/>
                                <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <!-- Viewing state: green bg + white dot -->
                            <Trigger Property="Tag" Value="Viewing">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreen}"/>
                                <Setter TargetName="Dot" Property="Fill" Value="White"/>
                                <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN TAB BUTTON  (Select / Export Settings / Print)
        ═══════════════════════════════════════════════════════════ -->
        <Style x:Key="MainTab" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Normal"/>
            <Setter Property="Opacity"         Value="0.7"/>
            <Setter Property="Padding"         Value="24,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreen}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Done">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value=""/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Opacity" Value="0.75"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             CHECKBOX STYLE
        ═══════════════════════════════════════════════════════════ -->

        <!-- ═══════════════════════════════════════════════════════════
             DATAGRID — base
        ═══════════════════════════════════════════════════════════ -->
        <Style x:Key="SheetGrid" TargetType="DataGrid">
            <Setter Property="Background"             Value="{StaticResource GridRowBG}"/>
            <Setter Property="Foreground"             Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="GridLinesVisibility"    Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="HeadersVisibility"      Value="Column"/>
            <Setter Property="RowHeaderWidth"         Value="0"/>
            <Setter Property="CanUserResizeRows"      Value="False"/>
            <Setter Property="CanUserAddRows"         Value="False"/>
            <Setter Property="SelectionMode"          Value="Single"/>
            <Setter Property="SelectionUnit"          Value="FullRow"/>
            <Setter Property="AutoGenerateColumns"    Value="False"/>
            <Setter Property="EnableRowVirtualization"    Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing"      Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode"  Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll"         Value="True"/>
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False"/>
        </Style>

        <!-- DataGrid column header -->
        <Style x:Key="GridColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"   Value="{DynamicResource BrushHeaderBg}"/>
            <Setter Property="Foreground"   Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Padding"      Value="8,7"/>
            <Setter Property="Opacity"      Value="0.65"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Format column header -->
        <Style x:Key="FmtColHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource GridColHeader}">
        </Style>

        <!-- DataGrid cell -->
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Format column cell -->
        <Style x:Key="FmtCell" TargetType="DataGridCell" BasedOn="{StaticResource GridCell}">
        </Style>

        <!-- DataGrid row -->
        <Style x:Key="GridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource GridRowBG}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource GridRowHover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding is_selected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushSelectedRowBg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding is_highlighted}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushHighlightedRowBg}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Revision badge template -->
        <DataTemplate x:Key="RevBadgeCell">
            <Border x:Name="Badge"
                    Background="{DynamicResource BrushPrimaryGreen}"
                    CornerRadius="3"
                    Padding="5,1"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed">
                <TextBlock Text="{Binding revision.number}"
                           Foreground="White"
                           FontSize="10"
                           FontWeight="SemiBold"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding revision.is_set}" Value="True">
                    <Setter TargetName="Badge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Include checkbox cell template -->
        <DataTemplate x:Key="IncludeCell">
            <CheckBox IsChecked="{Binding is_selected, UpdateSourceTrigger=PropertyChanged}"
                      HorizontalAlignment="Center"
                      Click="include_checkbox_clicked"
                      Tag="{Binding}"/>
        </DataTemplate>

        <!-- Filename preview cell template -->
        <DataTemplate x:Key="FilenameCell">
            <TextBlock Text="{Binding print_filename}"
                       FontFamily="Consolas"
                       FontSize="10"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       Opacity="0.55"
                       FontStyle="Italic"
                       VerticalAlignment="Center"/>
        </DataTemplate>

        <!-- Print settings item template (compatibility aware) -->
        <DataTemplate x:Key="PrintSettingItem">
            <WrapPanel>
                <TextBlock x:Name="ItemName" Text="{Binding name}"/>
                <Border x:Name="IncompatBadge"
                        Background="Red"
                        CornerRadius="3"
                        Padding="5,0"
                        Margin="8,0,0,0"
                        Visibility="Collapsed">
                    <TextBlock Text="Incompatible" FontSize="10" Foreground="White"/>
                </Border>
            </WrapPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding is_compatible}" Value="False">
                    <Setter TargetName="IncompatBadge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ItemName"      Property="Foreground" Value="Gray"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Document item template (linked prefix) -->
        <!-- Profile dropdown item: accent dot marks an armed schedule.
             The ellipse is always present and only changes colour, so the
             names stay aligned whether a card is armed or not. -->
        <DataTemplate x:Key="ProfileItem">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ArmedDot"
                         Width="7" Height="7" Margin="0,0,6,0"
                         VerticalAlignment="Center"
                         Fill="Transparent"/>
                <TextBlock Text="{Binding name}" VerticalAlignment="Center"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding armed}" Value="True">
                    <Setter TargetName="ArmedDot" Property="Fill"
                            Value="{DynamicResource BrushPrimaryGreen}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="DocItem">
            <Grid>
                <TextBlock x:Name="Normal"  Text="{Binding name}"/>
                <TextBlock x:Name="Linked"  Text="{Binding name, StringFormat=Linked: \{0\}}"
                           Visibility="Collapsed"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding linked}" Value="True">
                    <Setter TargetName="Normal" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Linked" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT LAYOUT
    ═══════════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>   <!-- Header bar -->
            <RowDefinition Height="44"/>   <!-- Tab bar -->
            <RowDefinition Height="*"/>    <!-- Tab content -->
            <RowDefinition Height="52"/>   <!-- Footer bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 0 — HEADER
        ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource BrushHeaderBg}"
                CornerRadius="10,10,12,12">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="2" BlurRadius="8"/>
            </Border.Effect>
            <Grid Margin="20,0">

                <!-- LEFT: wordmark + contextual subtitle -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <Image x:Name="header_icon"
                           Width="{DynamicResource SizeTopBarLogo}"
                           Height="{DynamicResource SizeTopBarLogo}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                    <TextBlock Text="py"
                               Foreground="{DynamicResource BrushPrimaryGreen}"
                               FontWeight="Bold"
                               FontSize="26"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Sheets"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               FontWeight="Bold"
                               FontSize="26"
                               VerticalAlignment="Center"/>
                    <!-- Subtitle changes per tab — controlled from Python -->
                    <TextBlock x:Name="header_subtitle_tb"
                               Text="| Select"
                               Width="110"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Opacity="0.55"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                    <!-- Step indicators — moved beside the wordmark -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="24,0,0,0">

                    <!-- Step 1 -->
                    <Border x:Name="step1_circle"
                            Width="26" Height="26"
                            CornerRadius="13"
                            Background="{DynamicResource BrushPrimaryGreen}">
                        <TextBlock Text="1"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Connector 1→2 -->
                    <Rectangle x:Name="step_line_1"
                               Width="36" Height="2"
                               Fill="{DynamicResource BrushSecondaryDisabledBg}"
                               VerticalAlignment="Center"/>

                    <!-- Step 2 -->
                    <Border x:Name="step2_circle"
                            Width="26" Height="26"
                            CornerRadius="13"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BrushSecondaryDisabledBg}"
                            BorderThickness="2">
                        <TextBlock Text="2"
                                   Foreground="{DynamicResource BrushSecondaryDisabledFg}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Connector 2→3 -->
                    <Rectangle x:Name="step_line_2"
                               Width="36" Height="2"
                               Fill="{DynamicResource BrushSecondaryDisabledBg}"
                               VerticalAlignment="Center"/>

                    <!-- Step 3 -->
                    <Border x:Name="step3_circle"
                            Width="26" Height="26"
                            CornerRadius="13"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BrushSecondaryDisabledBg}"
                            BorderThickness="2">
                        <TextBlock Text="3"
                                   Foreground="{DynamicResource BrushSecondaryDisabledFg}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    </StackPanel>
                </StackPanel>

                <!-- RIGHT: print icon button + hamburger -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                    <!-- Profile selector + actions -->
                    <TextBlock Text="Profile"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               Opacity="0.6"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <ComboBox x:Name="profile_cb"
                              Width="140"
                              Style="{StaticResource DarkComboBox}"
                              ItemTemplate="{StaticResource ProfileItem}"
                              SelectionChanged="profile_changed"
                              DropDownClosed="profile_dropdown_closed"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center"/>
                    <Button x:Name="profile_new_btn"
                            Content="+"
                            Width="28" Height="28" Padding="0"
                            Style="{StaticResource SmallSecBtn}"
                            ToolTip="New profile from current settings"
                            Click="profile_new_clicked"
                            Margin="0,0,4,0"/>
                    <Button x:Name="profile_save_btn"
                            Content="💾"
                            Width="28" Height="28" Padding="0"
                            Style="{StaticResource SmallSecBtn}"
                            ToolTip="Save current settings to selected profile"
                            Click="profile_save_clicked"
                            Margin="0,0,12,0"/>

                    <!-- Next / Print icon button — always visible, icon and action
                         change with the current tab (see header_action_clicked) -->
                    <Button x:Name="header_print_btn"
                            Width="48" Height="36"
                            Margin="0,0,8,0"
                            Click="header_action_clicked"
                            ToolTip="Next"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"      Value="{DynamicResource BrushPrimaryGreen}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource BrushPrimaryGreenHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <!-- Printer icon — Export tab only -->
                            <Viewbox x:Name="header_printer_icon" Width="20" Height="20" Visibility="Collapsed">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M18,3H6V7H18M19,12A1,1 0 0,1 18,11A1,1 0 0,1 19,10A1,1 0 0,1 20,11A1,1 0 0,1 19,12M16,19H8V14H16M19,8H5A3,3 0 0,0 2,11V17H6V21H18V17H22V11A3,3 0 0,0 19,8Z"
                                          Fill="White"/>
                                </Canvas>
                            </Viewbox>
                            <!-- Three chevrons ("next") — Select/Settings tabs -->
                            <Viewbox x:Name="header_chevrons_icon" Width="26" Height="20" Visibility="Visible">
                                <Canvas Width="54" Height="24">
                                    <Path Canvas.Left="0"  Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Fill="White"/>
                                    <Path Canvas.Left="15" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Fill="White"/>
                                    <Path Canvas.Left="30" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Fill="White"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Button>

                    <!-- Hamburger settings button + popup -->
                    <Grid Margin="16,0,0,0">
                        <ToggleButton x:Name="settings_toggle_btn"
                                      Width="36" Height="36"
                                      Cursor="Hand"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      PreviewMouseLeftButtonDown="settings_toggle_preview_down">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bd"
                                                        Background="Transparent"
                                                        CornerRadius="6"
                                                        Width="36" Height="36">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <Popup x:Name="settings_popup"
                               PlacementTarget="{Binding ElementName=settings_toggle_btn}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               IsOpen="{Binding ElementName=settings_toggle_btn, Path=IsChecked}">
                            <Border Background="{DynamicResource BrushCardBg}"
                                    BorderBrush="{DynamicResource BrushPrimaryGreen}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MinWidth="200">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.25" ShadowDepth="2" BlurRadius="8"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Button x:Name="manage_presets_btn"
                                            Content="📁  Export Location Presets"
                                            Style="{StaticResource HamburgerMenuItem}"
                                            Click="manage_presets_clicked"/>
                                    <Button x:Name="manage_profiles_btn"
                                            Content="🗂  Profiles"
                                            Style="{StaticResource HamburgerMenuItem}"
                                            Click="manage_profiles_clicked"/>
                                    <Button x:Name="manage_columns_btn"
                                            Content="🧩  Manage Columns"
                                            Style="{StaticResource HamburgerMenuItem}"
                                            Click="manage_columns_clicked"/>
                                    <Rectangle Fill="{DynamicResource BrushSecondaryBg}" Height="1" Margin="0,2"/>
                                    <Button x:Name="export_settings_btn"
                                            Content="📤  Export Settings"
                                            Style="{StaticResource HamburgerMenuItem}"
                                            Click="export_settings_clicked"/>
                                    <Button x:Name="import_settings_btn"
                                            Content="📥  Import Settings"
                                            Style="{StaticResource HamburgerMenuItem}"
                                            Click="import_settings_clicked"/>
                                    <Rectangle Fill="{DynamicResource BrushSecondaryBg}" Height="1" Margin="0,2"/>
                                    <Button x:Name="help_btn"
                                            Content="&#x2709;  Email support"
                                            Style="{StaticResource HamburgerMenuItem}"
                                            Click="help_clicked"/>
                                    <Button x:Name="issue_btn"
                                            Content="Report an issue on GitHub"
                                            Style="{StaticResource HamburgerMenuItem}"
                                            Click="issue_clicked"/>
                                    <Rectangle Fill="{DynamicResource BrushSecondaryBg}" Height="1" Margin="0,2"/>
                                    <Button x:Name="about_btn"
                                            Content="ℹ  About pySheets"
                                            Style="{StaticResource HamburgerMenuItem}"
                                            Click="about_clicked"/>
                                    <Rectangle Fill="{DynamicResource BrushSecondaryBg}" Height="1" Margin="0,2"/>
                                    <Button x:Name="support_btn"
                                            Content="☕  Support this project and help us grow"
                                            Style="{StaticResource HamburgerMenuItem}"
                                            Click="support_clicked"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Window control: close only -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="win_close_btn"
                                Style="{StaticResource WinCtrlCloseBtn}"
                                ToolTip="Close"
                                Click="win_close_clicked"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 1 — TAB BAR
        ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource BrushWindowBg}"
                BorderBrush="{DynamicResource BrushPrimaryGreen}"
                BorderThickness="0,0,0,2">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Margin="16,0,0,0">
                <Button x:Name="tab_select_btn"
                        Content="Select"
                        Tag="Active"
                        Style="{StaticResource MainTab}"
                        Click="tab_select_clicked"/>
                <Button x:Name="tab_export_btn"
                        Content="Settings"
                        Tag=""
                        Style="{StaticResource MainTab}"
                        Click="tab_export_clicked"/>
                <Button x:Name="tab_print_btn"
                        Content="Export"
                        Tag=""
                        Style="{StaticResource MainTab}"
                        Click="tab_print_clicked"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 2 — TAB CONTENT  (only one visible at a time)
        ═══════════════════════════════════════════════════════════ -->

        <!-- ─────────────────────────────────────────────────────────
             TAB: SELECT
        ───────────────────────────────────────────────────────── -->
        <Grid x:Name="tab_select"
              Grid.Row="2"
              Visibility="Visible"
              Margin="16,12,16,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- controls (doc/set/pills) -->
                <RowDefinition Height="*"/>     <!-- DataGrid — fills all remaining space -->
                <RowDefinition Height="Auto"/>  <!-- bottom bar -->
            </Grid.RowDefinitions>

            <!-- Controls row -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,0">
                <StackPanel>

                    <!-- Row 1: Document / Sheet Set / Save Set / Search -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Document -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Document" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="documents_cb"
                                          Width="185"
                                          Style="{StaticResource ModernComboBox}"
                                          ItemTemplate="{StaticResource DocItem}"
                                          SelectionChanged="doc_changed"/>
                            </StackPanel>

                            <!-- Sheet Set -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Sheet Set" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="sheetset_cb"
                                          Width="160"
                                          Style="{StaticResource ModernComboBox}"
                                          ToolTip="Ticks the sheets in the set — the list still shows every sheet, so you can add or remove sheets afterwards"
                                          SelectionChanged="sheetset_changed">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Order -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Order" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="order_cb"
                                          Width="190"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="order_changed">
                                    <ComboBoxItem x:Name="order_browser_item" Content="Browser organization" Tag="browser"/>
                                    <ComboBoxItem x:Name="order_ascending_item" Content="Sheet Number (Ascending)" Tag="ascending"/>
                                    <ComboBoxItem Content="Manual order" Tag="manual"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Save Set button -->
                            <Button Grid.Column="6"
                                    Content="Save Set"
                                    Style="{StaticResource SmallSecBtn}"
                                    VerticalAlignment="Bottom"
                                    Click="save_sheet_set"/>

                            <!-- Search box (right-aligned). Per the palette
                                 editor's Search Box: a plain text input on the
                                 input_textbox tokens, with a muted search glyph
                                 inset over it - no separate label. The 28px left
                                 padding clears the icon, as padding-left does in
                                 the editor's own preview. -->
                            <Grid Grid.Column="8" Width="180" VerticalAlignment="Bottom">
                                <!-- Alignment pinned locally: this is the one
                                     input that stretches to its container
                                     instead of carrying its own Width, and it
                                     comes up centred without these. -->
                                <TextBox x:Name="search_tb"
                                         Style="{StaticResource ModernTextBox}"
                                         Padding="28,0,8,0"
                                         HorizontalContentAlignment="Left"
                                         TextAlignment="Left"
                                         TextChanged="search_changed"/>
                                <ContentControl x:Name="search_icon"
                                                Width="14" Height="14"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Margin="9,0,0,0"
                                                IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>

                        <!-- Row 2: Sheets/Views toggle + Export As pills -->
                        <WrapPanel Orientation="Horizontal"
                                   Margin="0,0,0,12"
                                   VerticalAlignment="Center">

                            <!-- Sheets / Views -->
                            <Button x:Name="sv_sheets_btn"
                                    Content="Sheets"
                                    Tag="Viewing"
                                    Style="{StaticResource PillBtn}"
                                    Margin="0,0,4,0"
                                    Click="sv_sheets_clicked"/>
                            <Button x:Name="sv_views_btn"
                                    Content="Views"
                                    Tag=""
                                    Style="{StaticResource PillBtn}"
                                    Margin="0,0,12,0"
                                    Click="sv_views_clicked"/>


                            <!-- Divider -->
                            <Rectangle Width="1"                                        Fill="{DynamicResource BrushSecondaryBg}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <TextBlock Text="Export as:"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       FontSize="11"
                                       Opacity="0.4"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>

                            <!-- Format pills — Tag controlled by Python -->
                            <Button x:Name="fmt_pdf_btn"
                                    Content="PDF"
                                    Tag="Viewing"
                                    Style="{StaticResource PillBtn}"
                                    Margin="0,0,4,0"
                                    Click="fmt_pill_clicked"/>
                            <Button x:Name="fmt_dwg_btn"
                                    Content="DWG"
                                    Tag=""
                                    Style="{StaticResource PillBtn}"
                                    Margin="0,0,4,0"
                                    Click="fmt_pill_clicked"/>
                            <Button x:Name="fmt_dgn_btn"
                                    Content="DGN"
                                    Tag=""
                                    Style="{StaticResource PillBtn}"
                                    Margin="0,0,4,0"
                                    Click="fmt_pill_clicked"/>
                            <Button x:Name="fmt_nwc_btn"
                                    Content="NWC"
                                    Tag=""
                                    Style="{StaticResource PillBtn}"
                                    Margin="0,0,4,0"
                                    Click="fmt_pill_clicked"/>
                            <Button x:Name="fmt_ifc_btn"
                                    Content="IFC"
                                    Tag=""
                                    Style="{StaticResource PillBtn}"
                                    Margin="0,0,4,0"
                                    Click="fmt_pill_clicked"/>
                            <Button x:Name="fmt_img_btn"
                                    Content="IMG"
                                    Tag=""
                                    Style="{StaticResource PillBtn}"
                                    Margin="0,0,4,0"
                                    Click="fmt_pill_clicked"/>
                            <!-- Last in the row, and the only one that deals
                                 in schedules: Revit will not print or export
                                 a schedule to any of the formats above. -->
                            <Button x:Name="fmt_xls_btn"
                                    Content="XLS"
                                    Tag=""
                                    Style="{StaticResource PillBtn}"
                                    ToolTip="Export selected schedules to one spreadsheet — a tab per schedule"
                                    Click="fmt_pill_clicked"/>
                        </WrapPanel>

                </StackPanel>
            </Border>

            <!-- DataGrid row — stretches to fill all remaining vertical space -->
            <Border Grid.Row="1" CornerRadius="6" ClipToBounds="True" Margin="0,4,0,4"
                    Style="{StaticResource Card}">
              <Grid>
                <DataGrid x:Name="sheets_dg"
                          Style="{StaticResource SheetGrid}"
                          RowStyle="{StaticResource GridRow}"
                          ColumnHeaderStyle="{StaticResource GridColHeader}"
                          CellStyle="{StaticResource GridCell}"
                          SelectionChanged="grid_selection_changed"
                          Sorting="sheets_dg_sorting">

                                <DataGrid.Columns>

                                    <!-- Col 0: Checkbox -->
                                    <DataGridTemplateColumn x:Name="check_col" Width="36" MinWidth="36" IsReadOnly="True">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox x:Name="select_all_cb"
                                                      HorizontalAlignment="Center"
                                                      IsThreeState="True"
                                                      Click="select_all_clicked"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding is_selected,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"
                                                          Click="include_checkbox_clicked"
                                                          Tag="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Col 1: Sheet Number -->
                                    <DataGridTextColumn x:Name="number_col"
                                                        Header="Sheet No."
                                                        Binding="{Binding number}"
                                                        Width="88" MinWidth="70"
                                                        IsReadOnly="True"/>

                                    <!-- Col 2: Sheet Name -->
                                    <DataGridTextColumn x:Name="name_col"
                                                        Header="Sheet Name"
                                                        Binding="{Binding name}"
                                                        Width="*" MinWidth="120"
                                                        IsReadOnly="True"/>

                                    <!-- Col 3: Revision -->
                                    <DataGridTemplateColumn x:Name="revision_col" Width="80" MinWidth="70"
                                                            IsReadOnly="True"
                                                            CellTemplate="{StaticResource RevBadgeCell}"
                                                            SortMemberPath="revision.number">
                                        <DataGridTemplateColumn.Header>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="Revision" VerticalAlignment="Center"
                                                           DockPanel.Dock="Left" Margin="0,0,4,0"/>
                                                <ComboBox x:Name="rev_filter_cb"
                                                          DockPanel.Dock="Right"
                                                          VerticalAlignment="Center"
                                                          Style="{StaticResource FilterComboBox}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding label}"
                                                                      IsChecked="{Binding is_checked, UpdateSourceTrigger=PropertyChanged}"
                                                                      Style="{StaticResource FilterCheckBox}"
                                                                      PreviewMouseLeftButtonDown="rev_filter_checkbox_preview_down"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DockPanel>
                                        </DataGridTemplateColumn.Header>
                                    </DataGridTemplateColumn>

                                    <!-- Col 4: Size (sheets) / Type (views). Header content swapped from code. -->
                                    <DataGridTextColumn x:Name="size_col"
                                                        Binding="{Binding paper_size}"
                                                        Width="86" MinWidth="70"
                                                        IsReadOnly="True">
                                        <DataGridTextColumn.Header>
                                            <DockPanel x:Name="size_filter_header" LastChildFill="False">
                                                <TextBlock Text="Size" VerticalAlignment="Center"
                                                           DockPanel.Dock="Left" Margin="0,0,4,0"/>
                                                <ComboBox x:Name="size_filter_cb"
                                                          DockPanel.Dock="Right"
                                                          VerticalAlignment="Center"
                                                          Style="{StaticResource FilterComboBox}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding label}"
                                                                      IsChecked="{Binding is_checked, UpdateSourceTrigger=PropertyChanged}"
                                                                      Style="{StaticResource FilterCheckBox}"
                                                                      PreviewMouseLeftButtonDown="size_filter_checkbox_preview_down"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DockPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>

                                    <!-- Col 4b: Sheet Collection (sheets mode only, hidden for views) -->
                                    <DataGridTextColumn x:Name="collection_col"
                                                        Binding="{Binding sheet_collection}"
                                                        Width="90" MinWidth="70"
                                                        IsReadOnly="True">
                                        <DataGridTextColumn.Header>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="Collection" VerticalAlignment="Center"
                                                           DockPanel.Dock="Left" Margin="0,0,4,0"/>
                                                <ComboBox x:Name="coll_filter_cb"
                                                          DockPanel.Dock="Right"
                                                          VerticalAlignment="Center"
                                                          Style="{StaticResource FilterComboBox}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding label}"
                                                                      IsChecked="{Binding is_checked, UpdateSourceTrigger=PropertyChanged}"
                                                                      Style="{StaticResource FilterCheckBox}"
                                                                      PreviewMouseLeftButtonDown="coll_filter_checkbox_preview_down"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DockPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>

                                    <!-- Col 5: Custom File Name (format column) -->
                                    <!-- Header contains the naming format dropdown + ... button -->
                                    <!-- Background and label updated from Python when viewing format changes -->
                                    <DataGridTemplateColumn x:Name="filename_col"
                                                            Width="210" MinWidth="160"
                                                            IsReadOnly="True">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader"
                                                   BasedOn="{StaticResource FmtColHeader}"/>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel>
                                                <!-- One row: FMT | dropdown | edit — fixed positions -->
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock x:Name="fmt_col_label"
                                                               Text="PDF"
                                                               Width="36"
                                                               DockPanel.Dock="Left"
                                                               Foreground="{DynamicResource BrushPrimaryGreen}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                    <Button Content="…"
                                                            DockPanel.Dock="Right"
                                                            Width="26"                                                             Margin="4,0,0,0"
                                                            Style="{StaticResource SmallSecBtn}"
                                                            Padding="0"
                                                            Click="edit_naming_formats"
                                                            ToolTip="Edit naming formats"/>
                                                    <ComboBox x:Name="namingformat_cb"
                                                                                                                            Style="{StaticResource DarkComboBox}"
                                                              SelectionChanged="naming_format_changed">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding name}"
                                                                           FontFamily="Consolas"
                                                                           FontSize="10"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </DockPanel>
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="Transparent"
                                                        Padding="6,0">
                                                    <TextBlock Text="{Binding print_filename}"
                                                               FontFamily="Consolas"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource BrushTextPrimary}"
                                                               Opacity="0.55"
                                                               FontStyle="Italic"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Drop-position indicator, shown/moved during a row drag,
                                 hidden otherwise. Sits on top of the grid since it's a
                                 later sibling in the same overlay Grid. -->
                            <Rectangle x:Name="drop_indicator"
                                       Height="3"
                                       Fill="{DynamicResource BrushPrimaryGreen}"
                                       VerticalAlignment="Top"
                                       HorizontalAlignment="Stretch"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"
                                       Margin="0,0,0,0"/>
                              </Grid>
                        </Border>

            <!-- Bottom bar: active filter / count -->
            <DockPanel Grid.Row="2" Margin="0,6,0,4">
                            <CheckBox x:Name="active_only_cb"
                                      Content="Appears In Sheet List only"
                                      IsChecked="False"
                                      DockPanel.Dock="Left"
                                      VerticalAlignment="Center"
                                      ToolTip="When checked, hides sheets where 'Appears In Sheet List' is unchecked in Revit"
                                      Checked="active_filter_changed"
                                      Unchecked="active_filter_changed"/>
                            <CheckBox x:Name="placed_only_cb"
                                      Content="Placed on Sheets only"
                                      IsChecked="False"
                                      Visibility="Collapsed"
                                      DockPanel.Dock="Left"
                                      VerticalAlignment="Center"
                                      ToolTip="When checked, hides views that are not placed on any sheet"
                                      Checked="placed_only_changed"
                                      Unchecked="placed_only_changed"/>
                            <TextBlock x:Name="sel_count_tb"
                                       Text="0 of 0 selected"
                                       Margin="16,0,0,0"
                                       Foreground="{DynamicResource BrushPrimaryGreen}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       DockPanel.Dock="Right"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

        </Grid>

        <!-- ─────────────────────────────────────────────────────────
             TAB: SETTINGS
        ───────────────────────────────────────────────────────── -->
        <ScrollViewer x:Name="tab_export"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="Collapsed">
            <StackPanel Margin="16,12,16,4">

                <!-- Format sub-tabs (PDF, DWG, IFC …) -->
                    <StackPanel>

                        <!-- Sub-tab pill row -->
                        <Border Background="{DynamicResource BrushCardBg}"
                                BorderBrush="{DynamicResource BrushBorderMuted}" BorderThickness="1"
                                CornerRadius="6" Padding="10" Margin="0,0,0,14">
                            <WrapPanel Orientation="Horizontal">
                            <Button x:Name="exp_pdf_btn"
                                    Content="PDF"
                                    Tag="Viewing"
                                    Style="{StaticResource PillBtn}"
                                    Margin="0,0,4,0"
                                    Click="exp_subtab_clicked"/>
                            <Button x:Name="exp_dwg_btn"
                                    Content="DWG"
                                    Tag=""
                                    Style="{StaticResource PillBtn}"
                                    Click="exp_subtab_clicked"
                                    Margin="0,0,4,0"/>
                            <Button x:Name="exp_dgn_btn"
                                    Content="DGN"
                                    Tag=""
                                    Style="{StaticResource PillBtn}"
                                    Click="exp_subtab_clicked"
                                    Margin="0,0,4,0"/>
                            <Button x:Name="exp_nwc_btn"
                                    Content="NWC"
                                    Tag=""
                                    Style="{StaticResource PillBtn}"
                                    Click="exp_subtab_clicked"
                                    Margin="0,0,4,0"/>
                            <Button x:Name="exp_ifc_btn"
                                    Content="IFC"
                                    Tag=""
                                    Style="{StaticResource PillBtn}"
                                    Click="exp_subtab_clicked"
                                    Margin="0,0,4,0"/>
                            <Button x:Name="exp_img_btn"
                                    Content="IMG"
                                    Tag=""
                                    Style="{StaticResource PillBtn}"
