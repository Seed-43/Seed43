<!--
===================================================================================
LayoutSettings.xaml  -  pyTransmit Layout Builder v5
===================================================================================
3 panes: Palette | Canvas | Preview
Header: rev count, page size, template, tabs, save/close
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Layout Builder"
        Height="760" Width="1160"
        MinHeight="560" MinWidth="900"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushWindowBg}"
        TextElement.FontFamily="Segoe UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54"
                             CornerRadius="10"
                             GlassFrameThickness="0"
                             ResizeBorderThickness="8"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Seed43 theming: this file used to alias its own local colour
             names (BgWindow/Accent/TextMain/etc) to the canonical Brush*
             names via a bridging step in LayoutSettingsWindow.__init__
             (see _apply_seed43_theme in LayoutSettings.py) - that's been
             eliminated. Every DynamicResource reference below now points
             directly at the same canonical names apply_seed43_palette()/
             apply_seed43_dimensions() inject, matching pyTransmit and
             About - no local declaration for those exists in this file at
             all any more, so if seed43_palette.json is ever missing, these
             DynamicResource lookups simply resolve to nothing rather than
             falling back to a second, separately-maintained hardcoded copy.

             LocalBrushRowBg/LocalBrushHoverBg/LocalBrushBorderNeutral and
             ColA-D are the exception: no canonical token exists yet for a
             neutral (non-accent) border/row colour, and ColA-D are
             intentional, distinct functional markers for the 4 layout
             columns, not theme colours - forcing them onto a single shared
             accent colour would destroy the whole point of them being
             different colours. These four stay as real local declarations,
             genuinely needed (not "double code"), and are candidates worth
             promoting into seed43_palette.json later if other tools want
             the same neutral-border/row-tint pattern.

             Muted/secondary text now uses BrushTextMuted, the same
             canonical DynamicResource apply_seed43_palette() injects for
             every other tool - no local declaration or code-side
             injection needed for it any more. -->
        <SolidColorBrush x:Key="LocalBrushRowBg"    Color="#323D4D"/>
        <SolidColorBrush x:Key="LocalBrushHoverBg"  Color="#3A4760"/>
        <SolidColorBrush x:Key="LocalBrushBorderNeutral" Color="#404E62"/>
        <SolidColorBrush x:Key="ColA"     Color="#2980B9"/>
        <SolidColorBrush x:Key="ColB"     Color="#27AE60"/>
        <SolidColorBrush x:Key="ColC"     Color="#8E44AD"/>
        <SolidColorBrush x:Key="ColD"     Color="#E67E22"/>

        <!-- Sizing tokens: same "no local fallback" principle as the
             colours above - these are all canonical names now too, values
             injected live by apply_seed43_dimensions(). PBtn and TabButtonStyle map
             to button_small (the standard action-button size used
             throughout this extension); ComboBoxStyle/TextBoxStyle map to
             input_combobox/input_textbox; SmallIconButtonStyle now matches
             TextBoxStyle's own height too, so it lines up with an adjacent
             textbox/combobox in the same row. The Revisions +/- stepper and
             a handful of deliberately-compact inline header widgets (the
             custom page-size fields) are the exception - they override that
             shared height explicitly and stay their current hardcoded size
             on purpose, since forcing those specifically into the standard
             28px input height would break their tight header layout. -->

        <!-- Primary button -->
        <Style x:Key="PBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="{DynamicResource PaddingButtonSmall}"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeButtonSmall}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="{DynamicResource HeightButtonSmall}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CornerRadiusButtonSmall}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/></Trigger>
                            <Trigger Property="IsPressed"   Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="{DynamicResource PaddingButtonPrimary}"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeButton}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButton}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BrushSecondaryBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="{DynamicResource PaddingButtonSecondary}"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeButtonSecondary}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButtonSecondary}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSecondaryPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close (X) button - matches pyTransmit/About exactly: transparent
             until hover, then turns danger red. -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="{DynamicResource WidthButtonClose}"/>
            <Setter Property="Height"          Value="{DynamicResource HeightButtonClose}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButtonClose}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushDanger}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small icon button - a tiny square icon-only button (Revisions
             +/- stepper, the canvas toolbar's gear icon). Height matches
             TextBoxStyle's own height token deliberately, so it lines up
             with whatever input control it's sitting next to in the same
             row - was previously a hardcoded 22px with no such alignment. -->
        <Style x:Key="SmallIconButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="{DynamicResource HeightInput}"/>
            <Setter Property="Height"          Value="{DynamicResource HeightInput}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CornerRadiusInput}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource LocalBrushHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab button -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource LocalBrushRowBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource LocalBrushBorderNeutral}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="{DynamicResource PaddingButtonSmall}"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeButtonSmall}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="{DynamicResource HeightButtonSmall}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource CornerRadiusButtonSmall}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource LocalBrushHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background"           Value="{StaticResource LocalBrushRowBg}"/>
            <Setter Property="Foreground"           Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush"          Value="{StaticResource LocalBrushBorderNeutral}"/>
            <Setter Property="BorderThickness"      Value="{DynamicResource BorderThicknessInput}"/>
            <Setter Property="Padding"              Value="{DynamicResource PaddingCombobox}"/>
            <Setter Property="FontSize"             Value="{DynamicResource FontSizeCombobox}"/>
            <Setter Property="Height"               Value="{DynamicResource HeightCombobox}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background"  Value="{DynamicResource BrushCardBg}"/>
                        <Setter Property="Foreground"  Value="{DynamicResource BrushTextPrimary}"/>
                        <Setter Property="Padding"     Value="{DynamicResource PaddingDropdownItem}"/>
                        <Setter Property="FontSize"    Value="{DynamicResource FontSizeCombobox}"/>
                        <Setter Property="Margin"      Value="4,2,4,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="{DynamicResource CornerRadiusDropdownItem}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource LocalBrushHoverBg}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="tgBd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{DynamicResource CornerRadiusCombobox}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="18"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"/>
                                                <TextBlock Grid.Column="1" Text="&#9662;"
                                                           Foreground="{DynamicResource BrushTextMuted}"
                                                           FontSize="9"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tgBd" Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreen}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,0,22,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource BrushCardBg}"
                                        BorderBrush="{StaticResource LocalBrushBorderNeutral}"
                                        CornerRadius="{DynamicResource CornerRadiusDropdownPopup}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.4" ShadowDepth="3" BlurRadius="8"/>
                                    </Border.Effect>
                                    <ScrollViewer Style="{DynamicResource MacScrollViewer}" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox -->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Background"               Value="{StaticResource LocalBrushRowBg}"/>
            <Setter Property="Foreground"               Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource LocalBrushBorderNeutral}"/>
            <Setter Property="BorderThickness"          Value="{DynamicResource BorderThicknessInput}"/>
            <Setter Property="Padding"                  Value="{DynamicResource PaddingInput}"/>
            <Setter Property="FontSize"                 Value="{DynamicResource FontSizeInput}"/>
            <Setter Property="Height"                   Value="{DynamicResource HeightInput}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusInput}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreen}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreen}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section label -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,8,0,3"/>
        </Style>
        <Style x:Key="MacScrollBarThumb" TargetType="Thumb">
                <Setter Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="thumb"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    Margin="2,2,2,2"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="thumb" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="thumb" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        
            <Style x:Key="MacScrollBar" TargetType="ScrollBar">
                <Setter Property="Orientation" Value="Vertical"/>
                <Setter Property="Width"       Value="8"/>
                <Setter Property="MinWidth"    Value="8"/>
                <Setter Property="Background"  Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid x:Name="GridRoot" Width="8">
                                <Track x:Name="PART_Track"
                                       Orientation="Vertical"
                                       IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource MacScrollBarThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GridRoot" Property="Width" Value="10"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        
            <Style x:Key="MacScrollViewer" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ScrollContentPresenter Grid.Column="0"
                                                        Margin="{TemplateBinding Padding}"
                                                        HorizontalAlignment="Stretch"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                           Grid.Column="1"
                                           Orientation="Vertical"
                                           Style="{StaticResource MacScrollBar}"
                                           Value="{TemplateBinding VerticalOffset}"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

    </Window.Resources>

    <DockPanel>

        <!-- == HEADER ================================================== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BrushHeaderBg}"
                CornerRadius="10,10,8,8" Padding="14,8">
            <Border.Effect><DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="2" BlurRadius="8"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Layout Builder" Foreground="{DynamicResource BrushPrimaryGreen}" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Centre controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                    <!-- Revision count -->
                    <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{StaticResource LocalBrushBorderNeutral}" BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Revisions" Foreground="{DynamicResource BrushTextMuted}" FontSize="9" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Button x:Name="rev_dec_btn" Content="&#8722;" Style="{StaticResource SmallIconButtonStyle}" Width="22" Height="22" Click="rev_dec_click"/>
                            <TextBox x:Name="rev_tb" Text="4" Width="28" Background="{StaticResource LocalBrushRowBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{StaticResource LocalBrushBorderNeutral}" BorderThickness="1" TextAlignment="Center" FontSize="11" Height="20" Padding="2" Margin="2,0" VerticalContentAlignment="Center" TextChanged="rev_changed"/>
                            <Button x:Name="rev_inc_btn" Content="+" Style="{StaticResource SmallIconButtonStyle}" Width="22" Height="22" Click="rev_inc_click"/>
                        </StackPanel>
                    </Border>

                    <!-- Page size -->
                    <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{StaticResource LocalBrushBorderNeutral}" BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Page" Foreground="{DynamicResource BrushTextMuted}" FontSize="9" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="page_cb" Style="{StaticResource ComboBoxStyle}" Width="120" Height="20" Padding="4,2" FontSize="10" SelectionChanged="page_changed">
                                <ComboBoxItem Content="A4 Portrait" Tag="a4" IsSelected="True"/>
                                <ComboBoxItem Content="A4 Landscape" Tag="a4l"/>
                                <ComboBoxItem Content="A3 Portrait" Tag="a3"/>
                                <ComboBoxItem Content="A3 Landscape" Tag="a3l"/>
                                <ComboBoxItem Content="Custom" Tag="custom"/>
                            </ComboBox>
                            <TextBox x:Name="custom_w_tb" Text="210" Width="44" Style="{StaticResource TextBoxStyle}" Height="20" Padding="3,2" FontSize="10" Margin="4,0,0,0" Visibility="Collapsed" TextChanged="custom_w_changed" ToolTip="Width in mm"/>
                            <TextBlock x:Name="custom_x_tb" Text="x" Foreground="{DynamicResource BrushTextMuted}" FontSize="9" VerticalAlignment="Center" Margin="4,0,4,0" Visibility="Collapsed"/>
                            <TextBox x:Name="custom_h_tb" Text="297" Width="44" Style="{StaticResource TextBoxStyle}" Height="20" Padding="3,2" FontSize="10" Visibility="Collapsed" TextChanged="custom_h_changed" ToolTip="Height in mm"/>
                            <TextBlock x:Name="custom_mm_tb" Text="mm" Foreground="{DynamicResource BrushTextMuted}" FontSize="9" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="page_dims_tb" Text="210x297mm" Foreground="{DynamicResource BrushTextMuted}" FontSize="9" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Template -->
                    <ComboBox x:Name="template_cb" Style="{StaticResource ComboBoxStyle}" Width="130" Margin="0,0,4,0" SelectionChanged="template_changed"/>
                    <Button Content="+ New" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,3,0" Click="add_template_click"/>
                    <Button x:Name="del_template_btn" Content="" Margin="0,0,10,0" ToolTip="Delete template" Click="del_template_click"
                            Width="22" Height="22" FontSize="10" FontWeight="Bold" Cursor="Hand"
                            Foreground="White" Background="{DynamicResource BrushDanger}" BorderThickness="0" Padding="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="11" Width="22" Height="22">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Right actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="Clear" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0" Click="clear_click"/>
                    <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0" Click="save_click"/>
                    <Button Content="Save As" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0" Click="save_as_click"/>
                    <Button Content="&#10005;" Style="{StaticResource CloseButtonStyle}" Click="close_click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- == STATUS =================================================== -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BrushHeaderBg}" Padding="14,4" BorderBrush="{StaticResource LocalBrushBorderNeutral}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="status_tb" Foreground="{DynamicResource BrushPrimaryGreen}" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock x:Name="count_tb" Text="0 rows" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- == BODY: 4-col Grid - palette fixed, canvas fills, preview fixed === -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <!-- Palette: FIXED - user cannot resize -->
                <ColumnDefinition Width="260"/>
                <!-- Divider: visual only, matches the canvas/preview splitter's
                     look but isn't a GridSplitter - only canvas<->preview resizes -->
                <ColumnDefinition Width="4"/>
                <!-- Canvas: fills ALL remaining space -->
                <ColumnDefinition Width="*" MinWidth="300"/>
                <!-- Splitter: only between canvas and preview -->
                <ColumnDefinition Width="4"/>
                <!-- Preview: fixed default, user can drag splitter -->
                <ColumnDefinition Width="320" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- PALETTE -->
            <Border Grid.Column="0" Background="{DynamicResource BrushWindowBg}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="6,6,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="pal_settings_btn"  Grid.Column="0" Content="Settings"  Style="{StaticResource TabButtonStyle}" Margin="0,0,2,0" Click="pal_tab_settings"/>
                        <Button x:Name="pal_blocks_btn"    Grid.Column="1" Content="Blocks"    Style="{StaticResource TabButtonStyle}" Margin="0,0,2,0" Click="pal_tab_blocks"/>
                        <Button x:Name="pal_options_btn"   Grid.Column="2" Content="Options"   Style="{StaticResource TabButtonStyle}" Click="pal_tab_options"/>
                    </Grid>

                    <!-- OPTIONS panel - one card is entirely static XAML,
                         the rest is populated by the same code that used to
                         also target a separate Inspector tab. That Inspector
                         tab (a different container) never rendered cards at
                         full width despite many attempts; this container's
                         cards were directly confirmed to work, so it's now
                         the only one and Inspector has been removed rather
                         than continuing to chase why the two behaved
                         differently. -->
                    <ScrollViewer x:Name="pal_options_scroll" Style="{StaticResource MacScrollViewer}"
                                  VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                                  Padding="0" Visibility="Collapsed">
                        <StackPanel Margin="8,4,8,4">
                            <TextBlock x:Name="options_header_tb" Text="Options" Style="{StaticResource SectionLabelStyle}"/>
                            <Border Background="{DynamicResource BrushCardBg}" CornerRadius="8" BorderBrush="{StaticResource LocalBrushBorderNeutral}" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                                <TextBlock x:Name="options_note_tb" Text="Static card, declared directly in XAML. Nothing here is built or touched by Python." Foreground="{DynamicResource BrushTextMuted}" FontSize="10" TextWrapping="Wrap"/>
                            </Border>
                            <StackPanel x:Name="options_dynamic_panel"/>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="pal_settings_scroll" Style="{StaticResource MacScrollViewer}" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Padding="0">
                        <StackPanel Margin="8,4,8,4">
                            <TextBlock Text="Logo" Style="{StaticResource SectionLabelStyle}"/>
                            <Border Background="{DynamicResource BrushCardBg}" CornerRadius="6" BorderBrush="{StaticResource LocalBrushBorderNeutral}" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Logo path / filename" Foreground="{DynamicResource BrushTextMuted}" FontSize="9" Margin="0,0,0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="logo_path_tb" Style="{StaticResource TextBoxStyle}" FontSize="10" Height="26"
                                                 ToolTip="Path to logo file" TextChanged="logo_path_changed"/>
                                        <Button Grid.Column="1" x:Name="logo_browse_btn" Content="..." Style="{StaticResource SecondaryButtonStyle}"
                                                Width="30" Height="26" Margin="4,0,0,0" Padding="0" Click="logo_browse_click"
                                                ToolTip="Browse for logo file"/>
                                    </Grid>
                                    <TextBlock Text="Logo will be mapped on output. Preview shows placeholder." Foreground="{DynamicResource BrushTextMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- === TEXT STYLES === -->
                            <Grid Margin="0,14,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Text Styles" Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                                <Button Grid.Column="1" Content="+ Add" Style="{StaticResource PrimaryButtonStyle}" Padding="6,2" FontSize="9" Height="20" Click="add_style_click"/>
                            </Grid>
                            <StackPanel x:Name="style_cards_stack"/>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="pal_blocks_scroll" Style="{StaticResource MacScrollViewer}" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Padding="0" Visibility="Collapsed">
                        <StackPanel x:Name="palette_stack" Margin="8,4,8,4"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- No splitter on palette - it is fixed width -->

            <!-- Palette/Canvas divider - visual only, not a GridSplitter -->
            <Border Grid.Column="1" Background="{DynamicResource BrushHeaderBg}"/>

            <!-- CANVAS - col 2, fills all remaining space -->
            <DockPanel Grid.Column="2" Background="{DynamicResource BrushWindowBg}" LastChildFill="True">
                <!-- Top row: Canvas label | A/B/C/D % pills + gear centred | + Add Row -->
                <Border x:Name="canvas_toolbar" DockPanel.Dock="Top" Height="44" Background="{DynamicResource BrushHeaderBg}" Padding="10,5" BorderBrush="{StaticResource LocalBrushBorderNeutral}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Canvas" Foreground="{DynamicResource BrushPrimaryGreen}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{StaticResource LocalBrushBorderNeutral}" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,4,0" Width="78">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" Background="{StaticResource ColA}" CornerRadius="2" Margin="0,0,4,0"/>
                                    <TextBlock Text="A" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="lbl_a" Text="18" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10"
                                             BorderThickness="0" Padding="0" MinWidth="20" Width="22" VerticalAlignment="Center"
                                             VerticalContentAlignment="Center" TextAlignment="Right"
                                             KeyDown="col_pct_keydown" LostFocus="col_pct_lostfocus" Tag="0"/>
                                    <TextBlock Text="%" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{StaticResource LocalBrushBorderNeutral}" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,4,0" Width="78">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" Background="{StaticResource ColB}" CornerRadius="2" Margin="0,0,4,0"/>
                                    <TextBlock Text="B" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="lbl_b" Text="35" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10"
                                             BorderThickness="0" Padding="0" MinWidth="20" Width="22" VerticalAlignment="Center"
                                             VerticalContentAlignment="Center" TextAlignment="Right"
                                             KeyDown="col_pct_keydown" LostFocus="col_pct_lostfocus" Tag="1"/>
                                    <TextBlock Text="%" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{StaticResource LocalBrushBorderNeutral}" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,4,0" Width="78">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" Background="{StaticResource ColC}" CornerRadius="2" Margin="0,0,4,0"/>
                                    <TextBlock Text="C" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="lbl_c" Text="17" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10"
                                             BorderThickness="0" Padding="0" MinWidth="20" Width="22" VerticalAlignment="Center"
                                             VerticalContentAlignment="Center" TextAlignment="Right"
                                             KeyDown="col_pct_keydown" LostFocus="col_pct_lostfocus" Tag="2"/>
                                    <TextBlock Text="%" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{StaticResource LocalBrushBorderNeutral}" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,8,0" Width="78" Opacity="0.85">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" Background="{StaticResource ColD}" CornerRadius="2" Margin="0,0,4,0"/>
                                    <TextBlock Text="D" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="lbl_d" Text="30" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10" VerticalAlignment="Center" MinWidth="20" Width="22" TextAlignment="Right"/>
                                    <TextBlock Text="%" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="col_settings_btn" Content="" Style="{StaticResource SmallIconButtonStyle}" FontSize="11" ToolTip="Set column widths in %" Click="col_settings_click"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="+ Add Row" Style="{StaticResource PrimaryButtonStyle}" Padding="8,3" FontSize="10" Click="add_row_click"/>
                    </Grid>
                </Border>
                <!-- Column splitter bar - Excel-style drag handles, half height -->
                <!-- Right margin (28) reserves space for row controls (up/down/close ~22px + ctrl panel margin) so splitter columns line up with canvas slot columns -->
                <Grid x:Name="col_splitter_bar" DockPanel.Dock="Top" Background="{DynamicResource BrushHeaderBg}" Height="20" Margin="6,2,28,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="csb_a" Width="18*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition x:Name="csb_b" Width="35*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition x:Name="csb_c" Width="17*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition x:Name="csb_d" Width="30*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource ColA}" Opacity="0.85" CornerRadius="3">
                        <TextBlock Text="A" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1" x:Name="splitter_ab" Background="{StaticResource LocalBrushBorderNeutral}" Cursor="SizeWE" CornerRadius="2"/>
                    <Border Grid.Column="2" Background="{StaticResource ColB}" Opacity="0.85" CornerRadius="3">
                        <TextBlock Text="B" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="3" x:Name="splitter_bc" Background="{StaticResource LocalBrushBorderNeutral}" Cursor="SizeWE" CornerRadius="2"/>
                    <Border Grid.Column="4" Background="{StaticResource ColC}" Opacity="0.85" CornerRadius="3">
                        <TextBlock Text="C" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="5" x:Name="splitter_cd" Background="{StaticResource LocalBrushBorderNeutral}" Cursor="SizeWE" CornerRadius="2"/>
                    <Border Grid.Column="6" Background="{StaticResource ColD}" Opacity="0.85" CornerRadius="3">
                        <TextBlock Text="D" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <ScrollViewer x:Name="canvas_scroll" Style="{StaticResource MacScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="canvas_stack" AllowDrop="True" Margin="6" HorizontalAlignment="Stretch"/>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource BrushHeaderBg}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

            <!-- PREVIEW - col 4 -->
            <DockPanel Grid.Column="4" Background="{DynamicResource BrushWindowBg}" LastChildFill="True">
                <Border DockPanel.Dock="Top" Height="44" Background="{DynamicResource BrushHeaderBg}" Padding="12,7" BorderBrush="{StaticResource LocalBrushBorderNeutral}" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="Live Preview" Foreground="{DynamicResource BrushPrimaryGreen}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="prev_info_tb" Text="A4 - 4 revs - dummy data" Foreground="{DynamicResource BrushTextMuted}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ScrollViewer x:Name="preview_scroll" Style="{StaticResource MacScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
                    <Border x:Name="preview_paper" Background="White" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Border.Effect><DropShadowEffect Color="Black" Opacity="0.5" ShadowDepth="4" BlurRadius="14"/></Border.Effect>
                        <StackPanel x:Name="preview_stack"/>
                    </Border>
                </ScrollViewer>
            </DockPanel>

        </Grid>
    </DockPanel>
</Window>
