<!--
===================================================================================
pyImport  –  IMPORT PREVIEW WINDOW
===================================================================================
Sections:
  1. Window / Resources
  2. Styles  –  Buttons · DataGrid
  3. Layout  –  Header (title + subtitle)
                → DataGrid content area
                → Footer (Close button, right-aligned)
===================================================================================
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Import Preview"
        Height="600"
        Width="800"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushWindowBg}"
        TextElement.FontFamily="Segoe UI">

    <!-- No OS title bar: the window's own header IS the caption, like every
         other Seed43 tool. CaptionHeight matches that header's 70px. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="70"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- ═══════════════════════════════════════════════════════════════
             COLOURS
        ═══════════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="BrushWindowBg"          Color="#3B4553"/>
        <SolidColorBrush x:Key="BrushCardBg"            Color="#2B3340"/>
        <SolidColorBrush x:Key="BrushHeaderBg"          Color="#232933"/>
        <SolidColorBrush x:Key="BrushTextPrimary"       Color="#F4FAFF"/>
        <SolidColorBrush x:Key="BrushPrimaryGreen"      Color="#208A3C"/>
        <SolidColorBrush x:Key="BrushPrimaryGreenHover"  Color="#2B933F"/>
        <SolidColorBrush x:Key="BrushPrimaryGreenPressed" Color="#1A6E2E"/>
        <SolidColorBrush x:Key="BrushSecondaryBg"       Color="#4A5568"/>
        <SolidColorBrush x:Key="BrushSecondaryHover"    Color="#5A6678"/>
        <SolidColorBrush x:Key="BrushSecondaryPressed"  Color="#3A4558"/>
        <SolidColorBrush x:Key="BrushBorderMuted"       Color="#404553"/>

        <!-- ═══════════════════════════════════════════════════════════════
             BUTTONS
        ═══════════════════════════════════════════════════════════════ -->

        <!-- Primary -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="24,8"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary  –  Close -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushSecondaryPressed}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             DATAGRID
        ═══════════════════════════════════════════════════════════════ -->
        <Style x:Key="PreviewDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background"          Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushSecondaryBg}"/>
            <Setter Property="RowBackground"       Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows"      Value="False"/>
            <Setter Property="CanUserDeleteRows"   Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows"   Value="False"/>
            <Setter Property="SelectionMode"       Value="Single"/>
            <Setter Property="HeadersVisibility"   Value="Column"/>
            <Setter Property="IsReadOnly"          Value="True"/>
            <Setter Property="FontSize"            Value="12"/>
        </Style>

        <Style x:Key="PreviewColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"                Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="Foreground"                Value="White"/>
            <Setter Property="FontWeight"                Value="SemiBold"/>
            <Setter Property="FontSize"                  Value="12"/>
            <Setter Property="Height"                    Value="40"/>
            <Setter Property="Padding"                   Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="PreviewCellStyle" TargetType="DataGridCell">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PreviewRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════════════
         LAYOUT
    ═══════════════════════════════════════════════════════════════════ -->
    <DockPanel>

        <!-- ── HEADER ─────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BrushHeaderBg}"
                Height="70"
                CornerRadius="0,0,12,12">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="2" BlurRadius="6"/>
            </Border.Effect>

            <Grid Margin="24,0,24,0">
                <Button x:Name="win_close_btn"
                        Content="&#x2716;"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="28" Height="28" FontSize="14" Cursor="Hand"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource BrushTextPrimary}"
                        ToolTip="Close"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="Import Preview"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="preview_info_tb"
                               Text="Review the data below before confirming import."
                               Foreground="{DynamicResource BrushTextPrimary}"
                               FontSize="12" Opacity="0.7"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── FOOTER  –  Close button (right-aligned) ────────────────── -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BrushHeaderBg}"
                Padding="24,16"
                BorderBrush="{DynamicResource BrushBorderMuted}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="close_btn"
                        Content="Close"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="120"
                        Click="close_window"/>
            </StackPanel>
        </Border>

        <!-- ── DATA AREA ──────────────────────────────────────────────── -->
        <Border Background="{DynamicResource BrushWindowBg}" Padding="24">
            <Border Background="{DynamicResource BrushCardBg}"
                    CornerRadius="8"
                    Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.2" ShadowDepth="2" BlurRadius="4"/>
                </Border.Effect>
                <DataGrid x:Name="preview_grid"
                          Style="{StaticResource PreviewDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource PreviewColumnHeaderStyle}"
                          CellStyle="{StaticResource PreviewCellStyle}"
                          RowStyle="{StaticResource PreviewRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Recipient (Role / Company)"
                                            Binding="{Binding Recipient}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Attention To (Company / Person)"
                                            Binding="{Binding AttentionTo}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Border>

    </DockPanel>
</Window>
