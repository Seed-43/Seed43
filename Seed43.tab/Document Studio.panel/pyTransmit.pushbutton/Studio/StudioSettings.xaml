<!--
===================================================================================
StudioSettings.xaml  -  pyTransmit Studio (Excel-style Layout Builder)
===================================================================================
Chrome: title bar + Save/Save As/Close
Ribbon: Home (format/merge/rows/cols), grouped + labelled like a real Excel ribbon
Formula bar: shows/edits the active cell's block
Body: row/column headers + free grid on the left, collapsible Blocks panel on the right
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="pyTransmit Studio"
        Height="760" Width="1180"
        MinHeight="520" MinWidth="900"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushWindowBg}"
        TextElement.FontFamily="Segoe UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54"
                             CornerRadius="10"
                             GlassFrameThickness="0"
                             ResizeBorderThickness="8"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="LocalBrushRowBg"    Color="#323D4D"/>
        <SolidColorBrush x:Key="LocalBrushHoverBg"  Color="#3A4760"/>
        <SolidColorBrush x:Key="LocalBrushBorderNeutral" Color="#404E62"/>

        <Style x:Key="PBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,4"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsPressed"   Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.65"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RibbonBtn" TargetType="ToggleButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="MinWidth"        Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource LocalBrushHoverBg}"/></Trigger>
                            <Trigger Property="IsChecked"   Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RibbonGroupCaption" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontSize"    Value="9"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin"      Value="0,3,0,0"/>
        </Style>

        <!-- ComboBox / TextBox: copied from ../Layout/LayoutSettings.xaml verbatim -
             a plain Setter-only style (no Template override) leaves WPF's
             native ComboBox chrome in place for the dropdown arrow/popup, so
             it renders as an unthemed white control regardless of the
             Background/Foreground setters above it. This full template is
             the proven fix already used by the Layout Builder. -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background"           Value="{StaticResource LocalBrushRowBg}"/>
            <Setter Property="Foreground"           Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush"          Value="{StaticResource LocalBrushBorderNeutral}"/>
            <Setter Property="BorderThickness"      Value="{DynamicResource BorderThicknessInput}"/>
            <Setter Property="Padding"              Value="{DynamicResource PaddingCombobox}"/>
            <Setter Property="FontSize"             Value="{DynamicResource FontSizeCombobox}"/>
            <Setter Property="Height"               Value="{DynamicResource HeightCombobox}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background"  Value="{DynamicResource BrushCardBg}"/>
                        <Setter Property="Foreground"  Value="{DynamicResource BrushTextPrimary}"/>
                        <Setter Property="Padding"     Value="{DynamicResource PaddingDropdownItem}"/>
                        <Setter Property="FontSize"    Value="{DynamicResource FontSizeCombobox}"/>
                        <Setter Property="Margin"      Value="4,2,4,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="{DynamicResource CornerRadiusDropdownItem}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource LocalBrushHoverBg}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="tgBd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{DynamicResource CornerRadiusCombobox}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="18"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"/>
                                                <TextBlock Grid.Column="1" Text="&#9662;"
                                                           Foreground="{DynamicResource BrushTextMuted}"
                                                           FontSize="9"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tgBd" Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreen}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,0,22,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource BrushCardBg}"
                                        BorderBrush="{StaticResource LocalBrushBorderNeutral}"
                                        CornerRadius="{DynamicResource CornerRadiusDropdownPopup}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.4" ShadowDepth="3" BlurRadius="8"/>
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Background"               Value="{StaticResource LocalBrushRowBg}"/>
            <Setter Property="Foreground"               Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource LocalBrushBorderNeutral}"/>
            <Setter Property="BorderThickness"          Value="{DynamicResource BorderThicknessInput}"/>
            <Setter Property="Padding"                  Value="{DynamicResource PaddingInput}"/>
            <Setter Property="FontSize"                 Value="{DynamicResource FontSizeInput}"/>
            <Setter Property="Height"                   Value="{DynamicResource HeightInput}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusInput}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreen}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreen}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ── Title bar ─────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Height="54" Background="{DynamicResource BrushHeaderBg}">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="pyTransmit Studio" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="active_file_label" Text=""  Margin="12,0,0,0" FontSize="11"
                               Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="Template" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                    <ComboBox x:Name="template_combo" Style="{StaticResource ComboBoxStyle}" Width="150" Margin="0,0,4,0"/>
                    <Button x:Name="tmpl_delete_btn" Content="✕" Style="{StaticResource PBtn}" Width="26" Padding="0"
                            Margin="0,0,10,0" ToolTip="Delete the selected template"/>
                    <Button x:Name="refresh_btn" Content="Refresh Live Data" Style="{StaticResource PBtn}" Margin="4,0" Click="refresh_click"/>
                    <Button x:Name="new_btn"     Content="New"      Style="{StaticResource PBtn}" Margin="4,0" Click="new_click"/>
                    <Button x:Name="save_btn"    Content="Save"     Style="{StaticResource PBtn}" Margin="4,0" Click="save_click"/>
                    <Button x:Name="save_as_btn" Content="Save As"  Style="{StaticResource PBtn}" Margin="4,0" Click="save_as_click"/>
                    <Button x:Name="close_btn"   Content="✕"        Style="{StaticResource PBtn}" Margin="12,0,0,0" Width="30" Click="close_click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Ribbon: Home (grouped + labelled like a real Excel ribbon) ──────── -->
        <Border x:Name="ribbon_home" DockPanel.Dock="Top" Height="88" Background="{DynamicResource BrushHeaderBg}"
                BorderBrush="{StaticResource LocalBrushBorderNeutral}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="10,4" VerticalAlignment="Stretch">

                <!-- Font + Alignment stacked in one column: alignment sits
                     under the font row rather than beside it, which frees a
                     good chunk of ribbon width for the groups to the right. -->
                <StackPanel Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="font_family_combo" Style="{StaticResource ComboBoxStyle}" Width="100" Margin="0,0,4,0"/>
                        <ComboBox x:Name="font_size_combo"    Style="{StaticResource ComboBoxStyle}" Width="50"  Margin="0,0,6,0"/>
                        <ToggleButton x:Name="bold_btn"      Content="B" Style="{StaticResource RibbonBtn}" FontWeight="Bold"/>
                        <ToggleButton x:Name="italic_btn"    Content="I" Style="{StaticResource RibbonBtn}" FontStyle="Italic"/>
                        <ToggleButton x:Name="underline_btn" Content="U" Style="{StaticResource RibbonBtn}"/>
                        <Button x:Name="font_color_btn" Content="A" Style="{StaticResource PBtn}" Width="26" Padding="0" Margin="6,0,0,0"/>
                        <Button x:Name="fill_color_btn" Content="Fill" Style="{StaticResource PBtn}" Width="40" Padding="0" Margin="4,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <ToggleButton x:Name="align_left_btn"   Style="{StaticResource RibbonBtn}" ToolTip="Align left"/>
                        <ToggleButton x:Name="align_center_btn" Style="{StaticResource RibbonBtn}" ToolTip="Align centre"/>
                        <ToggleButton x:Name="align_right_btn"  Style="{StaticResource RibbonBtn}" ToolTip="Align right"/>
                        <ToggleButton x:Name="valign_top_btn" Style="{StaticResource RibbonBtn}" Margin="8,0,0,0" ToolTip="Align top"/>
                        <ToggleButton x:Name="valign_mid_btn" Style="{StaticResource RibbonBtn}" ToolTip="Align middle"/>
                        <ToggleButton x:Name="valign_bot_btn" Style="{StaticResource RibbonBtn}" ToolTip="Align bottom"/>
                    </StackPanel>
                    <TextBlock Text="Font &amp; Alignment" Style="{StaticResource RibbonGroupCaption}"/>
                </StackPanel>
                <Rectangle Width="1" Fill="{StaticResource LocalBrushBorderNeutral}" Margin="0,2,10,2"/>

                <!-- Borders: Excel/Calc-style split button with an icon-grid dropdown -->
                <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="borders_btn" Style="{StaticResource RibbonBtn}" Padding="6,4" Width="Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⊞" FontSize="14" Margin="0,0,4,0"/>
                                <TextBlock Text="▾" FontSize="8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <Popup x:Name="borders_popup" PlacementTarget="{Binding ElementName=borders_btn}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{StaticResource LocalBrushBorderNeutral}"
                                    BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Borders" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" Margin="2,0,0,6"/>
                                    <UniformGrid x:Name="borders_grid" Columns="3"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                    <TextBlock Text="Borders" Style="{StaticResource RibbonGroupCaption}"/>
                </StackPanel>
                <Rectangle Width="1" Fill="{StaticResource LocalBrushBorderNeutral}" Margin="0,2,10,2"/>

                <!-- Cells -->
                <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="merge_toggle_btn" Content="Merge Cells" Style="{StaticResource RibbonBtn}" Padding="8,4"/>
                    </StackPanel>
                    <TextBlock Text="Cells" Style="{StaticResource RibbonGroupCaption}"/>
                </StackPanel>
                <Rectangle Width="1" Fill="{StaticResource LocalBrushBorderNeutral}" Margin="0,2,10,2"/>

                <!-- Size -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Row H" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="row_h_box" Style="{StaticResource TextBoxStyle}" Width="36" Margin="0,0,8,0"/>
                        <TextBlock Text="Col W" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="col_w_box" Style="{StaticResource TextBoxStyle}" Width="36" Margin="0,0,8,0"/>
                        <Button x:Name="fit_width_btn" Content="Fit Width" Style="{StaticResource PBtn}" Margin="0,0,4,0"
                                ToolTip="Scale every column proportionally to fill the printable width"/>
                        <Button x:Name="distribute_btn" Content="Distribute" Style="{StaticResource PBtn}"
                                ToolTip="Make the selected columns equal width (all columns if none selected)"/>
                    </StackPanel>
                    <TextBlock Text="Size (mm) - or drag a header edge" Style="{StaticResource RibbonGroupCaption}"/>
                </StackPanel>
                <Rectangle Width="1" Fill="{StaticResource LocalBrushBorderNeutral}" Margin="0,2,10,2"/>

                <!-- Page Layout: print size + orientation, with a page-boundary
                     overlay on the canvas so the sheet shows what will actually
                     fit on one printed page, the way Excel's own Page Layout /
                     Page Break Preview views do. -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="page_size_combo" Style="{StaticResource ComboBoxStyle}" Width="80" Margin="0,0,4,0"/>
                        <ComboBox x:Name="page_orientation_combo" Style="{StaticResource ComboBoxStyle}" Width="90" Margin="0,0,8,0"/>
                        <TextBlock Text="Margin" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="margin_box" Style="{StaticResource TextBoxStyle}" Width="34"
                                 ToolTip="Margin on each side, in mm"/>
                    </StackPanel>
                    <TextBlock Text="Page Layout" Style="{StaticResource RibbonGroupCaption}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Formula bar ──────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Height="34" Background="{DynamicResource BrushCardBg}"
                BorderBrush="{StaticResource LocalBrushBorderNeutral}" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,4">
                <TextBlock x:Name="formula_cell_label" Text="A1" Width="50" FontWeight="Bold"
                           Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <Rectangle Width="1" Fill="{StaticResource LocalBrushBorderNeutral}" Margin="6,0" DockPanel.Dock="Left"/>
                <Button x:Name="formula_change_btn" Content="Change block…" Style="{StaticResource PBtn}"
                        DockPanel.Dock="Right" Margin="6,0,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="section_label" DockPanel.Dock="Right" VerticalAlignment="Center"
                           FontSize="11" FontWeight="SemiBold" Margin="10,0,4,0" Visibility="Collapsed"/>
                <TextBox x:Name="formula_bar_tb" Style="{StaticResource TextBoxStyle}" BorderThickness="0" Background="Transparent"/>
            </DockPanel>
        </Border>

        <!-- ── Status bar (with a persistent zoom indicator, like Excel's) ───── -->
        <Border DockPanel.Dock="Bottom" Height="26" Background="{DynamicResource BrushHeaderBg}">
            <DockPanel Margin="12,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="zoom_out_btn"   Content="−"    Style="{StaticResource PBtn}" Width="22" Height="18" Padding="0" FontSize="11"/>
                    <TextBlock x:Name="zoom_label" Text="100%" Width="46" TextAlignment="Center" VerticalAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                    <Button x:Name="zoom_in_btn"    Content="+"    Style="{StaticResource PBtn}" Width="22" Height="18" Padding="0" FontSize="11"/>
                    <Button x:Name="zoom_reset_btn" Content="100%" Style="{StaticResource PBtn}" Height="18" Padding="6,0" Margin="6,0,0,0" FontSize="10"/>
                </StackPanel>
                <TextBlock x:Name="status_label" Text="Ready" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource BrushTextMuted}"/>
            </DockPanel>
        </Border>

        <!-- ── Grid body (left) + collapsible Blocks panel (right) ─────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="blocks_col" Width="230"/>
            </Grid.ColumnDefinitions>

            <!-- Frozen headers: four quadrants. The corner never moves, the
                 column headers scroll horizontally only, the row headers
                 scroll vertically only, and the cell area scrolls both -
                 its ScrollChanged drives the other two (wired in Python).
                 Excel's frozen-panes behaviour. -->
            <Grid Grid.Column="0" Margin="16" Background="{DynamicResource BrushWindowBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="corner_host" Grid.Row="0" Grid.Column="0" Background="#2B3340"
                        BorderBrush="#404E62" BorderThickness="0,0,1,1"/>

                <ScrollViewer x:Name="colhdr_scroll" Grid.Row="0" Grid.Column="1"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="colhdr_root"/>
                </ScrollViewer>

                <ScrollViewer x:Name="rowhdr_scroll" Grid.Row="1" Grid.Column="0"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="rowhdr_root"/>
                </ScrollViewer>

                <ScrollViewer x:Name="grid_scroll" Grid.Row="1" Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="grid_root"/>
                </ScrollViewer>
            </Grid>

            <Border Grid.Column="1" Background="{DynamicResource BrushHeaderBg}"
                    BorderBrush="{StaticResource LocalBrushBorderNeutral}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="30">
                        <TextBlock x:Name="blocks_title_label" Text="Blocks" Margin="10,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="12"/>
                        <ToggleButton x:Name="blocks_collapse_btn" Content="»" Style="{StaticResource RibbonBtn}"
                                      HorizontalAlignment="Right" Margin="0,0,4,0" Width="24"/>
                    </Grid>
                    <ScrollViewer x:Name="blocks_scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="blocks_panel_content" Margin="8" Orientation="Vertical"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

    </DockPanel>
</Window>
