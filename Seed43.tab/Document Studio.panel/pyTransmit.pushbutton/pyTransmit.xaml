        <!-- CardStyle stays local for now: it carries a Margin and
             DropShadowEffect the canonical Seed43Styles.xaml CardStyle
             doesn't have yet - removing it here first would silently drop
             both. Needs the generator fixed to include them before this
             can safely move to the shared file. -->
        <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background"    Value="{DynamicResource BrushCardBg}"/>
                <Setter Property="CornerRadius"  Value="{DynamicResource CornerRadiusCard}"/>
                <Setter Property="Padding"       Value="{DynamicResource PaddingCard}"/>
                <Setter Property="Margin"        Value="0,0,0,12"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="Black" Opacity="0.2" ShadowDepth="2" BlurRadius="4"/>
                    </Setter.Value>
                </Setter>
            </Style>

        <!-- SectionLabelStyle / FieldLabelStyle: kept local. Every real
             usage throughout this file is Style="{StaticResource ...}",
