                                    Cursor="Hand" Margin="0,0,8,0"/>
                            <TextBlock x:Name="group_label_toggle_tb" DockPanel.Dock="Left"
                                       Text="Text Off" FontSize="9"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                        </DockPanel>
                        <StackPanel x:Name="formatting_stack">
                            <ComboBox x:Name="sheet_param_cb_1" Style="{StaticResource ComboBoxStyle}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="sheet_param_cb_2" Style="{StaticResource ComboBoxStyle}" Visibility="Collapsed"/>
                            <ComboBox x:Name="sheet_param_cb_3" Style="{StaticResource ComboBoxStyle}" Visibility="Collapsed"/>
                            <ComboBox x:Name="sheet_param_cb_4" Style="{StaticResource ComboBoxStyle}" Visibility="Collapsed"/>
                            <ComboBox x:Name="sheet_param_cb_5" Style="{StaticResource ComboBoxStyle}" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Recipients Card — mode controlled by Setup -->
                <TextBlock Text="Recipients" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>

                        <!-- DISTRIBUTION LIST mode: fixed rows from distribution.json -->
                        <StackPanel x:Name="dist_list_section" Visibility="Collapsed">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Distribution"  Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                                <TextBlock Grid.Column="1" Text="Attention To"  Style="{StaticResource SectionLabelStyle}" Margin="6,0,6,0"/>
                                <TextBlock Grid.Column="2" Text="Copies"        Style="{StaticResource SectionLabelStyle}" HorizontalAlignment="Center" Margin="0"/>
                            </Grid>
                            <!-- rows injected here by _build_dist_rows() -->
                            <StackPanel x:Name="dist_rows_stack"/>
                        </StackPanel>

                        <!-- CLIENT LIST mode: dynamic dropdowns from recipients.json -->
                        <StackPanel x:Name="client_list_section" Visibility="Collapsed">
                            <!-- rows injected here by _build_client_rows() -->
                            <StackPanel x:Name="client_rows_stack"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Overlay for modal -->
        <Border x:Name="Overlay" 
                Background="#000000" 
                Opacity="0.6" 
                Visibility="Collapsed"
                Panel.ZIndex="999"/>

        <!-- ══════════════════════════════════════════════════════════
             SETUP PANEL
        ══════════════════════════════════════════════════════════ -->
        <Grid x:Name="SetupPanel"
              Grid.Row="1"
              Margin="0,0,0,0"
              Background="{DynamicResource BrushWindowBg}"
              Visibility="Collapsed"
              Panel.ZIndex="50"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch">
            <ScrollViewer Style="{StaticResource MacScrollViewer}" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <StackPanel Margin="24,12,24,24" HorizontalAlignment="Stretch">

                    <!-- Project Settings section -->
                    <TextBlock Text="Project Settings" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Choose which fields appear in the main window. These settings control the main window display only and do not affect export."
                                       Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" Opacity="0.65"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Left column: project info fields -->
                                <StackPanel Grid.Column="0">
                                    <CheckBox x:Name="setup_from_cb"        Content="Organisation"  Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" Margin="0,0,0,8"  Checked="setup_fields_changed" Unchecked="setup_fields_changed"/>
                                    <CheckBox x:Name="setup_client_info_cb" Content="Client"        Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" Margin="0,0,0,8"  Checked="setup_fields_changed" Unchecked="setup_fields_changed"/>
                                    <CheckBox x:Name="setup_projno_cb"      Content="Project No."   Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" Margin="0,0,0,8"  Checked="setup_fields_changed" Unchecked="setup_fields_changed"/>
                                    <CheckBox x:Name="setup_projname_cb"    Content="Project"       Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" Margin="0,0,0,0"  Checked="setup_fields_changed" Unchecked="setup_fields_changed"/>
                                </StackPanel>
                                <!-- Right column: revision meta fields -->
                                <StackPanel Grid.Column="1">
                                    <CheckBox x:Name="setup_initials_cb"  Content="Issued By"         Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" Margin="0,0,0,8"  Checked="setup_fields_changed" Unchecked="setup_fields_changed"/>
                                    <CheckBox x:Name="setup_reason_cb"   Content="Reason for Issue"  Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" Margin="0,0,0,8"  Checked="setup_fields_changed" Unchecked="setup_fields_changed"/>
                                    <CheckBox x:Name="setup_method_cb"   Content="Method of Issue"   Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" Margin="0,0,0,8"  Checked="setup_fields_changed" Unchecked="setup_fields_changed"/>
                                    <CheckBox x:Name="setup_format_cb"   Content="Document Type"     Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" Margin="0,0,0,8"  Checked="setup_fields_changed" Unchecked="setup_fields_changed"/>
                                    <CheckBox x:Name="setup_printsize_cb" Content="Print Size"       Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" Margin="0,0,0,0"  Checked="setup_fields_changed" Unchecked="setup_fields_changed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Recipients section -->
                    <TextBlock Text="Recipients" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Choose how recipients are selected in the main window."
                                       Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" Opacity="0.65"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <!-- Distribution List radio-style option -->
                            <Border Background="{DynamicResource BrushWindowBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <RadioButton x:Name="setup_dist_rb"
                                                 Content="Distribution List"
                                                 GroupName="RecipientMode"
                                                 Foreground="{DynamicResource BrushTextPrimary}"
												 FontSize="12"
												 FontWeight="SemiBold"
                                                 Margin="0,0,0,0"
                                                 Checked="setup_mode_changed"/>
                                    <TextBlock Text="Fixed rows from your Distribution List."
                                               Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" Opacity="0.65"
                                               TextWrapping="Wrap" Margin="20,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Client List radio-style option -->
                            <Border Background="{DynamicResource BrushWindowBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,0">
                                <StackPanel>
                                    <RadioButton x:Name="setup_client_rb"
                                                 Content="Client List"
                                                 GroupName="RecipientMode"
                                                 Foreground="{DynamicResource BrushTextPrimary}"
												 FontSize="12"
												 FontWeight="SemiBold"
                                                 Margin="0,0,0,0"
                                                 Checked="setup_mode_changed"/>
                                    <TextBlock Text="Dynamic dropdowns from your Client List."
                                               Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" Opacity="0.65"
                                               TextWrapping="Wrap" Margin="20,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- Transmittal Export Format section moved to ExportFormatPanel -->


                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             EXPORT FORMAT PANEL
        ══════════════════════════════════════════════════════════ -->
        <Grid x:Name="ExportFormatPanel"
              Grid.Row="1"
              Margin="0,0,0,0"
              Background="{DynamicResource BrushWindowBg}"
              Visibility="Collapsed"
              Panel.ZIndex="50"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch">
            <ScrollViewer Margin="24,12,24,24" Style="{StaticResource MacScrollViewer}" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <StackPanel HorizontalAlignment="Stretch">

                    <!-- Export Format card -->
                    <TextBlock Text="Transmittal Export Format" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Choose which formats are generated when 'Export Revit Data' runs."
                                       Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" Opacity="0.65"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <!-- Revit Schedule -->
                            <Border Background="{DynamicResource BrushWindowBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="setup_output_schedule_cb"
                                                     IsChecked="True"
                                                     Content="Revit Schedule"
                                                     Foreground="{DynamicResource BrushTextPrimary}"
                                                     FontSize="12"
                                                     FontWeight="SemiBold"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,12,0"
                                                     Grid.Column="0"
                                                     Checked="setup_fields_changed"
                                                     Unchecked="setup_fields_changed"/>
                                        <ComboBox x:Name="layout_schedule_cb"
                                                  Grid.Column="1" Height="24" FontSize="11"
                                                  Style="{StaticResource ComboBoxStyle}"
                                                  Margin="8,0,0,0"
                                                  SelectionChanged="layout_assignment_changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Revit Drafting View -->
                            <Border Background="{DynamicResource BrushWindowBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="setup_output_drafting_cb"
                                                     Content="Revit Drafting View"
                                                     Foreground="{DynamicResource BrushTextPrimary}"
                                                     FontSize="12"
                                                     FontWeight="SemiBold"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,12,0"
                                                     Grid.Column="0"
                                                     Checked="setup_fields_changed"
                                                     Unchecked="setup_fields_changed"/>
                                        <ComboBox x:Name="layout_drafting_cb"
                                                  Grid.Column="1" Height="24" FontSize="11"
                                                  Style="{StaticResource ComboBoxStyle}"
                                                  Margin="8,0,0,0"
                                                  SelectionChanged="layout_assignment_changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Revit Legend -->
                            <Border Background="{DynamicResource BrushWindowBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="setup_output_legend_cb"
                                                     Content="Revit Legend"
                                                     Foreground="{DynamicResource BrushTextPrimary}"
                                                     FontSize="12"
                                                     FontWeight="SemiBold"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,12,0"
                                                     Grid.Column="0"
                                                     Checked="setup_fields_changed"
                                                     Unchecked="setup_fields_changed"/>
                                        <ComboBox x:Name="layout_legend_cb"
                                                  Grid.Column="1" Height="24" FontSize="11"
                                                  Style="{StaticResource ComboBoxStyle}"
                                                  Margin="8,0,0,0"
                                                  SelectionChanged="layout_assignment_changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Excel -->
                            <Border Background="{DynamicResource BrushWindowBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="setup_output_excel_cb"
                                                     Content="Excel"
                                                     Foreground="{DynamicResource BrushTextPrimary}"
                                                     FontSize="12"
                                                     FontWeight="SemiBold"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,12,0"
                                                     Grid.Column="0"
                                                     Checked="setup_fields_changed"
                                                     Unchecked="setup_fields_changed"/>
                                        <ComboBox x:Name="layout_excel_cb"
                                                  Grid.Column="1" Height="24" FontSize="11"
                                                  Style="{StaticResource ComboBoxStyle}"
                                                  Margin="8,0,0,0"
                                                  SelectionChanged="layout_assignment_changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- PDF -->
                            <Border Background="{DynamicResource BrushWindowBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="setup_output_pdf_cb"
                                                     Content="PDF"
                                                     Foreground="{DynamicResource BrushTextPrimary}"
                                                     FontSize="12"
                                                     FontWeight="SemiBold"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,12,0"
                                                     Grid.Column="0"
                                                     Checked="setup_fields_changed"
                                                     Unchecked="setup_fields_changed"/>
                                        <ComboBox x:Name="layout_pdf_cb"
                                                  Grid.Column="1" Height="24" FontSize="11"
                                                  Style="{StaticResource ComboBoxStyle}"
                                                  Margin="8,0,0,0"
                                                  SelectionChanged="layout_assignment_changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>


                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             BRANDING & STYLING PANEL
        ══════════════════════════════════════════════════════════ -->
        <Grid x:Name="StylingPanel"
              Grid.Row="1"
              Margin="0,0,0,0"
              Background="{DynamicResource BrushWindowBg}"
              Visibility="Collapsed"
              Panel.ZIndex="50"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch">
            <ScrollViewer Style="{StaticResource MacScrollViewer}" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <StackPanel Margin="24,12,24,24" HorizontalAlignment="Stretch">

                    <!-- Logo section -->
                    <TextBlock Text="Logo" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Set the network/shared path to your logo file. pyTransmit will automatically copy it to the Settings folder when the location is reachable."
                                       Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" Opacity="0.65"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <!-- Source path only — local cache is automatic (Settings/logo.ext) -->
                            <TextBlock Text="Logo Source Location (network / shared drive):"
                                       Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" Opacity="0.85" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="logo_source_tb"
                                         Grid.Column="0"
                                         Height="28"
                                         Padding="6,4"
                                         Margin="0,0,6,0"
                                         Background="{DynamicResource BrushInputBg}" Foreground="{DynamicResource BrushTextInput}"
                                         BorderBrush="{DynamicResource BrushBorderDefault}" BorderThickness="1"
                                         FontSize="11"
                                         ToolTip="Network/UNC path to your logo. pyTransmit will copy it to the Settings folder automatically whenever this location is reachable."/>
                                <Button x:Name="logo_source_browse_btn"
                                        Grid.Column="1" Content="Browse&#x2026;"
                                        Style="{StaticResource SmallButtonStyle}"
                                        Width="72" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="logo_status_lbl"
                                       Text=""
                                       Foreground="{DynamicResource LocalBrushNoticeText}"
                                       FontSize="10"
                                       Opacity="0.85"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Title Bar Colour -->
                    <TextBlock Text="Title Bar Colour" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Background and text colour of the Transmittal Document title row."
                                       Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" Opacity="0.65"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <!-- Background -->
                            <TextBlock Text="Background" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10" Opacity="0.55" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="title_color_swatch"
                                        Grid.Column="0"
                                        Width="32" Height="28"
                                        CornerRadius="4"
                                        Margin="0,0,8,0"
                                        Background="#314461"
                                        BorderBrush="{DynamicResource BrushBorderDefault}" BorderThickness="1"/>
                                <TextBox x:Name="title_color_tb"
                                         Grid.Column="1"
                                         Height="28" Padding="6,4" Margin="0,0,6,0"
                                         Background="{DynamicResource BrushInputBg}" Foreground="{DynamicResource BrushTextInput}"
                                         BorderBrush="{DynamicResource BrushBorderDefault}" BorderThickness="1"
                                         FontSize="11" Text="#314461"
                                         ToolTip="Hex colour e.g. #314461"/>
                                <Button x:Name="title_color_reset_btn"
                                        Grid.Column="2" Content="Reset"
                                        Style="{StaticResource SmallButtonStyle}"
                                        Width="60" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Text Colour -->
                            <TextBlock Text="Text Colour" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10" Opacity="0.55" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="title_fg_color_swatch"
                                        Grid.Column="0"
                                        Width="32" Height="28"
                                        CornerRadius="4"
                                        Margin="0,0,8,0"
                                        Background="#FFFFFF"
                                        BorderBrush="{DynamicResource BrushBorderDefault}" BorderThickness="1"/>
                                <TextBox x:Name="title_fg_color_tb"
                                         Grid.Column="1"
                                         Height="28" Padding="6,4" Margin="0,0,6,0"
                                         Background="{DynamicResource BrushInputBg}" Foreground="{DynamicResource BrushTextInput}"
                                         BorderBrush="{DynamicResource BrushBorderDefault}" BorderThickness="1"
                                         FontSize="11" Text="#FFFFFF"
                                         ToolTip="Hex colour e.g. #FFFFFF"/>
                                <Button x:Name="title_fg_color_reset_btn"
                                        Grid.Column="2" Content="Reset"
                                        Style="{StaticResource SmallButtonStyle}"
                                        Width="60" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Column Header Colour -->
                    <TextBlock Text="Column Header Colour" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,24">
                        <StackPanel>
                            <TextBlock Text="Background and text colour of column header rows (Sent To, Sheet, Revision etc)."
                                       Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" Opacity="0.65"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <!-- Background -->
                            <TextBlock Text="Background" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10" Opacity="0.55" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="header_color_swatch"
                                        Grid.Column="0"
                                        Width="32" Height="28"
                                        CornerRadius="4"
                                        Margin="0,0,8,0"
                                        Background="#FFFFFF"
                                        BorderBrush="{DynamicResource BrushBorderDefault}" BorderThickness="1"/>
                                <TextBox x:Name="header_color_tb"
                                         Grid.Column="1"
                                         Height="28" Padding="6,4" Margin="0,0,6,0"
                                         Background="{DynamicResource BrushInputBg}" Foreground="{DynamicResource BrushTextInput}"
                                         BorderBrush="{DynamicResource BrushBorderDefault}" BorderThickness="1"
                                         FontSize="11" Text="#FFFFFF"
                                         ToolTip="Hex colour e.g. #FFFFFF"/>
                                <Button x:Name="header_color_reset_btn"
                                        Grid.Column="2" Content="Reset"
                                        Style="{StaticResource SmallButtonStyle}"
                                        Width="60" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Text Colour -->
                            <TextBlock Text="Text Colour" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10" Opacity="0.55" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="header_fg_color_swatch"
                                        Grid.Column="0"
                                        Width="32" Height="28"
                                        CornerRadius="4"
                                        Margin="0,0,8,0"
                                        Background="#000000"
                                        BorderBrush="{DynamicResource BrushBorderDefault}" BorderThickness="1"/>
                                <TextBox x:Name="header_fg_color_tb"
                                         Grid.Column="1"
                                         Height="28" Padding="6,4" Margin="0,0,6,0"
                                         Background="{DynamicResource BrushInputBg}" Foreground="{DynamicResource BrushTextInput}"
                                         BorderBrush="{DynamicResource BrushBorderDefault}" BorderThickness="1"
                                         FontSize="11" Text="#000000"
                                         ToolTip="Hex colour e.g. #000000"/>
                                <Button x:Name="header_fg_color_reset_btn"
                                        Grid.Column="2" Content="Reset"
                                        Style="{StaticResource SmallButtonStyle}"
                                        Width="60" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Info note: settings auto-save when panel is closed -->

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             RECIPIENT PANEL  (two tabs: Client List | Distribution List)
        ══════════════════════════════════════════════════════════ -->
        <Grid x:Name="RecipientPanel"
              Grid.Row="1"
              Background="{DynamicResource BrushWindowBg}"
              Margin="0,0,0,0"
              Visibility="Collapsed"
              Panel.ZIndex="51"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Import from CSV / Excel — always visible, same as Options Manager -->
            <StackPanel Grid.Row="0" Margin="24,12,24,0">
                <TextBlock Text="Import from CSV / Excel" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="File Path" Style="{StaticResource FieldLabelStyle}"/>
                        <DockPanel Margin="0,0,0,0">
                            <Button x:Name="rec_browse_file_btn" Content="Browse"
                                    Style="{StaticResource SmallButtonStyle}"
                                    DockPanel.Dock="Right" Margin="8,0,0,0" Width="80"/>
                            <TextBox x:Name="rec_file_path_tb"
                                     Style="{StaticResource TextBoxStyle}" IsReadOnly="True"/>
                        </DockPanel>
                        <TextBlock Text="Column Mapping" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Text="Map your CSV / Excel columns to the database fields"
                                   Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" Opacity="0.7" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Map to Company:"
                                       Style="{StaticResource FieldLabelStyle}"
                                       VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <ComboBox x:Name="rec_recipient_mapping_cb"
                                      Grid.Row="0" Grid.Column="1"
                                      Style="{StaticResource ComboBoxStyle}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Map to Attention To:"
                                       Style="{StaticResource FieldLabelStyle}"
