<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        Topmost="True"
        Width="560"
        Height="660"
        MinWidth="460"
        MinHeight="480"
        Title="Param Map - one at a time"
        Background="{DynamicResource BrushWindowBg}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Fallbacks only; seed43_theme injects the live palette after the
             XAML has parsed, which is what makes DynamicResource the only
             usable binding here. Values match the dark profile so an
             unreadable palette file still looks whole. -->
        <SolidColorBrush x:Key="BrushWindowBg"            Color="#3B4553"/>
        <SolidColorBrush x:Key="BrushCardBg"              Color="#2B3340"/>
        <SolidColorBrush x:Key="BrushHeaderBg"            Color="#232933"/>
        <SolidColorBrush x:Key="BrushPrimaryGreen"        Color="#208A3C"/>
        <SolidColorBrush x:Key="BrushPrimaryGreenHover"   Color="#32934C"/>
        <SolidColorBrush x:Key="BrushTextPrimary"         Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushTextMuted"           Color="#9CA3AF"/>
        <SolidColorBrush x:Key="BrushInputBg"             Color="#1D1D20"/>
        <SolidColorBrush x:Key="BrushBorderDefault"       Color="#208A3C"/>
        <SolidColorBrush x:Key="BrushSecondaryBg"         Color="#48484B"/>
        <SolidColorBrush x:Key="BrushSecondaryHover"      Color="#515155"/>
        <SolidColorBrush x:Key="BrushSecondaryDisabledBg" Color="#2E2E32"/>
        <SolidColorBrush x:Key="BrushSecondaryDisabledFg" Color="#77767B"/>
        <SolidColorBrush x:Key="BrushDropdownItemHover"   Color="#3F3F41"/>
        <SolidColorBrush x:Key="BrushSelectedRowBg"       Color="#08230F"/>
        <SolidColorBrush x:Key="BrushDanger"              Color="#E01B24"/>
        <SolidColorBrush x:Key="BrushSuccess"             Color="#27AE60"/>
        <SolidColorBrush x:Key="BrushWarning"             Color="#E5A50A"/>

        <CornerRadius x:Key="CornerRadiusCard"     >8</CornerRadius>
        <CornerRadius x:Key="CornerRadiusInput"    >6</CornerRadius>
        <CornerRadius x:Key="CornerRadiusButton"   >10</CornerRadius>
        <Thickness    x:Key="PaddingCard"          >16</Thickness>
        <Thickness    x:Key="PaddingButtonPrimary" >15,7,15,7</Thickness>
        <sys:Double   x:Key="FontSizeInput"        >12</sys:Double>
        <sys:Double   x:Key="FontSizeFieldLabel"   >12</sys:Double>
        <sys:Double   x:Key="FontSizeSectionLabel" >14</sys:Double>
        <sys:Double   x:Key="FontSizeButton"       >12</sys:Double>

        <!-- ── TEXT ──────────────────────────────────────────────────── -->
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeSectionLabel}"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeFieldLabel}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,10,0"/>
        </Style>

        <!-- ── INPUTS ────────────────────────────────────────────────── -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeInput}"/>
            <Setter Property="Padding"         Value="7,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Background"      Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeInput}"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                        <Setter Property="Padding"    Value="8,5"/>
                        <Setter Property="Cursor"     Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="Transparent"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource BrushDropdownItemHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource BrushInputBg}"
                                                BorderBrush="{DynamicResource BrushBorderDefault}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource CornerRadiusInput}">
                                            <Path x:Name="Arrow"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{DynamicResource BrushPrimaryGreen}"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="10,0,26,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource BrushInputBg}"
                                        BorderBrush="{DynamicResource BrushBorderDefault}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource CornerRadiusInput}"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="320"
                                        Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeInput}"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>

        <!-- ── LIST ──────────────────────────────────────────────────── -->
        <Style x:Key="ListRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeInput}"/>
            <Setter Property="Padding"    Value="6,4"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushDropdownItemHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushSelectedRowBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultList" TargetType="ListBox">
            <Setter Property="Background"      Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="4"/>
            <Setter Property="SelectionMode"   Value="Single"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ListRow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusInput}">
                            <ScrollViewer Padding="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── BUTTONS ───────────────────────────────────────────────── -->
        <Style x:Key="GreenBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeButton}"/>
            <Setter Property="Padding"         Value="{DynamicResource PaddingButtonPrimary}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButton}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreyBtn" TargetType="Button" BasedOn="{StaticResource GreenBtn}">
            <Setter Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButton}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushSecondaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCtrlCloseBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="30"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushDanger}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- ── HEADER ────────────────────────────────── -->
        <Border Background="{DynamicResource BrushHeaderBg}"
                Height="56"
                DockPanel.Dock="Top"
                CornerRadius="0,0,12,12">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3"
                                  ShadowDepth="2" BlurRadius="6"/>
            </Border.Effect>
            <Grid Margin="18,0,14,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <TextBlock Text="Param" FontWeight="Bold" FontSize="22"
                               Foreground="{DynamicResource BrushPrimaryGreen}"/>
                    <TextBlock Text="Map" FontWeight="Bold" FontSize="22"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="one at a time" FontSize="14"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               Opacity="0.6"
                               VerticalAlignment="Bottom" Margin="10,0,0,3"/>
                </StackPanel>
                <Button x:Name="win_close_btn"
                        Content="&#10005;"
                        Style="{StaticResource WinCtrlCloseBtn}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTip="Stop the walk and close"
                        Click="stop_clicked"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <!-- ── FOOTER ────────────────────────────────── -->
        <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,16">
            <TextBlock x:Name="status_tb" Style="{StaticResource Hint}"
                       Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="show_btn" Content="Show" Width="82"
                        Style="{StaticResource GreyBtn}" Margin="0,0,8,0"
                        ToolTip="Open this element's view again and frame it"
                        Click="show_clicked"/>
                <Button x:Name="skip_btn" Content="Leave it" Width="92"
                        Style="{StaticResource GreyBtn}" Margin="0,0,8,0"
                        ToolTip="Leave this one on the old family and move on"
                        Click="skip_clicked"/>
                <Button x:Name="swap_btn" Content="Swap this one" Width="128"
                        Style="{StaticResource GreenBtn}" Margin="0,0,8,0"
                        ToolTip="Change this element and let Revit apply the fixes listed above"
                        Click="swap_clicked"/>
                <Button x:Name="next_btn" Content="Next" Width="92"
                        Style="{StaticResource GreenBtn}" Margin="0,0,8,0"
                        ToolTip="Done re-dimensioning. Go to the next element."
                        Click="next_clicked"/>
                <Button x:Name="stop_btn" Content="Stop" Width="82"
                        Style="{StaticResource GreyBtn}"
                        ToolTip="Stop here. Everything already swapped stays."
                        Click="stop_clicked"/>
            </StackPanel>
        </StackPanel>

        <!-- ── BODY ─────────────────────────────────── -->
        <Border Background="{DynamicResource BrushCardBg}"
                CornerRadius="{DynamicResource CornerRadiusCard}"
                Padding="{DynamicResource PaddingCard}"
                Margin="18,14,18,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock x:Name="step_tb" Style="{StaticResource Section}"/>
                    <TextBlock x:Name="what_tb" Style="{StaticResource Hint}"
                               Margin="0,4,0,0"/>
                    <TextBlock x:Name="view_tb" Style="{StaticResource Hint}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="WHAT THIS ONE COSTS"
                           Style="{StaticResource ColHead}"
                           Margin="0,0,0,5"/>

                <ListBox x:Name="detail_lb" Style="{StaticResource ResultList}"/>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
