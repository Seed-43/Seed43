<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Width="1400"
        Height="860"
        MinWidth="1080"
        MinHeight="600"
        Title="Shared Params"
        Background="{DynamicResource BrushWindowBg}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Fallbacks only; seed43_theme injects the live palette after the
             XAML has parsed, which is what makes DynamicResource the only
             usable binding here. Values match the dark profile so an
             unreadable palette file still looks whole. -->
        <SolidColorBrush x:Key="BrushWindowBg"            Color="#3B4553"/>
        <SolidColorBrush x:Key="BrushCardBg"              Color="#2B3340"/>
        <SolidColorBrush x:Key="BrushHeaderBg"            Color="#232933"/>
        <SolidColorBrush x:Key="BrushPrimaryGreen"        Color="#208A3C"/>
        <SolidColorBrush x:Key="BrushPrimaryGreenHover"   Color="#32934C"/>
        <SolidColorBrush x:Key="BrushTextPrimary"         Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushTextMuted"           Color="#9CA3AF"/>
        <SolidColorBrush x:Key="BrushInputBg"             Color="#1D1D20"/>
        <SolidColorBrush x:Key="BrushBorderDefault"       Color="#208A3C"/>
        <SolidColorBrush x:Key="BrushSecondaryBg"         Color="#48484B"/>
        <SolidColorBrush x:Key="BrushSecondaryHover"      Color="#515155"/>
        <SolidColorBrush x:Key="BrushSecondaryDisabledBg" Color="#2E2E32"/>
        <SolidColorBrush x:Key="BrushSecondaryDisabledFg" Color="#77767B"/>
        <SolidColorBrush x:Key="BrushDropdownItemHover"   Color="#3F3F41"/>
        <SolidColorBrush x:Key="BrushSelectedRowBg"       Color="#08230F"/>
        <SolidColorBrush x:Key="BrushHighlightedRowBg"    Color="#08230F"/>
        <SolidColorBrush x:Key="BrushDanger"              Color="#E01B24"/>
        <SolidColorBrush x:Key="BrushDangerHover"         Color="#F04B54"/>
        <SolidColorBrush x:Key="BrushSuccess"             Color="#27AE60"/>
        <SolidColorBrush x:Key="BrushWarning"             Color="#E5A50A"/>

        <CornerRadius x:Key="CornerRadiusCard"     >8</CornerRadius>
        <CornerRadius x:Key="CornerRadiusInput"    >6</CornerRadius>
        <CornerRadius x:Key="CornerRadiusButton"   >10</CornerRadius>
        <Thickness    x:Key="PaddingCard"          >16</Thickness>
        <Thickness    x:Key="PaddingButtonPrimary" >15,7,15,7</Thickness>
        <sys:Double   x:Key="FontSizeInput"        >12</sys:Double>
        <sys:Double   x:Key="FontSizeFieldLabel"   >12</sys:Double>
        <sys:Double   x:Key="FontSizeSectionLabel" >14</sys:Double>
        <sys:Double   x:Key="FontSizeButton"       >12</sys:Double>
        <sys:Double   x:Key="FontSizeBody"         >12</sys:Double>

        <!-- ── TEXT ──────────────────────────────────────────────────── -->
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeSectionLabel}"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeFieldLabel}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <!-- ── INPUTS ────────────────────────────────────────────────── -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeInput}"/>
            <Setter Property="Padding"         Value="7,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Background"      Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeInput}"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                        <Setter Property="Padding"    Value="8,5"/>
                        <Setter Property="Cursor"     Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="Transparent"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource BrushDropdownItemHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource BrushInputBg}"
                                                BorderBrush="{DynamicResource BrushBorderDefault}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource CornerRadiusInput}">
                                            <Path x:Name="Arrow"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{DynamicResource BrushPrimaryGreen}"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="10,0,26,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource BrushInputBg}"
                                        BorderBrush="{DynamicResource BrushBorderDefault}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource CornerRadiusInput}"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="320"
                                        Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeInput}"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>

        <!-- ── BUTTONS ───────────────────────────────────────────────── -->
        <Style x:Key="GreenBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeButton}"/>
            <Setter Property="Padding"         Value="{DynamicResource PaddingButtonPrimary}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButton}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreyBtn" TargetType="Button" BasedOn="{StaticResource GreenBtn}">
            <Setter Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButton}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushSecondaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolBtn" TargetType="Button" BasedOn="{StaticResource GreyBtn}">
            <Setter Property="Padding" Value="11,5,11,5"/>
            <Setter Property="Margin"  Value="0,0,6,0"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButton}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushDanger}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCtrlCloseBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="30"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushDanger}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS-style slim green scrollbar — applies everywhere -->
        <Style x:Key="MacScrollBarThumb" TargetType="Thumb">
            <Setter Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumb"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width"    Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="GridRoot" Width="8" Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Orientation="Vertical"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MacScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GridRoot" Property="Width" Value="10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width"     Value="Auto"/>
                    <Setter Property="MinWidth"  Value="0"/>
                    <Setter Property="Height"    Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid x:Name="GridRoot" Height="8" Background="Transparent">
                                    <Track x:Name="PART_Track" Orientation="Horizontal">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource MacScrollBarThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="GridRoot" Property="Height" Value="10"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── THE TABLE ─────────────────────────────────────────────── -->
        <!-- Deliberately outside the Seed43 palette: colours are fixed here
             to match the pySheets sheet list, with Revit style dropdowns in
             the cells. Tweak the Tbl* brushes to retune the whole table. -->
        <SolidColorBrush x:Key="TblBg"          Color="#1E2530"/>
        <SolidColorBrush x:Key="TblLine"        Color="#2A3240"/>
        <SolidColorBrush x:Key="TblHover"       Color="#243041"/>
        <SolidColorBrush x:Key="TblSelected"    Color="#14401F"/>
        <SolidColorBrush x:Key="TblHeaderText"  Color="#B4BCC8"/>
        <SolidColorBrush x:Key="TblText"        Color="#F2F4F7"/>
        <SolidColorBrush x:Key="TblField"       Color="#2A3342"/>
        <SolidColorBrush x:Key="TblFieldHover"  Color="#323D4F"/>
        <SolidColorBrush x:Key="TblPopup"       Color="#262E3B"/>
        <SolidColorBrush x:Key="TblPopupBorder" Color="#3A4556"/>
        <SolidColorBrush x:Key="TblChevron"     Color="#C8D0DA"/>
        <SolidColorBrush x:Key="TblGroupText"   Color="#FFFFFF"/>

        <!-- Virtualisation is what keeps a several thousand row file
             usable: WPF then realises only the rows on screen instead of
             building a control tree for every parameter in the file. -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"               Value="{StaticResource TblBg}"/>
            <Setter Property="Foreground"               Value="{StaticResource TblText}"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource TblLine}"/>
            <Setter Property="MinRowHeight"             Value="26"/>
            <Setter Property="HeadersVisibility"        Value="Column"/>
            <Setter Property="AutoGenerateColumns"      Value="False"/>
            <Setter Property="CanUserAddRows"           Value="False"/>
            <Setter Property="CanUserDeleteRows"        Value="False"/>
            <Setter Property="CanUserReorderColumns"    Value="False"/>
            <Setter Property="CanUserSortColumns"       Value="True"/>
            <Setter Property="SelectionMode"            Value="Extended"/>
            <Setter Property="SelectionUnit"            Value="FullRow"/>
            <Setter Property="RowHeaderWidth"           Value="0"/>
            <Setter Property="EnableRowVirtualization"  Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="False"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing"    Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll"        Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="{StaticResource TblBg}"/>
            <Setter Property="Foreground"      Value="{StaticResource TblHeaderText}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="8,7"/>
            <Setter Property="BorderBrush"     Value="{StaticResource TblLine}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Row colour lives on the cell style, not on DataGridRow: a
             DataGridCell Foreground Setter beats a Foreground inherited
             from the row, so row level triggers would never show.
             Bindings still resolve against the row item the cells share. -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="8,2"/>
            <Setter Property="Foreground"       Value="{StaticResource TblText}"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RowState}" Value="error">
                    <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RowState}" Value="new">
                    <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource TblBg}"/>
            <Setter Property="ToolTip"    Value="{Binding Problem}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource TblHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource TblSelected}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Read only: one line, trimmed, so the list stays compact. -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
        </Style>

        <!-- Editing: the box wraps, so clicking into a cell expands the row
             to show the whole value instead of a trimmed single line. -->
        <Style x:Key="CellEdit" TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource TblField}"/>
            <Setter Property="Foreground"      Value="{StaticResource TblText}"/>
            <Setter Property="CaretBrush"      Value="{StaticResource TblText}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="3,2"/>
            <Setter Property="TextWrapping"    Value="Wrap"/>
            <Setter Property="AcceptsReturn"   Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <!-- Description is the long one: open it at three lines minimum. -->
        <Style x:Key="CellEditLong" TargetType="TextBox" BasedOn="{StaticResource CellEdit}">
            <Setter Property="MinLines" Value="3"/>
        </Style>

        <!-- Dropdown in a cell, Revit style: a flat filled box that spans
             the cell, a thin chevron at the right, and a plain list. -->
        <Style x:Key="CellCombo" TargetType="ComboBox">
            <Setter Property="Foreground"      Value="{StaticResource TblText}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="22"/>
            <Setter Property="Margin"          Value="-5,0,-5,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <!-- Every type cell shares one grouped CollectionView. Without
                 this each combo follows the view's current item, and every
                 row shows whatever the last one picked. -->
            <Setter Property="IsSynchronizedWithCurrentItem" Value="False"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TblText}"/>
                        <Setter Property="Padding"    Value="16,3,8,3"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="Transparent"
                                            BorderBrush="Transparent" BorderThickness="1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{StaticResource TblFieldHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{StaticResource TblSelected}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                    Value="{DynamicResource BrushPrimaryGreen}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Box" Background="{StaticResource TblField}"
                                                CornerRadius="3">
                                            <Path Data="M 0 0 L 3.5 3.5 L 7 0"
                                                  Stroke="{StaticResource TblChevron}"
                                                  StrokeThickness="1.5"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,1,8,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="Background"
                                                        Value="{StaticResource TblFieldHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="7,0,22,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <Popup Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{StaticResource TblPopup}"
                                        BorderBrush="{StaticResource TblPopupBorder}"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="360" Padding="0,3">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Discipline headings in the data type list (added to the editing
             combo from the script; GroupStyle cannot be set by a Style). -->
        <GroupStyle x:Key="TypeGroupStyle">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource TblGroupText}"
                               Margin="6,5,6,1"/>
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>
    </Window.Resources>

    <DockPanel>
        <!-- ── HEADER ────────────────────────────────────────────────── -->
        <Border Background="{DynamicResource BrushHeaderBg}"
                Height="64"
                DockPanel.Dock="Top"
                CornerRadius="0,0,12,12">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3"
                                  ShadowDepth="2" BlurRadius="6"/>
            </Border.Effect>
            <Grid Margin="20,0,16,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <TextBlock Text="Shared" FontWeight="Bold" FontSize="26"
                               Foreground="{DynamicResource BrushPrimaryGreen}"/>
                    <TextBlock Text="Params" FontWeight="Bold" FontSize="26"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock x:Name="subtitle_tb" FontSize="14"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               Opacity="0.6"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="820"
                               VerticalAlignment="Bottom" Margin="12,0,0,5"/>
                </StackPanel>
                <Button x:Name="win_close_btn"
                        Content="&#10005;"
                        Style="{StaticResource WinCtrlCloseBtn}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTip="Close"
                        Click="close_clicked"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <!-- ── FOOTER ────────────────────────────────────────────────── -->
        <Grid DockPanel.Dock="Bottom" Margin="20,0,20,20">
            <TextBlock x:Name="status_tb" Style="{StaticResource Hint}"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       MaxWidth="900"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="check_btn" Content="Check" Width="100"
                        Style="{StaticResource GreyBtn}" Margin="0,0,8,0"
                        ToolTip="Report duplicate GUIDs, bad GUIDs, empty names and orphaned groups without writing anything"
                        Click="check_clicked"/>
                <Button x:Name="save_btn" Content="Save" Width="130"
                        Style="{StaticResource GreenBtn}" Margin="0,0,8,0"
                        ToolTip="Write the file. The old copy goes to a _backups folder beside it first, and the new one is written to a temp file and moved into place, so an interrupted save cannot leave a half written parameter file."
                        Click="save_clicked"/>
                <Button x:Name="close_btn" Content="Close" Width="100"
                        Style="{StaticResource GreyBtn}"
                        Click="close_clicked"/>
            </StackPanel>
        </Grid>

        <!-- ── BODY ──────────────────────────────────────────────────── -->
        <Border Background="{DynamicResource BrushCardBg}"
                CornerRadius="{DynamicResource CornerRadiusCard}"
                Padding="{DynamicResource PaddingCard}"
                Margin="20,16,20,16">
            <DockPanel>

                <!-- ── FILE ROW ──────────────────────────────────────── -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                            Margin="0,0,0,10">
                    <Button x:Name="open_btn" Content="Open" Width="86"
                            Style="{StaticResource ToolBtn}"
                            ToolTip="Open a shared parameter file"
                            Click="open_clicked"/>
                    <Button x:Name="revit_btn" Content="Revit file" Width="92"
                            Style="{StaticResource ToolBtn}"
                            ToolTip="Open the shared parameter file Revit is currently pointed at"
                            Click="revit_clicked"/>
                    <Button x:Name="new_btn" Content="New" Width="72"
                            Style="{StaticResource ToolBtn}"
                            ToolTip="Start an empty shared parameter file"
                            Click="new_clicked"/>
                    <Button x:Name="saveas_btn" Content="Save as" Width="92"
                            Style="{StaticResource ToolBtn}"
                            ToolTip="Write to a different file"
                            Click="saveas_clicked"/>
                    <Border Width="1" Margin="4,2,10,2"
                            Background="{DynamicResource BrushSecondaryBg}"/>
                    <Button x:Name="set_revit_btn" Content="Point Revit here"
                            Width="132" Style="{StaticResource ToolBtn}"
                            ToolTip="Make this file the one Revit uses for shared parameters"
                            Click="set_revit_clicked"/>
                </StackPanel>

                <!-- ── ACTION ROW ────────────────────────────────────── -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="add_btn" Content="Add" Width="72"
                                Style="{StaticResource ToolBtn}"
                                ToolTip="Add one parameter with a fresh GUID"
                                Click="add_clicked"/>
                        <Button x:Name="dup_btn" Content="Duplicate" Width="90"
                                Style="{StaticResource ToolBtn}"
                                ToolTip="Copy the selected rows, each with a fresh GUID"
                                Click="dup_clicked"/>
                        <Button x:Name="guid_btn" Content="New GUID" Width="94"
                                Style="{StaticResource ToolBtn}"
                                ToolTip="Give the selected rows fresh GUIDs. Any family or project already bound to the old GUID loses its link, so this is for fixing a duplicate, not for tidying."
                                Click="guid_clicked"/>
                        <Button x:Name="del_btn" Content="Delete" Width="78"
                                Style="{StaticResource DangerBtn}"
                                ToolTip="Remove the selected rows"
                                Click="del_clicked"/>
                        <Border Width="1" Margin="4,2,10,2"
                                Background="{DynamicResource BrushSecondaryBg}"/>
                        <Button x:Name="groups_btn" Content="Groups" Width="80"
                                Style="{StaticResource ToolBtn}"
                                ToolTip="Add, rename and remove parameter groups"
                                Click="groups_clicked"/>
                        <Button x:Name="rename_btn" Content="Rename" Width="84"
                                Style="{StaticResource ToolBtn}"
                                ToolTip="Prefix, suffix or find and replace across the selected rows"
                                Click="rename_clicked"/>
                        <Button x:Name="type_btn" Content="Set type" Width="84"
                                Style="{StaticResource ToolBtn}"
                                ToolTip="Set the data type on every selected row at once"
                                Click="type_clicked"/>
                        <Button x:Name="movegroup_btn" Content="Set group" Width="90"
                                Style="{StaticResource ToolBtn}"
                                ToolTip="Move every selected row into one group"
                                Click="movegroup_clicked"/>
                        <Button x:Name="sort_btn" Content="Sort" Width="70"
                                Style="{StaticResource ToolBtn}"
                                ToolTip="Reorder the rows in the file itself. Clicking a column header only sorts what is on screen."
                                Click="sort_clicked"/>
                        <Button x:Name="undo_btn" Content="Undo" Width="70"
                                Style="{StaticResource ToolBtn}"
                                ToolTip="Step back through the edits made since the file was opened"
                                Click="undo_clicked"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Group" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="filter_group_cb" Width="150"
                                  Style="{StaticResource Combo}" Margin="0,0,10,0"
                                  ToolTip="Show one group at a time"
                                  SelectionChanged="filter_changed"/>
                        <TextBox x:Name="search_tb" Width="230"
                                 Style="{StaticResource Field}"
                                 ToolTip="Filter by name, description, data type or GUID"
                                 TextChanged="search_changed"/>
                        <Button x:Name="clear_btn" Content="&#10005;" Width="30"
                                Style="{StaticResource ToolBtn}" Margin="6,0,0,0"
                                ToolTip="Clear the filters"
                                Click="clear_clicked"/>
                    </StackPanel>
                </Grid>

                <!-- ── GRID ──────────────────────────────────────────── -->
                <Border Background="{StaticResource TblBg}"
                        CornerRadius="6" ClipToBounds="True">
                    <DataGrid x:Name="grid"
                              CellEditEnding="cell_edit_ending"
                              PreparingCellForEdit="preparing_cell_for_edit"
                              PreviewKeyDown="grid_key_down">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parameter name" Width="2*"
                                                Binding="{Binding Name}"
                                                ElementStyle="{StaticResource CellText}"
                                                EditingElementStyle="{StaticResource CellEdit}"/>
                            <DataGridComboBoxColumn x:Name="type_col"
                                                    Header="Type of parameter" Width="160"
                                                    SelectedValuePath="Token"
                                                    DisplayMemberPath="Label"
                                                    SelectedValueBinding="{Binding DataType}"
                                                    ElementStyle="{StaticResource CellCombo}"
                                                    EditingElementStyle="{StaticResource CellCombo}"/>
                            <DataGridComboBoxColumn x:Name="group_col"
                                                    Header="Group" Width="128"
                                                    SelectedItemBinding="{Binding GroupName}"
                                                    ElementStyle="{StaticResource CellCombo}"
                                                    EditingElementStyle="{StaticResource CellCombo}"/>
                            <DataGridTextColumn Header="Description" Width="2*"
                                                Binding="{Binding Description}"
                                                ElementStyle="{StaticResource CellText}"
                                                EditingElementStyle="{StaticResource CellEditLong}"/>
                            <DataGridComboBoxColumn x:Name="mod_col"
                                                    Header="User modifiable" Width="104"
                                                    SelectedItemBinding="{Binding UserModifiable}"
                                                    ElementStyle="{StaticResource CellCombo}"
                                                    EditingElementStyle="{StaticResource CellCombo}"/>
                            <DataGridComboBoxColumn x:Name="vis_col"
                                                    Header="Visibility" Width="80"
                                                    SelectedItemBinding="{Binding Visible}"
                                                    ElementStyle="{StaticResource CellCombo}"
                                                    EditingElementStyle="{StaticResource CellCombo}"/>
                            <DataGridTextColumn Header="GUID" Width="250"
                                                Binding="{Binding Guid}"
                                                ElementStyle="{StaticResource CellText}"
                                                EditingElementStyle="{StaticResource CellEdit}"/>
                            <DataGridComboBoxColumn x:Name="hide_col"
                                                    Header="Hide when no value" Width="124"
                                                    SelectedItemBinding="{Binding HideWhenNoValue}"
                                                    ElementStyle="{StaticResource CellCombo}"
                                                    EditingElementStyle="{StaticResource CellCombo}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
