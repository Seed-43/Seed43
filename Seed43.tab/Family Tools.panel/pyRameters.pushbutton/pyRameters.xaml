<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Width="1400"
        Height="860"
        MinWidth="1080"
        MinHeight="600"
        Title="pyRameters"
        Background="{DynamicResource BrushWindowBg}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Every Brush*/Size*/CornerRadius*/Padding* key this window uses is
             injected at open by seed43_theme.py from lib/Snippets/
             seed43_palette.json - see the apply_seed43_palette() and
             apply_seed43_dimensions() calls in script.py. There are
             deliberately no local copies of those keys, as in Batch Upgrade,
             the layout this window follows: a duplicate set only went stale
             and made a failure render the wrong values instead of an obvious
             problem. -->
        <SolidColorBrush x:Key="BrushWarning"             Color="#E5A50A"/>


        <!-- ── TEXT ──────────────────────────────────────────────────── -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeFieldLabel}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Card titles in Batch Upgrade are SectionLabel at 13 bold. -->
        <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontSize"     Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeFieldLabel}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <!-- ── INPUTS ────────────────────────────────────────────────── -->
        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextInput}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorderDefault}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessInput}"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeInput}"/>
            <Setter Property="Padding"         Value="{DynamicResource PaddingInput}"/>
            <Setter Property="Height"          Value="{DynamicResource HeightInput}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly"      Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusInput}">
                            <!-- No Padding/Margin="{TemplateBinding Padding}" here.
                                 WPF already applies TextBox.Padding to the element
                                 named PART_ContentHost, so setting it again doubles
                                 it - text clipped top and bottom. -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PathBox is read-only by design; these fields are typed into. -->
        <Style x:Key="TextField" TargetType="TextBox" BasedOn="{StaticResource PathBox}">
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="CaretBrush" Value="{DynamicResource BrushTextInput}"/>
        </Style>

        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Background"      Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeInput}"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                        <Setter Property="Padding"    Value="8,5"/>
                        <Setter Property="Cursor"     Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="Transparent"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource BrushDropdownItemHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource BrushInputBg}"
                                                BorderBrush="{DynamicResource BrushBorderDefault}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource CornerRadiusInput}">
                                            <Path x:Name="Arrow"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{DynamicResource BrushPrimaryGreen}"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="10,0,26,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource BrushInputBg}"
                                        BorderBrush="{DynamicResource BrushBorderDefault}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource CornerRadiusInput}"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="320"
                                        Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeFieldLabel}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Margin"     Value="0,4,18,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <!-- Transparent background, not none, so the whole row
                             - label included - is the click target, not just
                             the box itself. -->
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="{DynamicResource SizeCheckbox}"
                                    Height="{DynamicResource SizeCheckbox}"
                                    Background="{DynamicResource BrushInputBg}"
                                    BorderBrush="{DynamicResource BrushBorderDefault}"
                                    BorderThickness="{DynamicResource BorderThicknessCheckbox}"
                                    CornerRadius="{DynamicResource CornerRadiusCheckbox}"
                                    VerticalAlignment="Center">
                                <!-- BrushToggleKnob, not BrushTextPrimary: this
                                     is a mark on an accent-filled control, the
                                     same as the toggle knob, and it has to stay
                                     light against the green in the light
                                     profile too. -->
                                <Path x:Name="Tick"
                                      Data="M 3,7.5 L 6,10.5 L 11.5,4.5"
                                      Stroke="{DynamicResource BrushToggleKnob}"
                                      StrokeThickness="2"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box"  Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                                <Setter TargetName="Box" Property="Background"  Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── BUTTONS ───────────────────────────────────────────────── -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeButton}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="{DynamicResource PaddingButtonPrimary}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="MinWidth"        Value="130"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButton}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="MinWidth"   Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButton}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeButtonSmall}"/>
            <Setter Property="Height"   Value="{DynamicResource HeightButtonSmall}"/>
            <Setter Property="Padding"  Value="{DynamicResource PaddingButtonSmall}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin"   Value="6,0,0,0"/>
        </Style>

        <Style x:Key="ToolBtn" TargetType="Button" BasedOn="{StaticResource SmallBtn}">
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- The toolbar's one committing action: PrimaryBtn at toolbar size. -->
        <Style x:Key="ToolPrimaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeButtonSmall}"/>
            <Setter Property="Height"   Value="{DynamicResource HeightButtonSmall}"/>
            <Setter Property="Padding"  Value="{DynamicResource PaddingButtonSmall}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin"   Value="0,0,6,0"/>
        </Style>

        <!-- A toolbar button that opens a menu: ToolBtn's look, a chevron, and
             green while its menu is open. -->
        <Style x:Key="DropdownBtn" TargetType="ToggleButton">
            <Setter Property="Background"      Value="{DynamicResource BrushSecondaryBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeButtonSmall}"/>
            <Setter Property="Height"          Value="{DynamicResource HeightButtonSmall}"/>
            <Setter Property="Padding"         Value="{DynamicResource PaddingButtonSmall}"/>
            <Setter Property="Margin"          Value="0,0,6,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButton}"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Viewbox Width="8" Height="5" Margin="8,1,0,0" VerticalAlignment="Center">
                                    <Path Data="M0,0 L8,0 L4,5 Z" Fill="{TemplateBinding Foreground}"/>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The panel every menu sits in: the header menu's look, as one style. -->
        <Style x:Key="MenuPanel" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="MinWidth"        Value="200"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.25" ShadowDepth="2" BlurRadius="8"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuSeparator" TargetType="Rectangle">
            <Setter Property="Fill"   Value="{DynamicResource BrushSecondaryBg}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>


        <!-- Placeholder text over an empty search box. -->
        <Style x:Key="SearchHint" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontSize"          Value="{DynamicResource FontSizeInput}"/>
            <Setter Property="IsHitTestVisible"  Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="10,0,0,0"/>
            <Setter Property="Visibility"        Value="Collapsed"/>
        </Style>

        <!-- Its own hover and pressed tokens, so it never flashes green. -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="{DynamicResource BrushDanger}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButton}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushDangerHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushDangerPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCtrlCloseBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushDanger}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS-style slim green scrollbar — applies everywhere -->
        <Style x:Key="MacScrollBarThumb" TargetType="Thumb">
            <Setter Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumb"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width"    Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="GridRoot" Width="8" Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Orientation="Vertical"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MacScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GridRoot" Property="Width" Value="10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width"     Value="Auto"/>
                    <Setter Property="MinWidth"  Value="0"/>
                    <Setter Property="Height"    Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid x:Name="GridRoot" Height="8" Background="Transparent">
                                    <Track x:Name="PART_Track" Orientation="Horizontal">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource MacScrollBarThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="GridRoot" Property="Height" Value="10"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── THE TABLE ─────────────────────────────────────────────── -->
        <!-- Deliberately outside the Seed43 palette: colours are fixed here
             to match the pySheets sheet list, with Revit style dropdowns in
             the cells. Tweak the Tbl* brushes to retune the whole table. -->
        <SolidColorBrush x:Key="TblBg"          Color="#1E2530"/>
        <SolidColorBrush x:Key="TblLine"        Color="#2A3240"/>
        <SolidColorBrush x:Key="TblHover"       Color="#243041"/>
        <SolidColorBrush x:Key="TblSelected"    Color="#14401F"/>
        <SolidColorBrush x:Key="TblHeaderText"  Color="#B4BCC8"/>
        <SolidColorBrush x:Key="TblText"        Color="#F2F4F7"/>
        <SolidColorBrush x:Key="TblField"       Color="#2A3342"/>
        <SolidColorBrush x:Key="TblFieldHover"  Color="#323D4F"/>
        <SolidColorBrush x:Key="TblPopup"       Color="#262E3B"/>
        <SolidColorBrush x:Key="TblPopupBorder" Color="#3A4556"/>
        <SolidColorBrush x:Key="TblChevron"     Color="#C8D0DA"/>
        <SolidColorBrush x:Key="TblGroupText"   Color="#FFFFFF"/>

        <!-- Virtualisation is what keeps a several thousand row file
             usable: WPF then realises only the rows on screen instead of
             building a control tree for every parameter in the file. -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"               Value="{StaticResource TblBg}"/>
            <Setter Property="Foreground"               Value="{StaticResource TblText}"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource TblLine}"/>
            <Setter Property="MinRowHeight"             Value="26"/>
            <Setter Property="HeadersVisibility"        Value="Column"/>
            <Setter Property="AutoGenerateColumns"      Value="False"/>
            <Setter Property="CanUserAddRows"           Value="False"/>
            <Setter Property="CanUserDeleteRows"        Value="False"/>
            <Setter Property="CanUserReorderColumns"    Value="False"/>
            <Setter Property="CanUserSortColumns"       Value="True"/>
            <Setter Property="SelectionMode"            Value="Extended"/>
            <Setter Property="SelectionUnit"            Value="FullRow"/>
            <Setter Property="RowHeaderWidth"           Value="0"/>
            <Setter Property="EnableRowVirtualization"  Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="False"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing"    Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll"        Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="{StaticResource TblBg}"/>
            <Setter Property="Foreground"      Value="{StaticResource TblHeaderText}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="8,7"/>
            <Setter Property="BorderBrush"     Value="{StaticResource TblLine}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Row colour lives on the cell style, not on DataGridRow: a
             DataGridCell Foreground Setter beats a Foreground inherited
             from the row, so row level triggers would never show.
             Bindings still resolve against the row item the cells share. -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="8,2"/>
            <Setter Property="Foreground"       Value="{StaticResource TblText}"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RowState}" Value="error">
                    <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RowState}" Value="new">
                    <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource TblBg}"/>
            <Setter Property="ToolTip"    Value="{Binding Problem}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource TblHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource TblSelected}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Read only: one line, trimmed, so the list stays compact. -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
        </Style>

        <!-- Editing: the box wraps, so clicking into a cell expands the row
             to show the whole value instead of a trimmed single line. -->
        <Style x:Key="CellEdit" TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource TblField}"/>
            <Setter Property="Foreground"      Value="{StaticResource TblText}"/>
            <Setter Property="CaretBrush"      Value="{StaticResource TblText}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="3,2"/>
            <Setter Property="TextWrapping"    Value="Wrap"/>
            <Setter Property="AcceptsReturn"   Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <!-- Description is the long one: open it at three lines minimum. -->
        <Style x:Key="CellEditLong" TargetType="TextBox" BasedOn="{StaticResource CellEdit}">
            <Setter Property="MinLines" Value="3"/>
        </Style>

        <!-- Dropdown in a cell, Revit style: a flat filled box that spans
             the cell, a thin chevron at the right, and a plain list. -->
        <Style x:Key="CellCombo" TargetType="ComboBox">
            <Setter Property="Foreground"      Value="{StaticResource TblText}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="22"/>
            <Setter Property="Margin"          Value="-5,0,-5,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <!-- Every type cell shares one grouped CollectionView. Without
                 this each combo follows the view's current item, and every
                 row shows whatever the last one picked. -->
            <Setter Property="IsSynchronizedWithCurrentItem" Value="False"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TblText}"/>
                        <Setter Property="Padding"    Value="16,3,8,3"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="Transparent"
                                            BorderBrush="Transparent" BorderThickness="1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{StaticResource TblFieldHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{StaticResource TblSelected}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                    Value="{DynamicResource BrushPrimaryGreen}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Box" Background="{StaticResource TblField}"
                                                CornerRadius="3">
                                            <Path Data="M 0 0 L 3.5 3.5 L 7 0"
                                                  Stroke="{StaticResource TblChevron}"
                                                  StrokeThickness="1.5"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,1,8,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="Background"
                                                        Value="{StaticResource TblFieldHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="7,0,22,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <Popup Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{StaticResource TblPopup}"
                                        BorderBrush="{StaticResource TblPopupBorder}"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="360" Padding="0,3">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Discipline headings in the data type list (added to the editing
             combo from the script; GroupStyle cannot be set by a Style). -->
        <GroupStyle x:Key="TypeGroupStyle">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource TblGroupText}"
                               Margin="6,5,6,1"/>
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>

        <Style x:Key="HamburgerToggle" TargetType="ToggleButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Width"           Value="36"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="6" Width="36" Height="36">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HamburgerMenuItem" TargetType="Button">
            <Setter Property="Background"                Value="Transparent"/>
            <Setter Property="Foreground"                Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness"           Value="0"/>
            <Setter Property="Padding"                   Value="{DynamicResource PaddingMenuItem}"/>
            <Setter Property="FontSize"                  Value="{DynamicResource FontSizeMenuItem}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuDangerItem" TargetType="Button" BasedOn="{StaticResource HamburgerMenuItem}">
            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
        </Style>

        <!-- Tabs, as pySheets': a button per tab, Tag="Active" on the open one. -->
        <Style x:Key="MainTab" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Normal"/>
            <Setter Property="Opacity"         Value="0.7"/>
            <Setter Property="Padding"         Value="24,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreen}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value=""/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Opacity" Value="0.85"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The change marker in the Parameters grid's first column. -->
        <Style x:Key="CellState" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateLabel}" Value="New">
                    <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryGreen}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateLabel}" Value="Changed">
                    <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateLabel}" Value="Delete">
                    <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ── HEADER ────────────────────────────────────────────────── -->
        <Border Background="{DynamicResource BrushHeaderBg}"
                Height="56"
                DockPanel.Dock="Top"
                CornerRadius="10,10,12,12">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3"
                                  ShadowDepth="2" BlurRadius="6"/>
            </Border.Effect>
            <Grid Margin="20,0,16,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <!-- Source set from Python by Snippets._icons.set_header_icon -->
                    <Image x:Name="header_icon"
                           Width="{DynamicResource SizeTopBarLogo}"
                           Height="{DynamicResource SizeTopBarLogo}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                    <TextBlock Text="py" FontWeight="Bold" FontSize="22"
                               Foreground="{DynamicResource BrushPrimaryGreen}"/>
                    <TextBlock Text="Rameters" FontWeight="Bold" FontSize="22"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock x:Name="subtitle_tb" FontSize="14"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               Opacity="0.6"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="820"
                               VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid Margin="0,0,4,0">
                        <ToggleButton x:Name="settings_toggle_btn"
                                      Style="{StaticResource HamburgerToggle}"
                                      ToolTip="Menu"/>
                        <Popup x:Name="settings_popup"
                               PlacementTarget="{Binding ElementName=settings_toggle_btn}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               IsOpen="{Binding ElementName=settings_toggle_btn, Path=IsChecked}">
                            <Border Background="{DynamicResource BrushCardBg}"
                                    BorderBrush="{DynamicResource BrushPrimaryGreen}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MinWidth="200">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.25" ShadowDepth="2" BlurRadius="8"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Button x:Name="help_btn"
                                            Content="&#x2709;  Email support"
                                            Style="{StaticResource HamburgerMenuItem}"/>
                                    <Button x:Name="issue_btn"
                                            Content="Report an issue on GitHub"
                                            Style="{StaticResource HamburgerMenuItem}"/>
                                    <Rectangle Fill="{DynamicResource BrushSecondaryBg}" Height="1" Margin="0,2"/>
                                    <Button x:Name="about_btn"
                                            Content="&#8505;  About pyRameters"
                                            Style="{StaticResource HamburgerMenuItem}"/>
                                    <Rectangle Fill="{DynamicResource BrushSecondaryBg}" Height="1" Margin="0,2"/>
                                    <Button x:Name="support_btn"
                                            Content="&#9749;  Support this project and help us grow"
                                            Style="{StaticResource HamburgerMenuItem}"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button x:Name="win_close_btn"
                            Content="&#10005;"
                            Style="{StaticResource WinCtrlCloseBtn}"
                            VerticalAlignment="Center"
                            ToolTip="Close"
                            Click="close_clicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── FOOTER ────────────────────────────────────────────────── -->
        <Grid DockPanel.Dock="Bottom" Margin="20,0,20,16">
            <TextBlock x:Name="status_tb" Style="{StaticResource Hint}"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       MaxWidth="900"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="close_btn" Content="Close"
                        Style="{StaticResource SecondaryBtn}"
                        Click="close_clicked"/>
                <Button x:Name="apply_btn" Content="Apply"
                        Style="{StaticResource PrimaryBtn}" Margin="10,0,0,0"
                        ToolTip="Write every change waiting in the Parameters tab to the model, in one undoable step"/>
                <Button x:Name="save_btn" Content="Save"
                        Style="{StaticResource PrimaryBtn}" Margin="10,0,0,0"
                        ToolTip="Write the file. The old copy goes to a _backups folder beside it first, and the new one is written to a temp file and moved into place, so an interrupted save cannot leave a half written parameter file."
                        Click="save_clicked"/>
            </StackPanel>
        </Grid>

        <!-- ── BODY ──────────────────────────────────────────────────── -->
        <Border Background="{DynamicResource BrushCardBg}"
                CornerRadius="{DynamicResource CornerRadiusCard}"
                Padding="{DynamicResource PaddingCard}"
                Margin="20,12,20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Button x:Name="tab_params_btn" Content="Parameters"
                            Style="{StaticResource MainTab}" Tag="Active"
                            ToolTip="The parameters of the model or family that is open"/>
                    <Button x:Name="tab_shared_btn" Content="Shared file"
                            Style="{StaticResource MainTab}" Tag="" Margin="4,0,0,0"
                            ToolTip="Edit a shared parameter file"/>
                </StackPanel>
                <Rectangle DockPanel.Dock="Top" Height="2" Margin="0,0,0,12"
                           Fill="{DynamicResource BrushPrimaryGreen}"/>
                <Grid>
                <!-- ── PARAMETERS TAB ─────────────────────────────────── -->
                <!-- The open document's own parameters. Edits are staged and
                     marked in the first column; nothing is written to the
                     model until Apply. -->
                <DockPanel x:Name="params_panel">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid>
                            <ToggleButton x:Name="p_add_menu_btn" Content="+  Add"
                                          Style="{StaticResource DropdownBtn}"
                                          ToolTip="Add parameters to this model or family"/>
                            <Popup x:Name="p_add_menu_popup"
                                   PlacementTarget="{Binding ElementName=p_add_menu_btn}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   IsOpen="{Binding ElementName=p_add_menu_btn, Path=IsChecked}">
                                <Border Style="{StaticResource MenuPanel}">
                                    <StackPanel>
                                            <Button x:Name="p_add_shared_btn" Content="From the shared file..."
                                                    Style="{StaticResource HamburgerMenuItem}"
                                                    ToolTip="Pick parameters from the file open in the Shared file tab"/>
                                            <Button x:Name="p_add_family_btn" Content="New family parameter"
                                                    Style="{StaticResource HamburgerMenuItem}"
                                                    ToolTip="A family parameter of your own, named and typed in the grid"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button x:Name="p_rename_btn" Content="Rename"
                                Style="{StaticResource ToolBtn}"
                                ToolTip="Prefix, suffix or find and replace across the selected family parameters"/>
                        <Grid>
                            <ToggleButton x:Name="p_batch_menu_btn" Content="Batch actions"
                                          Style="{StaticResource DropdownBtn}"
                                          ToolTip="Act on every selected row at once"/>
                            <Popup x:Name="p_batch_menu_popup"
                                   PlacementTarget="{Binding ElementName=p_batch_menu_btn}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   IsOpen="{Binding ElementName=p_batch_menu_btn, Path=IsChecked}">
                                <Border Style="{StaticResource MenuPanel}">
                                    <StackPanel>
                                            <Button x:Name="p_dup_btn" Content="Duplicate"
                                                    Style="{StaticResource HamburgerMenuItem}"/>
                                            <Button x:Name="p_instance_btn" Content="Make instance"
                                                    Style="{StaticResource HamburgerMenuItem}"/>
                                            <Button x:Name="p_typemode_btn" Content="Make type"
                                                    Style="{StaticResource HamburgerMenuItem}"/>
                                            <Button x:Name="p_group_btn" Content="Set group under..."
                                                    Style="{StaticResource HamburgerMenuItem}"/>
                                            <Button x:Name="p_cats_btn" Content="Categories..."
                                                    Style="{StaticResource HamburgerMenuItem}"/>
                                            <Rectangle Style="{StaticResource MenuSeparator}"/>
                                            <Button x:Name="p_to_shared_btn" Content="Convert to shared..."
                                                    Style="{StaticResource HamburgerMenuItem}"
                                                    ToolTip="Replace a family parameter with a shared one from the file, keeping its values"/>
                                            <Button x:Name="p_to_family_btn" Content="Convert to family"
                                                    Style="{StaticResource HamburgerMenuItem}"
                                                    ToolTip="Replace a shared parameter with a family parameter of the same name"/>
                                            <Rectangle Style="{StaticResource MenuSeparator}"/>
                                            <Button x:Name="p_del_btn" Content="Delete"
                                                    Style="{StaticResource MenuDangerItem}"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button x:Name="p_revert_btn" Content="Revert"
                                Style="{StaticResource ToolBtn}"
                                ToolTip="Throw away every change waiting to be applied and read the parameters from the model again"/>
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="12,0,0,0">
                        <ComboBox x:Name="p_filter_cb" Width="170"
                                  Style="{StaticResource Combo}" Margin="0,0,8,0"
                                  ToolTip="Show one kind of parameter, or only the changes waiting to be applied"/>
                        <Grid Width="230">
                            <TextBox x:Name="p_search_tb"
                                     Style="{StaticResource TextField}"
                                     ToolTip="Filter by name, group, data type or GUID"/>
                            <TextBlock Text="Search">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SearchHint}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=p_search_tb}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button x:Name="p_clear_btn" Content="&#10005;"
                                Style="{StaticResource ToolBtn}" Margin="6,0,0,0"
                                ToolTip="Clear the filters"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Border Background="{StaticResource TblBg}"
                            CornerRadius="6" ClipToBounds="True">
                        <!-- Column order is mirrored by the P_COL_* constants in
                             params_tab.py; the two move together. -->
                        <DataGrid x:Name="p_grid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="" Width="70" IsReadOnly="True"
                                                    Binding="{Binding StateLabel}"
                                                    ElementStyle="{StaticResource CellState}"/>
                                <DataGridTextColumn Header="Parameter name" Width="2*"
                                                    Binding="{Binding Name}"
                                                    ElementStyle="{StaticResource CellText}"
                                                    EditingElementStyle="{StaticResource CellEdit}"/>
                                <DataGridTextColumn Header="Kind" Width="76" IsReadOnly="True"
                                                    Binding="{Binding Kind}"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Discipline" Width="110" IsReadOnly="True"
                                                    Binding="{Binding Discipline}"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridComboBoxColumn x:Name="p_type_col"
                                                        Header="Type of parameter" Width="170"
                                                        SelectedValuePath="Token"
                                                        DisplayMemberPath="Label"
                                                        SelectedValueBinding="{Binding Spec}"
                                                        ElementStyle="{StaticResource CellCombo}"
                                                        EditingElementStyle="{StaticResource CellCombo}"/>
                                <DataGridComboBoxColumn x:Name="p_group_col"
                                                        Header="Group under" Width="160"
                                                        SelectedValuePath="Token"
                                                        DisplayMemberPath="Label"
                                                        SelectedValueBinding="{Binding Group}"
                                                        ElementStyle="{StaticResource CellCombo}"
                                                        EditingElementStyle="{StaticResource CellCombo}"/>
                                <DataGridComboBoxColumn x:Name="p_inst_col"
                                                        Header="Instance/Type" Width="104"
                                                        SelectedItemBinding="{Binding InstanceType}"
                                                        ElementStyle="{StaticResource CellCombo}"
                                                        EditingElementStyle="{StaticResource CellCombo}"/>
                                <DataGridTextColumn x:Name="p_value_col"
                                                    Header="Value" Width="1.2*"
                                                    Binding="{Binding Value}"
                                                    ElementStyle="{StaticResource CellText}"
                                                    EditingElementStyle="{StaticResource CellEdit}"/>
                                <DataGridTextColumn x:Name="p_formula_col"
                                                    Header="Formula" Width="1.5*"
                                                    Binding="{Binding Formula}"
                                                    ElementStyle="{StaticResource CellText}"
                                                    EditingElementStyle="{StaticResource CellEdit}"/>
                                <DataGridTextColumn x:Name="p_cats_col"
                                                    Header="Categories" Width="1.6*" IsReadOnly="True"
                                                    Binding="{Binding CategoriesText}"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="GUID" Width="250" IsReadOnly="True"
                                                    Binding="{Binding Guid}"
                                                    ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Popup x:Name="p_row_menu_popup"
                           PlacementTarget="{Binding ElementName=p_grid}"
                           Placement="MousePoint"
                           AllowsTransparency="True"
                           StaysOpen="False">
                        <Border Style="{StaticResource MenuPanel}">
                            <StackPanel>
                                <Button x:Name="p_ctx_dup_btn" Content="Duplicate"
                                        Style="{StaticResource HamburgerMenuItem}"/>
                                <Button x:Name="p_ctx_rename_btn" Content="Rename..."
                                        Style="{StaticResource HamburgerMenuItem}"/>
                                <Button x:Name="p_ctx_instance_btn" Content="Make instance"
                                        Style="{StaticResource HamburgerMenuItem}"/>
                                <Button x:Name="p_ctx_typemode_btn" Content="Make type"
                                        Style="{StaticResource HamburgerMenuItem}"/>
                                <Button x:Name="p_ctx_group_btn" Content="Set group under..."
                                        Style="{StaticResource HamburgerMenuItem}"/>
                                <Button x:Name="p_ctx_cats_btn" Content="Categories..."
                                        Style="{StaticResource HamburgerMenuItem}"/>
                                <Rectangle Style="{StaticResource MenuSeparator}"/>
                                <Button x:Name="p_ctx_del_btn" Content="Delete"
                                        Style="{StaticResource MenuDangerItem}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                </DockPanel>

                <!-- ── SHARED FILE TAB ────────────────────────────────── -->
                <DockPanel x:Name="shared_panel" Visibility="Collapsed">

                <!-- ── TOOLBAR ───────────────────────────────────────── -->
                <!-- Two columns rather than two panels sharing one cell:
                     sharing is what put Undo on top of the Group label. -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid>
                            <ToggleButton x:Name="file_menu_btn" Content="File"
                                          Style="{StaticResource DropdownBtn}"
                                          ToolTip="Open, start or save a shared parameter file"/>
                            <Popup x:Name="file_menu_popup"
                                   PlacementTarget="{Binding ElementName=file_menu_btn}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   IsOpen="{Binding ElementName=file_menu_btn, Path=IsChecked}">
                                <Border Style="{StaticResource MenuPanel}">
                                    <StackPanel>
                                            <Button x:Name="open_btn" Content="Open..."
                                                    Style="{StaticResource HamburgerMenuItem}"
                                                    ToolTip="Open a shared parameter file"/>
                                            <Button x:Name="revit_btn" Content="Open Revit's file"
                                                    Style="{StaticResource HamburgerMenuItem}"
                                                    ToolTip="Open the shared parameter file Revit is currently pointed at"/>
                                            <Button x:Name="new_btn" Content="New file"
                                                    Style="{StaticResource HamburgerMenuItem}"
                                                    ToolTip="Start an empty shared parameter file"/>
                                            <Rectangle Style="{StaticResource MenuSeparator}"/>
                                            <Button x:Name="saveas_btn" Content="Save as..."
                                                    Style="{StaticResource HamburgerMenuItem}"
                                                    ToolTip="Write to a different file"/>
                                            <Rectangle Style="{StaticResource MenuSeparator}"/>
                                            <Button x:Name="set_revit_btn" Content="Point Revit at this file"
                                                    Style="{StaticResource HamburgerMenuItem}"
                                                    ToolTip="Make this file the one Revit uses for shared parameters"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button x:Name="add_btn" Content="+  Add"
                                Style="{StaticResource ToolPrimaryBtn}"
                                ToolTip="Add one parameter with a fresh GUID"
                                Click="add_clicked"/>
                        <Button x:Name="groups_btn" Content="Groups"
                                Style="{StaticResource ToolBtn}"
                                ToolTip="Add, rename and remove parameter groups"
                                Click="groups_clicked"/>
                        <Button x:Name="rename_btn" Content="Rename"
                                Style="{StaticResource ToolBtn}"
                                ToolTip="Prefix, suffix or find and replace across the selected rows"
                                Click="rename_clicked"/>
                        <Grid>
                            <ToggleButton x:Name="batch_menu_btn" Content="Batch actions"
                                          Style="{StaticResource DropdownBtn}"
                                          ToolTip="Act on every selected row at once"/>
                            <Popup x:Name="batch_menu_popup"
                                   PlacementTarget="{Binding ElementName=batch_menu_btn}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   IsOpen="{Binding ElementName=batch_menu_btn, Path=IsChecked}">
                                <Border Style="{StaticResource MenuPanel}">
                                    <StackPanel>
                                            <Button x:Name="dup_btn" Content="Duplicate"
                                                    Style="{StaticResource HamburgerMenuItem}"
                                                    ToolTip="Copy the selected rows, each with a fresh GUID"/>
                                            <Button x:Name="guid_btn" Content="New GUID"
                                                    Style="{StaticResource HamburgerMenuItem}"
                                                    ToolTip="Give the selected rows fresh GUIDs. Any family or project already bound to the old GUID loses its link, so this is for fixing a duplicate, not for tidying."/>
                                            <Button x:Name="type_btn" Content="Set type..."
                                                    Style="{StaticResource HamburgerMenuItem}"
                                                    ToolTip="Set the data type on every selected row at once"/>
                                            <Button x:Name="movegroup_btn" Content="Set group..."
                                                    Style="{StaticResource HamburgerMenuItem}"
                                                    ToolTip="Move every selected row into one group"/>
                                            <Rectangle Style="{StaticResource MenuSeparator}"/>
                                            <Button x:Name="sort_btn" Content="Sort the file"
                                                    Style="{StaticResource HamburgerMenuItem}"
                                                    ToolTip="Reorder the rows in the file itself. Clicking a column header only sorts what is on screen."/>
                                            <Button x:Name="check_btn" Content="Check the file"
                                                    Style="{StaticResource HamburgerMenuItem}"
                                                    ToolTip="Report duplicate GUIDs, bad GUIDs, empty names and orphaned groups without writing anything"/>
                                            <Rectangle Style="{StaticResource MenuSeparator}"/>
                                            <Button x:Name="del_btn" Content="Delete"
                                                    Style="{StaticResource MenuDangerItem}"
                                                    ToolTip="Remove the selected rows"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button x:Name="undo_btn" Content="Undo"
                                Style="{StaticResource ToolBtn}"
                                ToolTip="Step back through the edits made since the file was opened"
                                Click="undo_clicked"/>
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="12,0,0,0">
                        <ComboBox x:Name="filter_group_cb" Width="160"
                                  Style="{StaticResource Combo}" Margin="0,0,8,0"
                                  ToolTip="Show one group at a time"
                                  SelectionChanged="filter_changed"/>
                        <Grid Width="230">
                            <TextBox x:Name="search_tb"
                                     Style="{StaticResource TextField}"
                                     ToolTip="Filter by name, description, data type or GUID"
                                     TextChanged="search_changed"/>
                            <TextBlock Text="Search">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SearchHint}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=search_tb}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button x:Name="clear_btn" Content="&#10005;"
                                Style="{StaticResource ToolBtn}" Margin="6,0,0,0"
                                ToolTip="Clear the filters"
                                Click="clear_clicked"/>
                    </StackPanel>
                </Grid>

                <!-- ── GRID ──────────────────────────────────────────── -->
                <Grid>
                    <Border Background="{StaticResource TblBg}"
                            CornerRadius="6" ClipToBounds="True">
                        <DataGrid x:Name="grid"
                                  CellEditEnding="cell_edit_ending"
                                  PreparingCellForEdit="preparing_cell_for_edit"
                                  PreviewKeyDown="grid_key_down">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Parameter name" Width="2*"
                                                    Binding="{Binding Name}"
                                                    ElementStyle="{StaticResource CellText}"
                                                    EditingElementStyle="{StaticResource CellEdit}"/>
                                <DataGridComboBoxColumn x:Name="type_col"
                                                        Header="Type of parameter" Width="160"
                                                        SelectedValuePath="Token"
                                                        DisplayMemberPath="Label"
                                                        SelectedValueBinding="{Binding DataType}"
                                                        ElementStyle="{StaticResource CellCombo}"
                                                        EditingElementStyle="{StaticResource CellCombo}"/>
                                <DataGridComboBoxColumn x:Name="group_col"
                                                        Header="Group" Width="128"
                                                        SelectedItemBinding="{Binding GroupName}"
                                                        ElementStyle="{StaticResource CellCombo}"
                                                        EditingElementStyle="{StaticResource CellCombo}"/>
                                <DataGridTextColumn Header="Description" Width="2*"
                                                    Binding="{Binding Description}"
                                                    ElementStyle="{StaticResource CellText}"
                                                    EditingElementStyle="{StaticResource CellEditLong}"/>
                                <DataGridComboBoxColumn x:Name="mod_col"
                                                        Header="User modifiable" Width="104"
                                                        SelectedItemBinding="{Binding UserModifiable}"
                                                        ElementStyle="{StaticResource CellCombo}"
                                                        EditingElementStyle="{StaticResource CellCombo}"/>
                                <DataGridComboBoxColumn x:Name="vis_col"
                                                        Header="Visibility" Width="80"
                                                        SelectedItemBinding="{Binding Visible}"
                                                        ElementStyle="{StaticResource CellCombo}"
                                                        EditingElementStyle="{StaticResource CellCombo}"/>
                                <DataGridTextColumn Header="GUID" Width="250"
                                                    Binding="{Binding Guid}"
                                                    ElementStyle="{StaticResource CellText}"
                                                    EditingElementStyle="{StaticResource CellEdit}"/>
                                <DataGridComboBoxColumn x:Name="hide_col"
                                                        Header="Hide when no value" Width="124"
                                                        SelectedItemBinding="{Binding HideWhenNoValue}"
                                                        ElementStyle="{StaticResource CellCombo}"
                                                        EditingElementStyle="{StaticResource CellCombo}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <!-- Right-click menu for the grid. A Popup inside the window
                         rather than a ContextMenu: a ContextMenu is a separate
                         tree, so the palette injected into this window's
                         resources may not reach it and it can render blank. -->
                    <Popup x:Name="row_menu_popup"
                           PlacementTarget="{Binding ElementName=grid}"
                           Placement="MousePoint"
                           AllowsTransparency="True"
                           StaysOpen="False">
                        <Border Style="{StaticResource MenuPanel}">
                            <StackPanel>
                                <Button x:Name="ctx_dup_btn" Content="Duplicate"
                                                    Style="{StaticResource HamburgerMenuItem}"/>
                                <Button x:Name="ctx_guid_btn" Content="New GUID"
                                                    Style="{StaticResource HamburgerMenuItem}"/>
                                <Button x:Name="ctx_rename_btn" Content="Rename..."
                                                    Style="{StaticResource HamburgerMenuItem}"/>
                                <Button x:Name="ctx_type_btn" Content="Set type..."
                                                    Style="{StaticResource HamburgerMenuItem}"/>
                                <Button x:Name="ctx_group_btn" Content="Set group..."
                                                    Style="{StaticResource HamburgerMenuItem}"/>
                                <Rectangle Style="{StaticResource MenuSeparator}"/>
                                <Button x:Name="ctx_del_btn" Content="Delete"
                                                    Style="{StaticResource MenuDangerItem}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                </DockPanel>
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
