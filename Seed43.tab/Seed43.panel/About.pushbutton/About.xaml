<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Seed43"
    Width="460"
    Height="700"
    MinWidth="460"
    MinHeight="590"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowStyle="None"
    WindowStartupLocation="CenterScreen"
    TextElement.FontFamily="Segoe UI"
    Background="{DynamicResource BrushWindowBg}">

<shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="{DynamicResource HeightTopBar}"
                         CornerRadius="{DynamicResource CornerRadiusWindow}"
                         GlassFrameThickness="0"
                         ResizeBorderThickness="6"
                         UseAeroCaptionButtons="False"/>
</shell:WindowChrome.WindowChrome>

<Window.Resources>

    <sys:Double   x:Key="HeightTopBar">64</sys:Double>
    <CornerRadius x:Key="CornerRadiusWindow">10</CornerRadius>
    <sys:Double   x:Key="SizeTopBarLogo">28</sys:Double>
    <sys:Double   x:Key="WidthButtonClose">30</sys:Double>
    <sys:Double   x:Key="HeightButtonClose">30</sys:Double>
    <CornerRadius x:Key="CornerRadiusButtonClose">15</CornerRadius>
    <CornerRadius x:Key="CornerRadiusCard">8</CornerRadius>
    <Thickness    x:Key="PaddingCard">16</Thickness>
    <Thickness    x:Key="PaddingButtonSecondary">16,8,16,8</Thickness>
    <sys:Double   x:Key="FontSizeButtonSecondary">12</sys:Double>
    <CornerRadius x:Key="CornerRadiusButtonSecondary">6</CornerRadius>
    <sys:Double   x:Key="WidthToggle">40</sys:Double>
    <sys:Double   x:Key="HeightToggle">20</sys:Double>
    <CornerRadius x:Key="CornerRadiusToggle">10</CornerRadius>
    <sys:Double   x:Key="SizeToggleKnob">16</sys:Double>
    <CornerRadius x:Key="CornerRadiusToggleKnob">8</CornerRadius>
    <sys:Double   x:Key="MarginToggleKnob">2</sys:Double>

    <SolidColorBrush x:Key="BrushCloseHover"   Color="#FF5555"/>
    <SolidColorBrush x:Key="BrushClosePressed" Color="#CC4444"/>

    <Style x:Key="CloseButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="Width"           Value="{DynamicResource WidthButtonClose}"/>
        <Setter Property="Height"          Value="{DynamicResource HeightButtonClose}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CornerRadiusButtonClose}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource BrushCloseHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource BrushClosePressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
        <Setter Property="CornerRadius"    Value="{DynamicResource CornerRadiusCard}"/>
        <Setter Property="Padding"          Value="{DynamicResource PaddingCard}"/>
        <Setter Property="Margin"          Value="0,0,0,12"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Opacity="0.35" ShadowDepth="3" BlurRadius="10" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
        <Setter Property="CornerRadius"    Value="{DynamicResource CornerRadiusCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin"          Value="0,0,0,8"/>
        <Setter Property="Padding"         Value="4"/>
    </Style>

    <!-- Round colour swatch button - Click handled in code-behind, ring drawn
         around whichever one is currently selected. -->
    <Style x:Key="AccentSwatchStyle" TargetType="Button">
        <Setter Property="Width"   Value="32"/>
        <Setter Property="Height"  Value="32"/>
        <Setter Property="Margin"  Value="4,0"/>
        <Setter Property="Cursor"  Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Ring"
                                 Stroke="{DynamicResource BrushPrimaryGreen}"
                                 StrokeThickness="2.5"
                                 Width="32" Height="32"
                                 Visibility="Collapsed"/>
                        <Ellipse x:Name="Dot"
                                 Fill="{TemplateBinding Background}"
                                 Width="22" Height="22"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryGreen}"/>
        <Setter Property="FontSize"          Value="13"/>
        <Setter Property="FontWeight"        Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ToolText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Opacity"    Value="0.9"/>
    </Style>

    <Style x:Key="SecondaryBtn" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeButtonSecondary}"/>
        <Setter Property="Padding"         Value="{DynamicResource PaddingButtonSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CornerRadiusButtonSecondary}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrushSecondaryPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UpdateBtn" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BrushDanger}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeButtonSecondary}"/>
        <Setter Property="Padding"         Value="{DynamicResource PaddingButtonSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CornerRadiusButtonSecondary}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrushDangerHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrushDangerPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mac-style scrollbar -->
    <Style x:Key="ReloadBtn" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeButtonSecondary}"/>
        <Setter Property="Padding"         Value="{DynamicResource PaddingButtonSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CornerRadiusButtonSecondary}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IssuesBtn" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeButtonSecondary}"/>
        <Setter Property="Padding"         Value="{DynamicResource PaddingButtonSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CornerRadiusButtonSecondary}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrushSecondaryPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MacScrollBarThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="thumb"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            Margin="2,2,2,2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="thumb" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="thumb" Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MacScrollBar" TargetType="ScrollBar">
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="Width"       Value="8"/>
        <Setter Property="MinWidth"    Value="8"/>
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="GridRoot" Width="8">
                        <Track x:Name="PART_Track"
                               Orientation="Vertical"
                               IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource MacScrollBarThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GridRoot" Property="Width" Value="10"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MacScrollViewer" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Column="1"
                                   Orientation="Vertical"
                                   Style="{StaticResource MacScrollBar}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</Window.Resources>
<Grid>
<Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
</Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource BrushHeaderBg}" Height="{DynamicResource HeightTopBar}" CornerRadius="10,10,0,0">
        <DockPanel Margin="20,0,12,0">
            <Button x:Name="close_btn" DockPanel.Dock="Right"
                    Style="{StaticResource CloseButtonStyle}"
                    Content="&#x2716;"
                    VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                        VerticalAlignment="Center" Margin="0,0,16,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="header_update_btn"
                        Content="Update"
                        Style="{StaticResource UpdateBtn}"
                        Margin="0,0,8,0"/>
                <Button x:Name="issues_btn"
                        Content="Issues"
                        Style="{StaticResource IssuesBtn}"
                        Margin="0,0,8,0"/>
                <Button x:Name="footer_reload"
                        Content="Reload PyRevit"
                        Style="{StaticResource ReloadBtn}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image x:Name="header_icon"
                       Width="{DynamicResource SizeTopBarLogo}" Height="{DynamicResource SizeTopBarLogo}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
                <TextBlock Text="Seed" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrushPrimaryGreen}"/>
                <TextBlock Text="43"   FontSize="24" Foreground="{DynamicResource BrushTextPrimary}"/>
            </StackPanel>
        </DockPanel>
    </Border>

    <!-- Update ribbon (hidden until update detected) -->
    <Border x:Name="update_ribbon" Grid.Row="1" Visibility="Collapsed"
            Background="{DynamicResource BrushPrimaryGreen}" Cursor="Hand" Padding="20,8">
        <DockPanel>
            <TextBlock Text="&#x25B2;  Update Available &#x2014; click to update"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
            <TextBlock x:Name="update_ribbon_version"
                       Text="" FontSize="11"
                       Foreground="{DynamicResource BrushTextPrimary}" Opacity="0.85"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </DockPanel>
    </Border>

    <!-- Body -->
    <ScrollViewer Grid.Row="2" Style="{StaticResource MacScrollViewer}" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,16,20,20">

        <!-- Seed43 version card -->
        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <!-- Normal changelog view -->
                <StackPanel x:Name="card_normal">
                    <TextBlock x:Name="s43_title" Text="Checking..."
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushPrimaryGreen}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="s43_changelog" Text="" Visibility="Collapsed"/>
                    <ScrollViewer Style="{StaticResource MacScrollViewer}"
                                  MaxHeight="180">
                        <StackPanel x:Name="s43_changelog_panel"/>
                    </ScrollViewer>
                </StackPanel>

                <!-- Confirm overlay (shown when update clicked) -->
                <StackPanel x:Name="card_confirm" Visibility="Collapsed">
                    <TextBlock Text="Restore Seed43 from GitHub?"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushPrimaryGreen}" Margin="0,0,0,8"/>
                    <TextBlock Text="This will download the latest version and overwrite all scripts."
                               FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Opacity="0.9"
                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="Local config files (.json) will be preserved."
                               FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Opacity="0.9"
                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="Reload PyRevit after updating."
                               FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Opacity="0.9"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="confirm_cancel_btn" Content="Cancel"
                                Style="{StaticResource SecondaryBtn}"
                                Padding="12,4" Height="24" FontSize="11"
                                Margin="0,0,8,0"/>
                        <Button x:Name="confirm_yes_btn" Content="Yes, Update"
                                Style="{StaticResource ReloadBtn}"
                                Padding="12,4" Height="24" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Done overlay (shown when update complete) -->
                <StackPanel x:Name="card_done" Visibility="Collapsed">
                    <TextBlock x:Name="card_done_title"
                               Text="Seed43 Updated"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushPrimaryGreen}" Margin="0,0,0,8"/>
                    <StackPanel x:Name="card_done_panel" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="done_ok_btn" Content="OK"
                                Style="{StaticResource ReloadBtn}"
                                Padding="12,4" Height="24" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Appearance divider -->
        <TextBlock Text="APPEARANCE" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushPrimaryGreen}" Margin="0,16,0,8"/>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,14">
                    <Border x:Name="dark_mode_toggle" DockPanel.Dock="Left"
                            Width="{DynamicResource WidthToggle}" Height="{DynamicResource HeightToggle}"
                            CornerRadius="{DynamicResource CornerRadiusToggle}"
                            Cursor="Hand" Margin="0,0,10,0"/>
                    <TextBlock x:Name="dark_mode_toggle_tb" DockPanel.Dock="Left"
                               Text="Dark" FontSize="12"
                               VerticalAlignment="Center" Foreground="{DynamicResource BrushTextPrimary}"/>
                </DockPanel>
                <TextBlock Text="Accent Colour" FontSize="11"
                           Foreground="#A0AABB" Margin="0,0,0,8"/>
                <WrapPanel x:Name="accent_swatch_panel" Orientation="Horizontal"/>
            </StackPanel>
        </Border>

        <!-- Tools divider -->
        <TextBlock Text="TOOLS" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushPrimaryGreen}" Margin="0,16,0,8"/>

        <!-- Dynamic tool list populated by script -->
        <Border x:Name="tools_card"
                Background="{DynamicResource BrushCardBg}"
                CornerRadius="{DynamicResource CornerRadiusCard}"
                Padding="{DynamicResource PaddingCard}">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.35" ShadowDepth="3" BlurRadius="10" Direction="270"/>
            </Border.Effect>
            <ScrollViewer Style="{StaticResource MacScrollViewer}" MaxHeight="300">
                <StackPanel x:Name="tools_container"/>
            </ScrollViewer>
        </Border>

    </StackPanel>
    </ScrollViewer>

    <!-- Footer -->
    <Border Grid.Row="3" Background="{DynamicResource BrushHeaderBg}"
            BorderBrush="{DynamicResource BrushCardBg}"
            BorderThickness="0,1,0,0"
            CornerRadius="0,0,10,10"
            Padding="20,10">
        <Grid>
            <TextBlock Text="Special thanks to Jean-Marc Couffin &amp; all pyRevit contributors for pyRevit."
                       Foreground="{DynamicResource BrushTextPrimary}"
                       FontSize="10"
                       Opacity="0.55"
                       TextWrapping="Wrap"
                       Margin="0,0,20,0"/>
            <!-- Decorative resize-grip dots, bottom-right corner. Purely visual;
                 actual resizing is handled by WindowChrome's ResizeBorderThickness. -->
            <Canvas Width="16" Height="16"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    IsHitTestVisible="False">
                <Rectangle Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" Fill="{DynamicResource BrushTextPrimary}" Opacity="0.35"/>
                <Rectangle Canvas.Left="10" Canvas.Top="5"  Width="3" Height="3" Fill="{DynamicResource BrushTextPrimary}" Opacity="0.35"/>
                <Rectangle Canvas.Left="5"  Canvas.Top="10" Width="3" Height="3" Fill="{DynamicResource BrushTextPrimary}" Opacity="0.35"/>
                <Rectangle Canvas.Left="10" Canvas.Top="0"  Width="3" Height="3" Fill="{DynamicResource BrushTextPrimary}" Opacity="0.35"/>
                <Rectangle Canvas.Left="5"  Canvas.Top="5"  Width="3" Height="3" Fill="{DynamicResource BrushTextPrimary}" Opacity="0.35"/>
                <Rectangle Canvas.Left="0"  Canvas.Top="10" Width="3" Height="3" Fill="{DynamicResource BrushTextPrimary}" Opacity="0.35"/>
            </Canvas>
        </Grid>
    </Border>

</Grid>
</Window>
