<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Width="640"
        Height="820"
        MinWidth="560"
        MinHeight="680"
        Title="Batch Upgrade"
        Background="{DynamicResource BrushWindowBg}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Local fallbacks: apply_seed43_palette overwrites these at runtime,
             but the window still has to look right if the palette is missing. -->
        <SolidColorBrush x:Key="BrushWindowBg"             Color="#3B4553"/>
        <SolidColorBrush x:Key="BrushCardBg"               Color="#2B3340"/>
        <SolidColorBrush x:Key="BrushHeaderBg"             Color="#232933"/>
        <SolidColorBrush x:Key="BrushPrimaryGreen"         Color="#208A3C"/>
        <SolidColorBrush x:Key="BrushPrimaryGreenHover"    Color="#32934C"/>
        <SolidColorBrush x:Key="BrushPrimaryGreenPressed"  Color="#5CAA71"/>
        <SolidColorBrush x:Key="BrushTextPrimary"          Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushTextMuted"            Color="#9CA3AF"/>
        <SolidColorBrush x:Key="BrushTextInput"            Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushInputBg"              Color="#1d1d20"/>
        <SolidColorBrush x:Key="BrushBorderDefault"        Color="#208A3C"/>
        <SolidColorBrush x:Key="BrushSecondaryBg"          Color="#48484b"/>
        <SolidColorBrush x:Key="BrushSecondaryHover"       Color="#515155"/>
        <SolidColorBrush x:Key="BrushSecondaryPressed"     Color="#67676c"/>
        <SolidColorBrush x:Key="BrushSecondaryDisabledBg"  Color="#2e2e32"/>
        <SolidColorBrush x:Key="BrushSecondaryDisabledFg"  Color="#77767b"/>
        <SolidColorBrush x:Key="BrushDanger"               Color="#e01b24"/>
        <SolidColorBrush x:Key="BrushDangerHover"          Color="#E22D36"/>
        <SolidColorBrush x:Key="BrushSuccess"              Color="#27AE60"/>
        <SolidColorBrush x:Key="BrushPillOffBorder"        Color="#404553"/>

        <CornerRadius x:Key="CornerRadiusCard">8</CornerRadius>
        <CornerRadius x:Key="CornerRadiusButton">10</CornerRadius>
        <CornerRadius x:Key="CornerRadiusButtonSmall">4</CornerRadius>
        <CornerRadius x:Key="CornerRadiusInput">6</CornerRadius>
        <CornerRadius x:Key="CornerRadiusCheckbox">4</CornerRadius>
        <Thickness    x:Key="PaddingCard">16</Thickness>
        <Thickness    x:Key="PaddingButtonPrimary">15,7,15,7</Thickness>
        <Thickness    x:Key="PaddingButtonSmall">12,4,12,4</Thickness>
        <Thickness    x:Key="PaddingInput">8,4,8,4</Thickness>
        <Thickness    x:Key="BorderThicknessInput">1</Thickness>
        <Thickness    x:Key="BorderThicknessCheckbox">1.5</Thickness>
        <sys:Double   x:Key="FontSizeButton">12</sys:Double>
        <sys:Double   x:Key="FontSizeButtonSmall">11</sys:Double>
        <sys:Double   x:Key="FontSizeInput">12</sys:Double>
        <sys:Double   x:Key="FontSizeSectionLabel">14</sys:Double>
        <sys:Double   x:Key="FontSizeFieldLabel">12</sys:Double>
        <sys:Double   x:Key="FontSizeBody">12</sys:Double>
        <sys:Double   x:Key="HeightInput">28</sys:Double>
        <sys:Double   x:Key="HeightButtonSmall">24</sys:Double>
        <sys:Double   x:Key="SizeCheckbox">16</sys:Double>
        <sys:Double   x:Key="SizeTopBarLogo">28</sys:Double>
        <sys:Double   x:Key="FontSizeMenuItem">12</sys:Double>
        <Thickness    x:Key="PaddingMenuItem">12,8,12,8</Thickness>

        <!-- ── Buttons ─────────────────────────────────────────────────── -->

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BrushPrimaryGreen}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeButton}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="{DynamicResource PaddingButtonPrimary}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="MinWidth"        Value="130"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButton}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="MinWidth"   Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButton}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeButtonSmall}"/>
            <Setter Property="Height"   Value="{DynamicResource HeightButtonSmall}"/>
            <Setter Property="Padding"  Value="{DynamicResource PaddingButtonSmall}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin"   Value="6,0,0,0"/>
        </Style>

        <Style x:Key="WinCtrlCloseBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushDanger}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Inputs ──────────────────────────────────────────────────── -->

        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextInput}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorderDefault}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessInput}"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeInput}"/>
            <Setter Property="Padding"         Value="{DynamicResource PaddingInput}"/>
            <Setter Property="Height"          Value="{DynamicResource HeightInput}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly"      Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusInput}">
                            <!-- No Padding/Margin="{TemplateBinding Padding}" here.
                                 WPF already applies TextBox.Padding to the element
                                 named PART_ContentHost, so setting it again doubles
                                 it - text clipped top and bottom. -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VersionCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeFieldLabel}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Margin"     Value="0,4,18,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="{DynamicResource SizeCheckbox}"
                                    Height="{DynamicResource SizeCheckbox}"
                                    Background="{DynamicResource BrushInputBg}"
                                    BorderBrush="{DynamicResource BrushBorderDefault}"
                                    BorderThickness="{DynamicResource BorderThicknessCheckbox}"
                                    CornerRadius="{DynamicResource CornerRadiusCheckbox}"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick"
                                      Data="M 3,7.5 L 6,10.5 L 11.5,4.5"
                                      Stroke="{DynamicResource BrushTextPrimary}"
                                      StrokeThickness="2"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box"  Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                                <Setter TargetName="Box" Property="Background"  Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeFieldLabel}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── Hamburger menu ──────────────────────────────────────────── -->

        <Style x:Key="HamburgerMenuItem" TargetType="Button">
            <Setter Property="Background"                Value="Transparent"/>
            <Setter Property="Foreground"                Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness"           Value="0"/>
            <Setter Property="Padding"                   Value="{DynamicResource PaddingMenuItem}"/>
            <Setter Property="FontSize"                  Value="{DynamicResource FontSizeMenuItem}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HamburgerToggle" TargetType="ToggleButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Width"           Value="36"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="6" Width="36" Height="36">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Schedule card ───────────────────────────────────────────────
             Local copies of the styles pySheets' schedule card uses, same
             keys and values. Nothing in the extension merges
             lib/Snippets/Seed43Styles.xaml - every window carries its own
             set - so these are duplicated on purpose, not by oversight. -->

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"   Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusCard}"/>
            <Setter Property="Padding"      Value="{DynamicResource PaddingCard}"/>
            <Setter Property="Margin"       Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.2" ShadowDepth="2" BlurRadius="4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallSecBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="FontSize"   Value="{DynamicResource FontSizeButtonSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="{DynamicResource PaddingButtonSmall}"/>
            <Setter Property="MinWidth"   Value="0"/>
        </Style>

        <Style x:Key="SmallSecToggle" TargetType="ToggleButton">
            <Setter Property="Background"      Value="{DynamicResource BrushSecondaryBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeButtonSmall}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="{DynamicResource PaddingButtonSmall}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButtonSmall}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkDatePicker" TargetType="DatePicker">
            <Setter Property="Background"      Value="{DynamicResource BrushSecondaryBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BrushPillOffBorder}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessInput}"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeInput}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="{DynamicResource PaddingInput}"/>
            <Setter Property="Height"          Value="{DynamicResource HeightInput}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid x:Name="PART_Root">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource CornerRadiusInput}">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePickerTextBox x:Name="PART_TextBox"
                                                       Grid.Column="0"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       FontWeight="{TemplateBinding FontWeight}"
                                                       CaretBrush="{DynamicResource BrushTextPrimary}"
                                                       VerticalContentAlignment="Center"
                                                       Focusable="{TemplateBinding IsTabStop}">
                                        <DatePickerTextBox.Template>
                                            <ControlTemplate TargetType="DatePickerTextBox">
                                                <Border Background="Transparent" BorderThickness="0">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Focusable="False"
                                                                  HorizontalScrollBarVisibility="Hidden"
                                                                  VerticalScrollBarVisibility="Hidden"/>
                                                </Border>
                                            </ControlTemplate>
                                        </DatePickerTextBox.Template>
                                    </DatePickerTextBox>
                                    <Button x:Name="PART_Button"
                                            Grid.Column="1"
                                            Width="18" Height="18"
                                            Margin="4,0,0,0"
                                            Cursor="Hand"
                                            Focusable="False">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="IconBd" Background="Transparent" CornerRadius="4">
                                                    <Path Data="M3,2 L3,4 M11,2 L11,4 M2,5 L12,5 M2,4 L12,4 L12,13 L2,13 Z"
                                                          Stroke="{DynamicResource BrushTextPrimary}"
                                                          StrokeThickness="1.1"
                                                          Opacity="0.85"
                                                          Width="13" Height="13"
                                                          Stretch="Uniform"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="IconBd" Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Popup x:Name="PART_Popup"
                                           Grid.ColumnSpan="2"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ── Header ──────────────────────────────────────────────────── -->
        <Border Background="{DynamicResource BrushHeaderBg}" Height="56"
                DockPanel.Dock="Top" CornerRadius="10,10,12,12">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="2" BlurRadius="6"/>
            </Border.Effect>
            <Grid Margin="20,0,16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <!-- Source set from Python by Snippets._icons.set_header_icon -->
                    <Image x:Name="header_icon"
                           Width="{DynamicResource SizeTopBarLogo}"
                           Height="{DynamicResource SizeTopBarLogo}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                    <TextBlock Text="Batch" FontWeight="Bold" FontSize="22"
                               Foreground="{DynamicResource BrushPrimaryGreen}"/>
                    <TextBlock Text="Upgrade" FontWeight="Bold" FontSize="22"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="  |  Revit Files" FontSize="14"
                               Foreground="{DynamicResource BrushTextPrimary}" Opacity="0.6"
                               VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid Margin="0,0,4,0">
                        <ToggleButton x:Name="settings_toggle_btn"
                                      Style="{StaticResource HamburgerToggle}"
                                      ToolTip="Menu"/>
                        <Popup x:Name="settings_popup"
                               PlacementTarget="{Binding ElementName=settings_toggle_btn}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               IsOpen="{Binding ElementName=settings_toggle_btn, Path=IsChecked}">
                            <Border Background="{DynamicResource BrushCardBg}"
                                    BorderBrush="{DynamicResource BrushPrimaryGreen}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MinWidth="200">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.25" ShadowDepth="2" BlurRadius="8"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Button x:Name="help_btn"
                                            Content="&#x2709;  Email support"
                                            Style="{StaticResource HamburgerMenuItem}"/>
                                    <Button x:Name="issue_btn"
                                            Content="Report an issue on GitHub"
                                            Style="{StaticResource HamburgerMenuItem}"/>
                                    <Rectangle Fill="{DynamicResource BrushSecondaryBg}" Height="1" Margin="0,2"/>
                                    <Button x:Name="about_btn"
                                            Content="&#8505;  About Batch Upgrade"
                                            Style="{StaticResource HamburgerMenuItem}"/>
                                    <Rectangle Fill="{DynamicResource BrushSecondaryBg}" Height="1" Margin="0,2"/>
                                    <Button x:Name="support_btn"
                                            Content="&#9749;  Support this project and help us grow"
                                            Style="{StaticResource HamburgerMenuItem}"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button x:Name="win_close_btn"
                            Content="&#10005;"
                            Style="{StaticResource WinCtrlCloseBtn}"
                            VerticalAlignment="Center"
                            ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Footer ──────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" Margin="20,0,20,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="cancel_btn" Content="Cancel" Style="{StaticResource SecondaryBtn}"/>
                <Button x:Name="upgrade_btn" Content="Upgrade" Style="{StaticResource PrimaryBtn}" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── Body ────────────────────────────────────────────────────── -->
        <Border Background="{DynamicResource BrushCardBg}"
                CornerRadius="{DynamicResource CornerRadiusCard}"
                Padding="{DynamicResource PaddingCard}"
                Margin="20,12,20,12">
            <DockPanel>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock Text="Launch each Revit version to save upgraded copies."
                               Foreground="{DynamicResource BrushTextMuted}"
                               FontSize="{DynamicResource FontSizeBody}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="running_lbl" Text="Running: —"
                               Foreground="{DynamicResource BrushTextMuted}"
                               FontSize="{DynamicResource FontSizeBody}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Source files:" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="count_lbl" Text="0 file(s)" Margin="8,0,0,0"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="add_files_btn"  Content="Add Files..."  Style="{StaticResource SmallBtn}"/>
                        <Button x:Name="add_folder_btn" Content="Add Folder..." Style="{StaticResource SmallBtn}"/>
                        <Button x:Name="clear_btn"      Content="Clear"         Style="{StaticResource SmallBtn}"/>
                    </StackPanel>
                </Grid>

                <!-- Output folder, targets and the warning line all dock to the
                     bottom so the file list is the only part that grows. -->
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="Output folder:" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="out_tb" Grid.Column="0"
                                 Style="{StaticResource PathBox}"
                                 Text="(no output folder selected)"/>
                        <Button x:Name="browse_btn" Grid.Column="1" Content="Browse"
                                Style="{StaticResource SecondaryBtn}"
                                MinWidth="80" Margin="8,0,0,0"/>
                    </Grid>

                    <TextBlock Text="Target Revit versions:" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>
                    <Border Background="{DynamicResource BrushInputBg}"
                            BorderBrush="{DynamicResource BrushBorderDefault}"
                            BorderThickness="{DynamicResource BorderThicknessInput}"
                            CornerRadius="{DynamicResource CornerRadiusInput}"
                            Padding="12,8,12,8">
                        <WrapPanel x:Name="version_panel" Orientation="Horizontal"/>
                    </Border>

                    <!-- Schedule card - laid out like pySheets': what to run,
                         Enable to arm it, then the timing unlocks. Repeat and
                         the Mon-Sun row are deliberately absent; schedule_io
                         only ever arms a single one-shot run. -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Schedule (Revit must stay open)"
                                       Style="{StaticResource SectionLabel}"
                                       FontSize="13" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBlock Text="Runs the files, output folder and versions set above, once, then clears itself."
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <CheckBox x:Name="sched_enable_cb"
                                          Content="Enable"
                                          Style="{StaticResource VersionCheck}"
                                          DockPanel.Dock="Left"
                                          VerticalAlignment="Center" Margin="0,0,16,0"
                                          ToolTip="Arm this run - the files, output folder and versions set above run at the time below, with this window closed"/>
                                <TextBlock Text="Time"
                                           DockPanel.Dock="Left"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           Opacity="0.7" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Grid DockPanel.Dock="Left" Margin="0,0,16,0">
                                    <ToggleButton x:Name="sched_time_btn"
                                                  Content="— : — —"
                                                  Width="100" Height="26"
                                                  IsEnabled="False"
                                                  Style="{StaticResource SmallSecToggle}"
                                                  FontFamily="Consolas" FontSize="12"/>
                                    <Popup x:Name="sched_time_popup"
                                           PlacementTarget="{Binding ElementName=sched_time_btn}"
                                           Placement="Bottom"
                                           AllowsTransparency="True"
                                           StaysOpen="False"
                                           IsOpen="{Binding ElementName=sched_time_btn, Path=IsChecked}">
                                        <Border Background="{DynamicResource BrushCardBg}"
                                                BorderBrush="{DynamicResource BrushPrimaryGreen}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Opacity="0.25"
                                                                  ShadowDepth="2" BlurRadius="8"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <Grid ClipToBounds="True">
                                                    <!-- Centre band marking the selected row -->
                                                    <Border Background="#33208A3C"
                                                            BorderBrush="{DynamicResource BrushPrimaryGreen}"
                                                            BorderThickness="0,1,0,1"
                                                            Height="30" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Center">
                                                        <StackPanel x:Name="tp_hours"/>
                                                        <TextBlock Text=":" FontSize="15" FontWeight="Bold"
                                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="2,0,2,0"/>
                                                        <StackPanel x:Name="tp_minutes" Margin="0,0,10,0"/>
                                                        <StackPanel x:Name="tp_ampm"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            Margin="0,8,0,0">
                                                    <Button x:Name="tp_ok_btn" Content="OK"
                                                            Width="60"
                                                            Style="{StaticResource SmallSecBtn}"
                                                            Margin="0,0,6,0"/>
                                                    <Button x:Name="tp_cancel_btn" Content="Cancel"
                                                            Width="60"
                                                            Style="{StaticResource SmallSecBtn}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <TextBlock Text="Starting Date"
                                           DockPanel.Dock="Left"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           Opacity="0.7" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="sched_date_dp"
                                            Width="130" IsEnabled="False"
                                            DockPanel.Dock="Left"
                                            Style="{StaticResource DarkDatePicker}"
                                            VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock x:Name="sched_status_tb"
                                           DockPanel.Dock="Left"
                                           Text="Schedule off"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource BrushPrimaryGreen}"
                                           FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="sched_remove_btn"
                                        DockPanel.Dock="Right"
                                        Content="Remove"
                                        Style="{StaticResource SmallSecBtn}"
                                        Visibility="Collapsed"
                                        ToolTip="Delete the saved schedule"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="warn_lbl" Text=""
                               Foreground="{DynamicResource BrushDanger}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <Border Background="{DynamicResource BrushInputBg}"
                        BorderBrush="{DynamicResource BrushBorderDefault}"
                        BorderThickness="{DynamicResource BorderThicknessInput}"
                        CornerRadius="{DynamicResource CornerRadiusInput}"
                        MinHeight="150">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="10,8,10,8">
                        <StackPanel x:Name="file_list_panel"/>
                    </ScrollViewer>
                </Border>

            </DockPanel>
        </Border>
    </DockPanel>
</Window>
