<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BREAK TIME"
    Width="800" Height="620"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    Background="#0D0D0D"
    FontFamily="Courier New"
    FontSize="13"
    Foreground="#00FF41">

    <Window.Resources>
        <!-- CRT scanline brush overlay -->
        <DrawingBrush x:Key="ScanlineBrush" TileMode="Tile"
                      Viewport="0,0,1,4" ViewportUnits="Absolute"
                      Viewbox="0,0,1,4" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#08000000">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,1,2"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid>
        <!-- Main layout -->
        <DockPanel>

            <!-- Header bar -->
            <Border DockPanel.Dock="Top"
                    Background="#001A00"
                    BorderBrush="#00FF41"
                    BorderThickness="0,0,0,1"
                    Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Game title left -->
                    <TextBlock x:Name="GameTitle"
                               Grid.Column="0"
                               Text="SEED43 BREAK TIME"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#00FF41"
                               VerticalAlignment="Center"/>

                    <!-- DOS prompt centre decoration -->
                    <TextBlock Grid.Column="1"
                               Text="C:\SEED43\GAMES\&gt;_"
                               FontSize="11"
                               Foreground="#005500"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <!-- Countdown right -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="TIME REMAINING: "
                                   FontSize="13"
                                   Foreground="#007700"/>
                        <TextBlock x:Name="CountdownLabel"
                                   Text="2:00"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#00FF41"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Score / status bar -->
            <Border DockPanel.Dock="Bottom"
                    Background="#001A00"
                    BorderBrush="#00FF41"
                    BorderThickness="0,1,0,0"
                    Padding="12,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusLabel"
                               Grid.Column="0"
                               Text="PRESS ANY KEY TO START"
                               Foreground="#007700"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="ScoreLabel"
                               Grid.Column="1"
                               Text="SCORE: 0"
                               Foreground="#00FF41"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Game canvas area -->
            <Grid DockPanel.Dock="Top">
                <Canvas x:Name="GameCanvas"
                        Background="#0D0D0D"
                        Focusable="True"
                        ClipToBounds="True"/>
                <!-- Scanline overlay on top -->
                <Rectangle IsHitTestVisible="False"
                           OpacityMask="{StaticResource ScanlineBrush}"
                           Fill="#0A00FF00"
                           IsEnabled="False"/>
            </Grid>

        </DockPanel>
    </Grid>
</Window>
