<!--
===================================================================================
Seed43Styles.xaml  —  Shared Resource Dictionary
===================================================================================
Merge this into any Seed43 window to get the full style set.

Usage in each window:
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Seed43Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

Styles defined here:
    Colour Palette (SolidColorBrush)
    CardStyle                  — Border
    SectionLabelStyle          — TextBlock
    FieldLabelStyle            — TextBlock
    HeadingRunStyle            — Run (modal headings)
    ModernTextBoxStyle         — TextBox
    GridCellStyle              — TextBox (inline grid/form cells)
    ModernComboBoxStyle        — ComboBox
    ModernButtonStyle          — Button (primary)
    SmallButtonStyle           — Button (small inline / header)
    SecondaryButtonStyle       — Button (inactive tab / cancel)
    CloseButtonStyle           — Button (panel close ✖)
    OptionsToggleButtonStyle   — ToggleButton (hamburger ☰)
    MenuItemButtonStyle        — Button (popup menu items)
    ModernDataGridStyle        — DataGrid
    DataGridColumnHeaderStyle  — DataGridColumnHeader
    DataGridCellStyle          — DataGridCell
    DataGridRowStyle           — DataGridRow
    MacScrollBarThumb          — Thumb
    MacScrollBar               — ScrollBar
    MacScrollViewer            — ScrollViewer

Window-specific styles (NOT here):
    LayoutSettings.xaml  →  PBtn, GBtn, IBtn, TBtn, MCB, MTB, SecLbl
===================================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ==========================================================================
         COLOUR PALETTE
    ========================================================================== -->

    <!-- Primary Green -->
    <SolidColorBrush x:Key="BrushPrimaryGreen"        Color="#208A3C"/>
    <SolidColorBrush x:Key="BrushPrimaryGreenHover"   Color="#2B933F"/>
    <SolidColorBrush x:Key="BrushPrimaryGreenPressed" Color="#1A6E2E"/>
    <SolidColorBrush x:Key="BrushPrimaryGreenAlt"     Color="#1A6B2F"/>

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BrushWindowBg"            Color="#3B4553"/>
    <SolidColorBrush x:Key="BrushCardBg"              Color="#2B3340"/>
    <SolidColorBrush x:Key="BrushHeaderBg"            Color="#232933"/>

    <!-- Text -->
    <SolidColorBrush x:Key="BrushTextPrimary"         Color="#F4FAFF"/>
    <SolidColorBrush x:Key="BrushTextInput"           Color="#2B3340"/>

    <!-- Input / Border -->
    <SolidColorBrush x:Key="BrushInputBg"             Color="#F4FAFF"/>
    <SolidColorBrush x:Key="BrushInputBgHover"        Color="#F4FAFF"/>
    <SolidColorBrush x:Key="BrushInputBgPressed"      Color="#F4FAFF"/>
    <SolidColorBrush x:Key="BrushBorderDefault"       Color="#208A3C"/>
    <SolidColorBrush x:Key="BrushBorderHover"         Color="#2B933F"/>
    <SolidColorBrush x:Key="BrushBorderPressed"       Color="#1A6E2E"/>
    <SolidColorBrush x:Key="BrushBorderMuted"         Color="#208A3C"/>

    <!-- Dropdown -->
    <SolidColorBrush x:Key="BrushDropdownItemHover"   Color="#3A4553"/>

    <!-- Toggle switch -->
    <SolidColorBrush x:Key="BrushToggleOffBg"         Color="#A0AABB"/>
    <SolidColorBrush x:Key="BrushToggleOffHover"      Color="#A0AABB"/>
    <SolidColorBrush x:Key="BrushToggleOffPressed"    Color="#A0AABB"/>
    <SolidColorBrush x:Key="BrushToggleKnob"          Color="#FFFFFF"/>

    <!-- Secondary Button -->
    <SolidColorBrush x:Key="BrushSecondaryBg"         Color="#404553"/>
    <SolidColorBrush x:Key="BrushSecondaryHover"      Color="#4E5566"/>
    <SolidColorBrush x:Key="BrushSecondaryPressed"    Color="#333B48"/>
    <SolidColorBrush x:Key="BrushSecondaryDisabledBg" Color="#555555"/>
    <SolidColorBrush x:Key="BrushSecondaryDisabledFg" Color="#888888"/>

    <!-- Danger / Delete -->
    <SolidColorBrush x:Key="BrushDanger"              Color="#C53030"/>
    <SolidColorBrush x:Key="BrushDangerHover"         Color="#C53030"/>
    <SolidColorBrush x:Key="BrushDangerPressed"       Color="#C53030"/>

    <!-- Popup / Menu -->
    <SolidColorBrush x:Key="BrushPopupBg"             Color="#2B3340"/>
    <SolidColorBrush x:Key="BrushPopupBorder"         Color="#208A3C"/>
    <SolidColorBrush x:Key="BrushMenuDivider"         Color="#404553"/>

    <!-- Close button hover/pressed -->
    <SolidColorBrush x:Key="BrushCloseHover"          Color="#FF5555"/>
    <SolidColorBrush x:Key="BrushClosePressed"        Color="#CC4444"/>


    <!-- ==========================================================================
         CARD
    ========================================================================== -->

    <!-- ==========================================================================
         SIZING PALETTE - defaults match seed43_palette.json's "dimensions"
         block; seed43_theme.apply_seed43_dimensions() overwrites these at
         runtime, same call-order rule as the colours (call after load).
    ========================================================================== -->
    <CornerRadius x:Key="CornerRadiusButton">6</CornerRadius>
    <Thickness    x:Key="PaddingButtonPrimary">24,8,24,8</Thickness>
    <sys:Double   x:Key="FontSizeButton">14</sys:Double>

    <sys:Double   x:Key="HeightButtonSmall">24</sys:Double>
    <Thickness    x:Key="PaddingButtonSmall">12,4,12,4</Thickness>
    <CornerRadius x:Key="CornerRadiusButtonSmall">4</CornerRadius>
    <sys:Double   x:Key="FontSizeButtonSmall">11</sys:Double>

    <Thickness    x:Key="PaddingButtonSecondary">16,8,16,8</Thickness>
    <CornerRadius x:Key="CornerRadiusButtonSecondary">6</CornerRadius>
    <sys:Double   x:Key="FontSizeButtonSecondary">12</sys:Double>

    <sys:Double   x:Key="WidthButtonClose">30</sys:Double>
    <sys:Double   x:Key="HeightButtonClose">30</sys:Double>
    <CornerRadius x:Key="CornerRadiusButtonClose">15</CornerRadius>

    <!-- button_menu: square-ish (lightly rounded), distinct from button_close's
         fully-round shape - e.g. a hamburger/options toggle, not a close button. -->
    <sys:Double   x:Key="WidthButtonMenu">36</sys:Double>
    <sys:Double   x:Key="HeightButtonMenu">36</sys:Double>
    <CornerRadius x:Key="CornerRadiusButtonMenu">6</CornerRadius>

    <sys:Double   x:Key="HeightInput">28</sys:Double>
    <Thickness    x:Key="PaddingInput">8,4,8,4</Thickness>
    <CornerRadius x:Key="CornerRadiusInput">6</CornerRadius>
    <Thickness    x:Key="BorderThicknessInput">1</Thickness>
    <sys:Double   x:Key="FontSizeInput">12</sys:Double>

    <sys:Double   x:Key="HeightCombobox">28</sys:Double>
    <Thickness    x:Key="PaddingCombobox">8,4,8,4</Thickness>
    <CornerRadius x:Key="CornerRadiusCombobox">6</CornerRadius>
    <sys:Double   x:Key="FontSizeCombobox">12</sys:Double>

    <sys:Double   x:Key="WidthFilterCombo">20</sys:Double>
    <sys:Double   x:Key="HeightFilterCombo">20</sys:Double>
    <CornerRadius x:Key="CornerRadiusFilterCombo">4</CornerRadius>

    <CornerRadius x:Key="CornerRadiusDropdownPopup">6</CornerRadius>
    <sys:Double   x:Key="MinWidthDropdownPopup">160</sys:Double>
    <Thickness    x:Key="PaddingDropdownItem">8,4,8,4</Thickness>
    <CornerRadius x:Key="CornerRadiusDropdownItem">4</CornerRadius>
    <sys:Double   x:Key="SizeDropdownArrow">10</sys:Double>

    <sys:Double   x:Key="HeightTopBar">64</sys:Double>
    <CornerRadius x:Key="CornerRadiusWindow">10</CornerRadius>
    <sys:Double   x:Key="SizeTopBarLogo">28</sys:Double>

    <sys:Double   x:Key="WidthToggle">40</sys:Double>
    <sys:Double   x:Key="HeightToggle">20</sys:Double>
    <CornerRadius x:Key="CornerRadiusToggle">10</CornerRadius>
    <sys:Double   x:Key="SizeToggleKnob">16</sys:Double>
    <CornerRadius x:Key="CornerRadiusToggleKnob">8</CornerRadius>
    <sys:Double   x:Key="MarginToggleKnob">2</sys:Double>

    <CornerRadius x:Key="CornerRadiusCard">8</CornerRadius>
    <Thickness    x:Key="PaddingCard">16</Thickness>

    <sys:Double   x:Key="SizeIconDefault">16</sys:Double>

    <sys:Double   x:Key="FontSizeSectionLabel">14</sys:Double>
    <sys:Double   x:Key="FontSizeFieldLabel">12</sys:Double>
    <sys:Double   x:Key="FontSizeHeading">13</sys:Double>
    <sys:Double   x:Key="FontSizeBody">12</sys:Double>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
        <Setter Property="CornerRadius"  Value="{DynamicResource CornerRadiusCard}"/>
        <Setter Property="Padding"       Value="{DynamicResource PaddingCard}"/>
        <Setter Property="Margin"        Value="0,0,0,12"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Opacity="0.2" ShadowDepth="2" BlurRadius="4"/>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ==========================================================================
         TEXT
    ========================================================================== -->

    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryGreen}"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="FontSize"    Value="14"/>
        <Setter Property="Margin"      Value="0,0,0,8"/>
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="FontWeight"  Value="Medium"/>
        <Setter Property="FontSize"    Value="12"/>
        <Setter Property="Margin"      Value="0,0,0,4"/>
        <Setter Property="Opacity"     Value="0.9"/>
    </Style>

    <!-- For bold headings inside modal TextBlocks -->
    <Style x:Key="HeadingRunStyle" TargetType="Run">
        <Setter Property="FontWeight"  Value="Bold"/>
        <Setter Property="FontSize"    Value="13"/>
    </Style>


    <!-- ==========================================================================
         INPUTS
    ========================================================================== -->

    <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource BrushInputBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextInput}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness"          Value="{DynamicResource BorderThicknessInput}"/>
        <Setter Property="Padding"                  Value="{DynamicResource PaddingInput}"/>
        <Setter Property="FontSize"                 Value="{DynamicResource FontSizeInput}"/>
        <Setter Property="Height"                   Value="{DynamicResource HeightInput}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                            <Setter TargetName="MainBorder" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact TextBox for use inside DataGrid rows or dense form grids -->
    <Style x:Key="GridCellStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource BrushInputBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextInput}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness"          Value="1"/>
        <Setter Property="Padding"                  Value="6,3"/>
        <Setter Property="FontSize"                 Value="11"/>
        <Setter Property="Height"                   Value="26"/>
        <Setter Property="Margin"                   Value="0,0,6,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                            <Setter TargetName="MainBorder" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource BrushInputBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextInput}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="{DynamicResource PaddingCombobox}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeCombobox}"/>
        <Setter Property="Height"          Value="{DynamicResource HeightCombobox}"/>
        <Setter Property="Margin"          Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Border x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <Path x:Name="Arrow"
                                      Fill="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0"
                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource BrushInputBg}"
                                        BorderBrush="{DynamicResource BrushBorderDefault}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource CornerRadiusDropdownPopup}"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                            <Setter TargetName="MainBorder" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ==========================================================================
         BUTTONS
    ========================================================================== -->

    <!-- Primary action button — Save, Generate, Execute -->
    <Style x:Key="ModernButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="{DynamicResource PaddingButtonPrimary}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeButton}"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CornerRadiusButton}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small inline button — Browse, Add, Export (header), Generate Report (header)
         Also used for Delete with Background="#C53030" override on the instance -->
    <Style x:Key="SmallButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="{DynamicResource PaddingButtonSmall}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeButtonSmall}"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Height"          Value="{DynamicResource HeightButtonSmall}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CornerRadiusButtonSmall}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary/inactive button — inactive tabs, Cancel, secondary options -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="{DynamicResource PaddingButtonSecondary}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeButtonSecondary}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CornerRadiusButtonSecondary}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Panel close button — use Content="&#x2716;" on the instance -->
    <Style x:Key="CloseButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="Width"           Value="{DynamicResource WidthButtonClose}"/>
        <Setter Property="Height"          Value="{DynamicResource HeightButtonClose}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CornerRadiusButtonClose}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource BrushCloseHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource BrushClosePressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hamburger menu toggle — set Content="☰" on the instance -->
    <Style x:Key="OptionsToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize"        Value="18"/>
        <Setter Property="Width"           Value="40"/>
        <Setter Property="Height"          Value="40"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource BrushPrimaryGreenAlt}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Items inside the options popup menu -->
    <Style x:Key="MenuItemButtonStyle" TargetType="Button">
        <Setter Property="Background"                Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness"           Value="0"/>
        <Setter Property="Padding"                   Value="12,8"/>
        <Setter Property="FontSize"                  Value="12"/>
        <Setter Property="HorizontalAlignment"       Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor"                    Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource BrushPrimaryGreenAlt}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ==========================================================================
         DATAGRID
    ========================================================================== -->

    <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness"      Value="0"/>
        <Setter Property="GridLinesVisibility"  Value="None"/>
        <Setter Property="HeadersVisibility"    Value="Column"/>
        <Setter Property="AutoGenerateColumns"  Value="False"/>
        <Setter Property="CanUserAddRows"        Value="False"/>
        <Setter Property="CanUserDeleteRows"     Value="False"/>
        <Setter Property="SelectionMode"         Value="Extended"/>
        <Setter Property="SelectionUnit"         Value="FullRow"/>
        <Setter Property="RowHeight"             Value="28"/>
        <Setter Property="ColumnHeaderHeight"    Value="36"/>
        <Setter Property="FontSize"              Value="12"/>
    </Style>

    <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource BrushHeaderBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="FontWeight"                 Value="SemiBold"/>
        <Setter Property="FontSize"                   Value="12"/>
        <Setter Property="Padding"                    Value="12,8"/>
        <Setter Property="BorderThickness"            Value="0,0,1,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushHeaderBg}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="10,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="CellBorder"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="CellBorder" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                            <Setter Property="Foreground"                          Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
    </Style>


    <!-- ==========================================================================
         SCROLLBAR  (macOS-style green, slim)
    ========================================================================== -->

    <Style x:Key="MacScrollBarThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="thumb"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            Margin="2,2,2,2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="thumb" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="thumb" Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MacScrollBar" TargetType="ScrollBar">
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="Width"       Value="8"/>
        <Setter Property="MinWidth"    Value="8"/>
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="GridRoot" Width="8">
                        <Track x:Name="PART_Track"
                               Orientation="Vertical"
                               IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource MacScrollBarThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GridRoot" Property="Width" Value="10"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MacScrollViewer" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Column="1"
                                   Orientation="Vertical"
                                   Style="{StaticResource MacScrollBar}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
