<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="View Organiser Setup"
        Width="560" Height="780" MinWidth="480" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushWindowBg}"
        TextElement.FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" CornerRadius="10"
                             GlassFrameThickness="0" ResizeBorderThickness="12"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="LocalBrushNoticeBg"   Color="#1E2730"/>
        <SolidColorBrush x:Key="LocalBrushNoticeText" Color="#7EC8A0"/>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="{DynamicResource WidthButtonClose}"/>
            <Setter Property="Height"          Value="{DynamicResource HeightButtonClose}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusButtonClose}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushDanger}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CardStyle stays local for now: it carries a Margin and
             DropShadowEffect the canonical Seed43Styles.xaml CardStyle
             doesn't have yet - removing it here first would silently drop
             both. Needs the generator fixed to include them before this
             can safely move to the shared file. -->
        <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background"    Value="{DynamicResource BrushCardBg}"/>
                <Setter Property="CornerRadius"  Value="{DynamicResource CornerRadiusCard}"/>
                <Setter Property="Padding"       Value="{DynamicResource PaddingCard}"/>
                <Setter Property="Margin"        Value="0,0,0,12"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="Black" Opacity="0.2" ShadowDepth="2" BlurRadius="4"/>
                    </Setter.Value>
                </Setter>
            </Style>

        <!-- SectionLabelStyle / FieldLabelStyle: kept local. Every real
             usage throughout this file is Style="{StaticResource ...}",
             which (like BasedOn) requires the target to exist at XAML
             parse time - removing these and relying on the post-load
             merge would make the whole window fail to load, not just
             render unstyled. This applies to every style referenced via
             StaticResource anywhere in this file, not just these two -
             see the note in Window.Resources' opening comment. -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="{DynamicResource BrushPrimaryGreen}"/>
                <Setter Property="FontWeight"  Value="SemiBold"/>
                <Setter Property="FontSize"    Value="{DynamicResource FontSizeSectionLabel}"/>
                <Setter Property="Margin"      Value="0,0,0,8"/>
            </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="{DynamicResource BrushTextPrimary}"/>
                <Setter Property="FontWeight"  Value="Medium"/>
                <Setter Property="FontSize"    Value="{DynamicResource FontSizeFieldLabel}"/>
                <Setter Property="Margin"      Value="0,0,0,4"/>
                <Setter Property="Opacity"     Value="0.9"/>
            </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background"      Value="{DynamicResource BrushInputBg}"/>
                <Setter Property="Foreground"      Value="{DynamicResource BrushTextInput}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorderDefault}"/>
                <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessInput}"/>
                <Setter Property="Padding"         Value="{DynamicResource PaddingCombobox}"/>
                <Setter Property="FontSize"        Value="{DynamicResource FontSizeCombobox}"/>
                <Setter Property="Height"          Value="{DynamicResource HeightCombobox}"/>
                <Setter Property="Margin"          Value="0,0,0,10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource CornerRadiusCombobox}">
                                <Grid>
                                    <ToggleButton x:Name="ToggleButton"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press">
                                        <!-- Blank template: a plain ToggleButton without one falls back to
                                             the classic Windows chrome, which (a) centres its content in a
                                             ContentPresenter regardless of the child's own alignment, and
                                             (b) paints its own system-blue hover/pressed highlight on top of
                                             ours. Both were the cause of the mis-centred arrow and the wrong
                                             hover colour/shape. -->
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <Path x:Name="Arrow"
                                              Fill="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"
                                              Data="M 0 0 L 4 4 L 8 0 Z"/>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="ContentSite"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>
                                    <Popup x:Name="Popup"
                                           Placement="Bottom"
                                           IsOpen="{TemplateBinding IsDropDownOpen}"
                                           AllowsTransparency="True"
                                           Focusable="False"
                                           PopupAnimation="Slide">
                                        <Border Background="{DynamicResource BrushCardBg}"
                                                BorderBrush="{DynamicResource BrushBorderDefault}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource CornerRadiusDropdownPopup}"
                                                MinWidth="{TemplateBinding ActualWidth}">
                                            <ScrollViewer>
                                                <StackPanel IsItemsHost="True"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MainBorder" Property="Background"   Value="{DynamicResource BrushInputBgHover}"/>
                                    <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="MainBorder" Property="Background"      Value="{DynamicResource BrushInputBgPressed}"/>
                                    <Setter TargetName="MainBorder" Property="BorderBrush"     Value="{DynamicResource BrushBorderHover}"/>
                                    <Setter TargetName="MainBorder" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background"  Value="Transparent"/>
                            <Setter Property="Foreground"  Value="{DynamicResource BrushTextInput}"/>
                            <Setter Property="Padding"     Value="{DynamicResource PaddingDropdownItem}"/>
                            <Setter Property="Margin"      Value="4,2,4,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="{DynamicResource CornerRadiusDropdownItem}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushDropdownItemHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                                                <Setter Property="Foreground"                          Value="{DynamicResource BrushTextPrimary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button">
                <Setter Property="Background"      Value="{DynamicResource BrushPrimaryGreen}"/>
                <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding"         Value="{DynamicResource PaddingButtonSmall}"/>
                <Setter Property="FontSize"        Value="{DynamicResource FontSizeButtonSmall}"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Height"          Value="{DynamicResource HeightButtonSmall}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource CornerRadiusButtonSmall}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        <!-- Same gotcha #8 fix as SmallDangerButtonStyle above, for buttons that
             need a grey/secondary look (e.g. an inactive tab in a tab strip)
             instead of an instance Background override fighting the hardcoded
             green hover/pressed triggers. -->
        <Style x:Key="SmallSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background"      Value="{DynamicResource BrushSecondaryBg}"/>
                <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding"         Value="{DynamicResource PaddingButtonSmall}"/>
                <Setter Property="FontSize"        Value="{DynamicResource FontSizeButtonSmall}"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Height"          Value="{DynamicResource HeightButtonSmall}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource CornerRadiusButtonSmall}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource BrushSecondaryPressed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        <Style x:Key="MacScrollBarThumb" TargetType="Thumb">
                <Setter Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="thumb"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    Margin="2,2,2,2"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="thumb" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="thumb" Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        <Style x:Key="MacScrollBar" TargetType="ScrollBar">
                <Setter Property="Orientation" Value="Vertical"/>
                <Setter Property="Width"       Value="8"/>
                <Setter Property="MinWidth"    Value="8"/>
                <Setter Property="Background"  Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid x:Name="GridRoot" Width="8">
                                <Track x:Name="PART_Track"
                                       Orientation="Vertical"
                                       IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource MacScrollBarThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GridRoot" Property="Width" Value="10"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        <Style x:Key="MacScrollViewer" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ScrollContentPresenter Grid.Column="0"
                                                        Margin="{TemplateBinding Padding}"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                           Grid.Column="1"
                                           Orientation="Vertical"
                                           Style="{StaticResource MacScrollBar}"
                                           Value="{TemplateBinding VerticalOffset}"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BrushHeaderBg}" Height="56"
                VerticalAlignment="Top" CornerRadius="10,10,12,12">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="2" BlurRadius="6"/>
            </Border.Effect>
            <Grid Margin="24,0,24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="View" FontWeight="Bold" FontSize="28"
                               Foreground="{DynamicResource BrushPrimaryGreen}" VerticalAlignment="Center"/>
                    <TextBlock Text="Organiser" FontWeight="SemiBold" FontSize="28"
                               Foreground="{DynamicResource BrushTextPrimary}" Margin="6,0,0,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  |  Setup" FontWeight="SemiBold" FontSize="20"
                               Foreground="{DynamicResource BrushTextPrimary}" Opacity="0.75"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="close_btn" Style="{StaticResource CloseButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Content="&#x2715;" FontSize="14"/>
            </Grid>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource MacScrollViewer}"
                      VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel Margin="24,0,24,12">
                <Border x:Name="notice_bar" Visibility="Collapsed"
                        Background="{StaticResource LocalBrushNoticeBg}"
                        BorderBrush="{DynamicResource BrushPrimaryGreen}"
                        BorderThickness="3,0,0,0" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                    <TextBlock x:Name="notice_text" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource LocalBrushNoticeText}"/>
                </Border>
                <StackPanel x:Name="sections_panel"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource BrushHeaderBg}" Padding="24,12">
            <DockPanel LastChildFill="True">
                <Button x:Name="save_btn" DockPanel.Dock="Right" Content="Save"
                        Style="{StaticResource SmallButtonStyle}" MinWidth="90" Margin="8,0,0,0"/>
                <Button x:Name="cancel_btn" DockPanel.Dock="Right" Content="Cancel"
                        Style="{StaticResource SmallSecondaryButtonStyle}" MinWidth="90"/>
                <TextBlock x:Name="status_tb" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushTextPrimary}" Opacity="0.85"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
