<!--
===================================================================================
Seed43Styles.xaml - GENERATED by the Seed43 Palette Editor. Do not hand-edit;
re-export from the editor instead so this file and the editor never drift.
===================================================================================
Every value here is a DynamicResource reference to a resource key that
seed43_theme.py's apply_seed43_palette()/apply_seed43_dimensions() injects
at runtime from seed43_palette.json - nothing in this file is a literal
colour or pixel number. Ordinary palette edits (new accent colour, a
different corner radius) only require re-exporting seed43_palette.json,
not this file - only structural changes to a control (a different hover
trigger, a reshaped template) need this file re-exported and re-merged.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!-- BUTTONS                                                       -->
    <!-- ============================================================ -->

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="{DynamicResource BrushPrimaryGreen}"/>
        <Setter Property="Foreground"      Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="{DynamicResource PaddingButtonPrimary}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeButton}"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CornerRadiusButton}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="{DynamicResource BrushSecondaryBg}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="{DynamicResource PaddingButtonSecondary}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeButtonSecondary}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CornerRadiusButtonSecondary}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSecondaryPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tab button - the standard size for tab strips throughout the
         extension (Settings/Blocks/Options-style tab rows). Active vs
         inactive is handled by swapping Background between Accent and
         SecondaryBg via code, not a separate style - the shape is shared. -->
    <Style x:Key="TabButtonStyle" TargetType="Button">
        <Setter Property="Foreground"      Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height"          Value="{DynamicResource HeightButtonSmall}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeButtonSmall}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CornerRadiusButtonSmall}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small icon button - a tiny square icon-only button (stepper
         +/- controls, an inline gear/settings icon sitting beside a
         textbox or combobox in the same toolbar row). Height matches
         TextBoxStyle's own height token deliberately, so it lines up
         cleanly with whatever input control it's sitting next to. -->
    <Style x:Key="SmallIconButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width"           Value="{DynamicResource HeightInput}"/>
        <Setter Property="Height"          Value="{DynamicResource HeightInput}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CornerRadiusInput}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon button - transparent until hover, for a subtle utility
         action sitting inline (gear/settings icon, hamburger menu, etc). -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width"           Value="{DynamicResource WidthButtonMenu}"/>
        <Setter Property="Height"          Value="{DynamicResource HeightButtonMenu}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CornerRadiusButtonMenu}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushDropdownItemHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon toggle button - same size/shape as IconButtonStyle, but for a
         ToggleButton with a persistent open/checked state (the hamburger
         menu button, primarily) rather than a one-shot action. Matches
         pyTransmit's real LocalHamburgerToggle: transparent idle, secondary_bg
         on hover, full accent fill while IsChecked="True" (i.e. while its
         menu/panel is open) - distinct from IconButtonStyle's hover colour,
         which uses dropdown_item_hover instead. -->
    <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width"           Value="{DynamicResource WidthButtonMenu}"/>
        <Setter Property="Height"          Value="{DynamicResource HeightButtonMenu}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="Transparent"
                            CornerRadius="{DynamicResource CornerRadiusButtonMenu}"
                            Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- MENU - the dropdown that opens from IconToggleButtonStyle.    -->
    <!-- Open/close is NOT part of this Style - it's handled entirely  -->
    <!-- in code-behind, matching pyTransmit's real pattern exactly:   -->
    <!--   1) The button's Click handler is genuinely just "closed ->  -->
    <!--      open it, open -> close it". Nothing fancier.             -->
    <!--   2) The Popup itself MUST have StaysOpen="True". Without it, -->
    <!--      WPF's own auto-dismiss fires and races against the click -->
    <!--      handler above - clicking the button to close an open     -->
    <!--      menu triggers BOTH the Popup's own dismiss AND the click -->
    <!--      handler, which then reopens what the dismiss just        -->
    <!--      closed. StaysOpen="True" removes that race entirely.     -->
    <!--   3) With auto-dismiss disabled, closing on an outside click  -->
    <!--      has to be handled explicitly instead: wire the window's  -->
    <!--      own PreviewMouseDown, and in that handler, walk up the   -->
    <!--      visual tree from args.OriginalSource - if it's inside    -->
    <!--      the toggle button OR inside the popup's own content,     -->
    <!--      do nothing (the click handler above already deals with   -->
    <!--      the button, and a click inside the popup shouldn't close -->
    <!--      it out from under itself). Otherwise, close the popup.   -->
    <!--   Skipping the exclusion in (3) reintroduces the same double- -->
    <!--   toggle bug (2) exists to prevent, just from the other side. -->
    <!-- ============================================================ -->

    <Style x:Key="MenuItemStyle" TargetType="Button">
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="Foreground"                 Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness"            Value="0"/>
        <Setter Property="Padding"                    Value="{DynamicResource PaddingMenuItem}"/>
        <Setter Property="FontSize"                   Value="{DynamicResource FontSizeMenuItem}"/>
        <Setter Property="HorizontalAlignment"        Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor"                     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width"           Value="{DynamicResource WidthButtonClose}"/>
        <Setter Property="Height"          Value="{DynamicResource HeightButtonClose}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CornerRadiusButtonClose}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushDanger}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Delete button - permanently danger-red (not transparent-until-
         hover), for "delete this item" actions, e.g. removing a custom
         text style or a saved template. Opacity-dims on hover instead of
         changing colour, since it's already showing its "final" colour. -->
    <!-- Round action-button family (delete, reload/RoundPrimaryButtonStyle,
         collapse-toggle/PrimarySecondaryToggleButtonStyle) share their own
         WidthButtonRound/HeightButtonRound/CornerRadiusButtonRound tokens -
         a DIFFERENT dimension group from WidthButtonClose/HeightButtonClose/
         CornerRadiusButtonClose, which is reserved for the window's own
         chrome close button (CloseButtonStyle, above) only. The two used
         to share one token group; kept separate now since the window close
         button's size is a chrome/window-level decision, not a card/row
         action-button one, and tuning one was silently tuning the other. -->
    <Style x:Key="DeleteButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="{DynamicResource BrushDanger}"/>
        <Setter Property="Foreground"      Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width"           Value="{DynamicResource WidthButtonRound}"/>
        <Setter Property="Height"          Value="{DynamicResource HeightButtonRound}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CornerRadiusButtonRound}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round action button - accent green when IsEnabled (an action is
         genuinely available, e.g. "reload" once a source has changed), the
         shared disabled look when not. Uses button_round sizing, same
         family as DeleteButtonStyle above. -->
    <Style x:Key="RoundPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="{DynamicResource BrushPrimaryGreen}"/>
        <Setter Property="Foreground"      Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width"           Value="{DynamicResource WidthButtonRound}"/>
        <Setter Property="Height"          Value="{DynamicResource HeightButtonRound}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CornerRadiusButtonRound}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushPrimaryGreenPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round open/close toggle - accent green while unchecked (collapsed,
         clicking expands), secondary grey while checked (expanded,
         clicking collapses). Same button_round sizing family. -->
    <Style x:Key="PrimarySecondaryToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background"      Value="{DynamicResource BrushPrimaryGreen}"/>
        <Setter Property="Foreground"      Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width"           Value="{DynamicResource WidthButtonRound}"/>
        <Setter Property="Height"          Value="{DynamicResource HeightButtonRound}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CornerRadiusButtonRound}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSecondaryBg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- INPUTS                                                        -->
    <!-- ============================================================ -->

    <Style x:Key="TextBoxStyle" TargetType="TextBox">
        <Setter Property="Background"               Value="{DynamicResource BrushInputBg}"/>
        <Setter Property="Foreground"                Value="{DynamicResource BrushTextInput}"/>
        <Setter Property="BorderBrush"               Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness"           Value="{DynamicResource BorderThicknessInput}"/>
        <Setter Property="FontSize"                  Value="{DynamicResource FontSizeInput}"/>
        <Setter Property="Height"                    Value="{DynamicResource HeightInput}"/>
        <Setter Property="VerticalContentAlignment"  Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource CornerRadiusInput}">
                        <!-- No Margin="{TemplateBinding Padding}" here - WPF
                             auto-applies TextBox.Padding to whatever is named
                             PART_ContentHost, doing it again here double-
                             applies it and clips/garbles the visible text. -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushInputBgHover}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderPressed}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushInputBgPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- No canonical RadioButtonStyle existed anywhere in the lib before
         this - same visual language as the app's other selection
         controls: a circular outline that fills with BrushPrimaryGreen
         when checked, matching the checkmark-style pattern used
         elsewhere rather than the native Windows radio look. -->
    <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="FontSize"   Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="16" Height="16"
                                BorderBrush="{DynamicResource BrushPrimaryGreen}" BorderThickness="1.5"
                                CornerRadius="8" Background="{DynamicResource BrushInputBg}"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="Dot" Width="8" Height="8"
                                     Fill="{DynamicResource BrushPrimaryGreen}"
                                     Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background"      Value="{DynamicResource BrushInputBg}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushTextInput}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeCombobox}"/>
        <Setter Property="Height"          Value="{DynamicResource HeightCombobox}"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="{DynamicResource CornerRadiusDropdownItem}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushDropdownItemHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False" ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="tgBd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{DynamicResource CornerRadiusCombobox}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" Margin="8,0,0,0"
                                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="&#9662;" FontSize="9"
                                                       Foreground="{DynamicResource BrushTextInput}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="tgBd" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="8,0,22,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Popup x:Name="Popup" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border x:Name="DropDownBorder"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource BrushCardBg}"
                                    BorderBrush="{DynamicResource BrushBorderMuted}"
                                    CornerRadius="{DynamicResource CornerRadiusDropdownPopup}"
                                    BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.4" ShadowDepth="3" BlurRadius="8"/>
                                </Border.Effect>
                                <ScrollViewer Style="{DynamicResource MacScrollViewer}" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle-compatible twin of ComboBoxStyle - a Style with
         TargetType="ComboBox" can't apply to a ToggleButton, so any
         dropdown-shaped element that isn't a real value-selecting
         ComboBox (a filter toggle, an action-menu trigger) still gets
         the same canonical dropdown look: BrushInputBg family,
         CornerRadiusCombobox, a chevron that rotates on open. This is
         the lib's actual "Dropdown" visual language applied via a
         ToggleButton, not a separate invented style. -->
    <Style x:Key="DropdownToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background"      Value="{DynamicResource BrushInputBg}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushTextInput}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessInput}"/>
        <Setter Property="Padding"         Value="8,0"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeCombobox}"/>
        <Setter Property="Height"          Value="{DynamicResource HeightCombobox}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource CornerRadiusCombobox}">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                            <Path x:Name="chev" Fill="{TemplateBinding Foreground}" IsHitTestVisible="False"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,8,0" Data="M 0 0 L 4 4 L 8 0 Z"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushInputBgHover}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushInputBgPressed}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                            <Setter TargetName="chev" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain-Button twin of DropdownToggleButtonStyle, same reasoning:
         a per-card Batch trigger manages its own Popup imperatively in
         code (not bound to IsChecked, since it's built fresh per card
         at runtime) so it's a Button, not a ToggleButton - but it's
         still a dropdown, and needs the same canonical dropdown look,
         not SecondaryButtonStyle's grey-button look. No open/closed
         chevron-rotation state since a plain Button has no IsChecked
         to trigger it from. -->
    <Style x:Key="DropdownButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="{DynamicResource BrushInputBg}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushTextInput}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessInput}"/>
        <Setter Property="Padding"         Value="8,0"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeCombobox}"/>
        <Setter Property="Height"          Value="{DynamicResource HeightCombobox}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource CornerRadiusCombobox}">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                            <Path Fill="{TemplateBinding Foreground}" IsHitTestVisible="False"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,8,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushInputBgHover}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushInputBgPressed}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- CARD / LABELS                                                 -->
    <!-- ============================================================ -->

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background"    Value="{DynamicResource BrushCardBg}"/>
        <Setter Property="BorderBrush"   Value="{DynamicResource BrushBorderMuted}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"  Value="{DynamicResource CornerRadiusCard}"/>
        <Setter Property="Padding"       Value="{DynamicResource PaddingCard}"/>
    </Style>

    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{DynamicResource BrushPrimaryGreen}"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="FontSize"    Value="{DynamicResource FontSizeSectionLabel}"/>
        <Setter Property="Margin"      Value="0,0,0,8"/>
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="FontWeight"  Value="Medium"/>
        <Setter Property="FontSize"    Value="{DynamicResource FontSizeFieldLabel}"/>
        <Setter Property="Margin"      Value="0,0,0,4"/>
        <Setter Property="Opacity"     Value="0.9"/>
    </Style>

    <!-- ============================================================ -->
    <!-- FORMAT PILL - three states driven by the button's Tag, not a  -->
    <!-- separate IsChecked/IsSelected property: Tag="" = off (dim),   -->
    <!-- Tag="Enabled" = included in export but not the open settings  -->
    <!-- panel, Tag="Viewing" = the currently open settings panel.     -->
    <!-- Set el.Tag from code when the underlying state changes, same  -->
    <!-- way pySheets' own exp_subtab_clicked handler does it.         -->
    <!-- ============================================================ -->

    <Style x:Key="PillButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="{DynamicResource BrushPillOffBg}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushPillOffBorder}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeButtonSmall}"/>
        <Setter Property="FontWeight"      Value="Bold"/>
        <Setter Property="Opacity"         Value="0.45"/>
        <Setter Property="Padding"         Value="14,5"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource CornerRadiusButtonSmall}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="Dot" Width="7" Height="7"
                                     Fill="White" Opacity="0.25"
                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover on the off state only - already-active
                             states don't need a hover cue, they're already
                             at full opacity. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="Tag" Value=""/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreen}"/>
                            <Setter Property="Opacity" Value="1"/>
                        </MultiTrigger>
                        <!-- Enabled: included in export, but not the open
                             settings panel right now - bg stays the muted
                             "off" colour, only the border+dot go green. -->
                        <Trigger Property="Tag" Value="Enabled">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreen}"/>
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource BrushPrimaryGreen}"/>
                            <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                        <!-- Viewing: this format's settings panel is the one
                             currently open - full accent fill, white dot. -->
                        <Trigger Property="Tag" Value="Viewing">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushPrimaryGreen}"/>
                            <Setter TargetName="Dot" Property="Fill" Value="White"/>
                            <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- SCROLLBAR - no dedicated size tokens yet, matches the 8/10px  -->
    <!-- every window in the extension already uses identically.       -->
    <!-- ============================================================ -->

    <Style x:Key="MacScrollBarThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="thumb" Background="{TemplateBinding Background}"
                            CornerRadius="3" Margin="2,2,2,2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="thumb" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="thumb" Property="Background" Value="{DynamicResource BrushPrimaryGreenHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MacScrollBar" TargetType="ScrollBar">
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="Width"       Value="8"/>
        <Setter Property="MinWidth"    Value="8"/>
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="GridRoot" Width="8">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource MacScrollBarThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GridRoot" Property="Width" Value="10"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MacScrollViewer" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0"
                                                Margin="{TemplateBinding Padding}"
                                                HorizontalAlignment="Stretch"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                                   Style="{StaticResource MacScrollBar}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Themed list row (ListBox items - category/parameter/schedule pickers,
         layer lists, panel lists, etc.) ────────────────────────────────────
         Same look as the Dropdown popup's own item row (hover = BrushDropdownItemHover,
         selected = accent fill + white text) - matches the Seed43 Palette Editor's
         "List / Multi-select" preview component. Added 2026-08-01 when pyTable was found
         to have 6 completely unstyled ListBoxes; LayerManager/ENFStyles/pyViewPlacer each
         already have their own near-duplicate of this same pattern under different names
         (LayerRowStyle, unkeyed ListBoxItem, PanelListBoxItemStyle) with slightly different
         hardcoded hover/selected colours - point new/updated tools at THIS copy instead of
         hand-rolling another one. -->
    <Style x:Key="ListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextInput}"/>
        <Setter Property="Padding" Value="{DynamicResource PaddingDropdownItem}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="RowBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource CornerRadiusDropdownItem}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource BrushDropdownItemHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── DataGrid header/cell chrome ── the DataGrid body itself is usually styled
         per-tool (RowBackground/AlternatingRowBackground), but WPF's default
         DataGridColumnHeader/Cell chrome doesn't inherit from that - without these,
         headers keep native Windows grey chrome and selected cells keep the native
         blue highlight. Added 2026-08-01 alongside the pyTable fix that needed this. -->
    <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource BrushHeaderBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <!-- ── Radio button (circular fill on IsChecked, not the native Windows dot) ──
         pyLink.xaml already has an identical copy of this under the same name/comment
         ("no canonical RadioButtonStyle exists anywhere in the lib yet") - added here
         2026-08-01 alongside the pyTable fix that needed it, so it's finally on record. -->
    <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="FontSize"   Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="16" Height="16"
                                BorderBrush="{DynamicResource BrushPrimaryGreen}" BorderThickness="1.5"
                                CornerRadius="8" Background="{DynamicResource BrushInputBg}"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="Dot" Width="8" Height="8"
                                     Fill="{DynamicResource BrushPrimaryGreen}"
                                     Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── TabItem (real WPF TabControl headers) ── pyTable is the only tool that
         uses a real TabControl instead of the "fake tab strip of Buttons + manual
         active-state code" pattern everywhere else; without a Template override
         TabItem falls back to native Windows tab chrome (plain white/grey box on
         the selected header). This matches the same accent-fill-when-selected
         look as the fake tab strips. -->
    <Style x:Key="TabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeButtonSmall}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="{DynamicResource PaddingButtonSmall}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="bd" Background="{DynamicResource BrushSecondaryBg}"
                            CornerRadius="{DynamicResource CornerRadiusButtonSmall}"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,0,4,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushSecondaryDisabledBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryDisabledFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource BrushPrimaryGreen}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
